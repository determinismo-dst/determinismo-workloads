;; The image's classpath (resolved at build time): Datalevin 1.2.10 (its server, its remote
;; client and SOFAJRaft), Clojure, and nREPL with CIDER's middleware for the client's
;; `run nrepl <port>` (determinismo.workload).
{:deps {org.clojure/clojure {:mvn/version "1.12.6"}
        datalevin/datalevin {:mvn/version "1.2.10"}
        nrepl/nrepl {:mvn/version "1.8.0"}
        cider/cider-nrepl {:mvn/version "0.64.0"}}}
