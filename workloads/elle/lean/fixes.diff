+;; Round 2's D3 fix: the process order also reaches a process's :info
+;; operation (an edge into it; nothing follows a crashed operation). Out-edges
+;; of an :info operation come only from :ok reads observing its writes, so a
+;; cycle through it violates every model prohibiting G1a even if it aborted:
+;; txn/additional-graphs uses this graph only for those models.
+(defn process-graph-with-info
+  "Like process-graph, plus an edge from each process's last :ok operation to
+  its following :info operation."
+  [history]
+  {:graph (loopr [graph    (b/linear (g/op-digraph))
+                  last-ops (transient {})]
+                 [^Op op history :via :reduce]
+                 (let [p (.process op)
+                       last-op (get last-ops p)]
+                   (cond (h/ok? op)
+                         (recur (if last-op
+                                  (g/link graph last-op op rels/process)
+                                  graph)
+                                (assoc! last-ops p op))
 
+                         (h/info? op)
+                         (recur (if last-op
+                                  (g/link graph last-op op rels/process)
+                                  graph)
+                                last-ops)
+
+                         true (recur graph last-ops)))
+                 (b/forked graph))
+   :explainer (ProcessExplainer.)})
+
