+/* Test whether a remove of id (or a clear, if id is 0) removes a pair that the
+ * batch added, and whose relationship deletes the entity or panics when the
+ * pair's target is deleted. */
+static bool flecs_cmd_batch_removes_cleanup_pair(
+    ecs_world_t *world,
+    const ecs_table_diff_builder_t *diff,
+    ecs_id_t id)
+{
+    const ecs_id_t *added = diff->added.array;
+    int32_t i, count = diff->added.count;
+    for (i = 0; i < count; i ++) {
+        ecs_id_t pair = added[i];
+        if (!ECS_IS_PAIR(pair) || (id && !ecs_id_match(pair, id))) {
+            continue;
+        }
+
+        ecs_component_record_t *cr = flecs_components_get(world,
+            ecs_pair(ECS_PAIR_FIRST(pair), EcsWildcard));
+        if (cr) {
+            ecs_entity_t action = ECS_ID_ON_DELETE_TARGET(cr->flags);
+            if (action == EcsDelete || action == EcsPanic) {
+                return true;
+            }
+        }
+    }
+
+    return false;
+}
