diff --git a/src/query/cache/change_detection.h b/src/query/cache/change_detection.h
index 909653f..e5317a0 100644
--- a/src/query/cache/change_detection.h
+++ b/src/query/cache/change_detection.h
@@ -12,6 +12,17 @@ void flecs_query_mark_fields_dirty(
     ecs_query_impl_t *impl,
     ecs_iter_t *it);
 
+/* A match monitor stores the dirty counter of the table (element 0) and of
+ * each field, followed by the id of the table each field's source was in when
+ * the monitor was synchronized. Dirty counters of different tables can't be
+ * compared, so a source that moved to another table has changed. */
+#define FLECS_QUERY_MONITOR_TABLES_OFFSET(field_count)\
+    ECS_ALIGN((1 + (field_count)) * ECS_SIZEOF(int32_t), ECS_SIZEOF(uint64_t))
+
+#define FLECS_QUERY_MONITOR_SIZE(field_count)\
+    (FLECS_QUERY_MONITOR_TABLES_OFFSET(field_count) +\
+        (field_count) * ECS_SIZEOF(uint64_t))
+
 void flecs_query_sync_match_monitor(
     ecs_query_impl_t *impl,
     ecs_query_cache_match_t *match);
