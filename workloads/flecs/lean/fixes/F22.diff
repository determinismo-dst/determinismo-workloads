+/* Skip the queued sets and ensures of an id (or of every id, when id is 0)
+ * that come before a command in the entity's batch that removes it. The remove
+ * destroys the value, and an add after it constructs a new one. */
+static void flecs_cmd_batch_skip_removed_sets(
+    ecs_cmd_t *cmds,
+    int32_t start,
+    int32_t end,
+    ecs_id_t id)
+{
+    int32_t cur = start;
+    while (cur != end) {
+        ecs_cmd_t *cmd = &cmds[cur];
+        if ((cmd->kind == EcsCmdSet || cmd->kind == EcsCmdEnsure) &&
+            (!id || ecs_id_match(cmd->id, id)))
+        {
+            cmd->kind = EcsCmdSkip;
+        }
+
+        int32_t next = cmd->next_for_entity;
+        cur = next < 0 ? -next : next;
+        ecs_assert(cur != 0, ECS_INTERNAL_ERROR, NULL);
+    }
+}
