+/* Create an iterator that tests a query for results. Testing is not iterating:
+ * it doesn't change the state reported by ecs_query_changed. */
+static ecs_iter_t flecs_query_test_iter(
+    const ecs_query_t *q)
+{
+#ifdef FLECS_CACHED_QUERIES
+    ecs_query_cache_t *cache = flecs_query_impl(q)->cache;
+    int32_t prev_match_count = cache ? cache->prev_match_count : 0;
+#endif
+
+    ecs_iter_t it = flecs_query_iter(q->stage, q);
+    it.flags |= EcsIterNoData|EcsIterNoChangeDetection;
+
+#ifdef FLECS_CACHED_QUERIES
+    if (cache) {
+        /* Iterator creation marks matched/unmatched tables as seen */
+        cache->prev_match_count = prev_match_count;
+    }
+#endif
+
+    return it;
+}
+
 ecs_query_count_t ecs_query_count(
     const ecs_query_t *q)
 {
@@ -674,8 +697,7 @@ ecs_query_count_t ecs_query_count(
     if (!flecs_query_count_trivial_cache(q, &result))
 #endif
     {
-        ecs_iter_t it = flecs_query_iter(q->stage, q);
-        it.flags |= EcsIterNoData;
+        ecs_iter_t it = flecs_query_test_iter(q);
 
         while (ecs_query_next(&it)) {
             result.results ++;
@@ -708,7 +730,7 @@ bool ecs_query_is_true(
 {
     flecs_poly_assert(q, ecs_query_t);
 
-    ecs_iter_t it = flecs_query_iter(q->stage, q);
+    ecs_iter_t it = flecs_query_test_iter(q);
     return ecs_iter_is_true(&it);
 }
 
