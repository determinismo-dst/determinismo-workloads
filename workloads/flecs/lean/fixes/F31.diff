+/* Test if the active systems the pipeline query matches differ from the
+ * schedule. The match count of the query cache doesn't change when only terms
+ * that are evaluated while iterating change the result: terms that aren't
+ * cached (like fixed sources and DontFragment components), and the per-entity
+ * filtering of tables with the Parent component. */
+static bool flecs_pipeline_systems_changed(
+    ecs_world_t *world,
+    ecs_pipeline_state_t *pq)
+{
+    ecs_system_t **systems = ecs_vec_first_t(&pq->systems, ecs_system_t*);
+    int32_t count = ecs_vec_count(&pq->systems), cur = 0;
+
+    ecs_iter_t it = ecs_query_iter(world, pq->query);
+    while (ecs_query_next(&it)) {
+        if (ecs_table_get_type_index(world, it.table, EcsEmpty) != -1) {
+            continue; /* Inactive systems aren't in the schedule */
+        }
+
+        EcsPoly *poly = flecs_pipeline_term_system(&it);
+        int32_t i;
+        for (i = 0; i < it.count; i ++) {
+            if ((cur == count) || (systems[cur] != poly[i].poly)) {
+                ecs_iter_fini(&it);
+                return true;
+            }
+            cur ++;
+        }
+    }
+
+    return cur != count;
+}
+
 static bool flecs_pipeline_build(
     ecs_world_t *world,
     ecs_pipeline_state_t *pq)
