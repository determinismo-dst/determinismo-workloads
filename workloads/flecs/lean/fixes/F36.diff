diff --git a/src/query/cache/cache_iter.c b/src/query/cache/cache_iter.c
index 8ad5b2e..4c33fe1 100644
--- a/src/query/cache/cache_iter.c
+++ b/src/query/cache/cache_iter.c
@@ -122,6 +122,47 @@ static ecs_query_cache_match_t* flecs_query_cache_next(
     }
 }
 
+/* Get the cache match of the current result. A call made while a result is
+ * iterated can add tables to the cache, which can reallocate the table vector
+ * that qit->elem points into. Look up the match of the table again. */
+ecs_query_cache_match_t* flecs_query_cache_iter_elem(
+    ecs_iter_t *it)
+{
+    ecs_query_iter_t *qit = &it->priv_.iter.query;
+    ecs_query_cache_match_t *elem = qit->elem;
+    if (!elem) {
+        return NULL;
+    }
+
+    ecs_query_cache_t *cache = flecs_query_impl(it->query)->cache;
+    if (!cache || (qit->all_tables == &cache->table_slices)) {
+        /* Sorted table slices only change when an iterator is created */
+        return elem;
+    }
+
+    ecs_query_cache_table_t *qt = flecs_query_cache_get_table(
+        cache, it->table);
+    if (!qt) {
+        /* Table is no longer matched by the cache */
+        return NULL;
+    }
+
+    elem = flecs_query_cache_match_from_table(cache, qt);
+    ecs_vec_t *wildcard_matches = elem->wildcard_matches;
+    if (wildcard_matches && (qit->tables == wildcard_matches) && qit->cur) {
+        /* Iterating the additional wildcard matches of the table */
+        if (qit->cur > ecs_vec_count(wildcard_matches)) {
+            return NULL;
+        }
+
+        elem = ecs_vec_get_t(wildcard_matches,
+            ecs_query_cache_match_t, qit->cur - 1);
+    }
+
+    qit->elem = elem;
+    return elem;
+}
+
 static ecs_query_cache_match_t* flecs_query_test(
     const ecs_query_run_ctx_t *ctx,
     bool redo)
