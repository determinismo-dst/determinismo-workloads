+static bool flecs_prefab_spawner_is_stale(
+    ecs_world_t *world,
+    const EcsTreeSpawner *spawner)
+{
+    const ecs_vec_t *vec = &spawner->data[0].children;
+    const ecs_tree_spawner_child_t *elems = ecs_vec_first(vec);
+    int32_t i, count = ecs_vec_count(vec);
+    for (i = 0; i < count; i ++) {
+        ecs_record_t *r = flecs_entities_get_any(world, elems[i].child);
+        if (!r->table || (r->table->id != elems[i].child_table_id)) {
+            return true;
+        }
+    }
+
+    return false;
+}
