+/* Number of rows to iterate for a match. The slices of a sorted query are
+ * computed when an iterator is created: entities deleted since then are no
+ * longer in the table, and rows past the table count are not iterated. */
+static int32_t flecs_query_cache_match_count(
+    const ecs_query_cache_match_t *qm)
+{
+    int32_t count = qm->_count;
+    if (count) {
+        int32_t table_count = ecs_table_count(qm->base.table);
+        if ((qm->_offset + count) > table_count) {
+            count = table_count - qm->_offset;
+            if (count < 0) {
+                count = 0;
+            }
+        }
+    }
+    return count;
+}
