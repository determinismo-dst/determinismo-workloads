+/* Emit OnSet events for the DontFragment components with the Inherit trait
+ * that entities inherit through a new (IsA, tgt) pair. These components are
+ * in no table type, so the reachable ids of the pair don't list them
+ * (flecs_reachable_cache_ensure). */
+static void flecs_emit_forward_dont_fragment(
+    ecs_world_t *world,
+    const ecs_event_record_t *er_onset,
+    ecs_iter_t *it,
+    ecs_table_t *table,
+    ecs_entity_t tgt)
+{
+    ecs_entity_t old_event = it->event;
+    ecs_entity_t old_src = it->sources[0];
+
+    ecs_component_record_t *cur = world->cr_non_fragmenting_head;
+    for (; cur; cur = cur->non_fragmenting.next) {
+        if (!(cur->flags & EcsIdOnInstantiateInherit) || !cur->type_info ||
+            !cur->sparse || ecs_id_is_wildcard(cur->id))
+        {
+            continue;
+        }
+
+        ecs_event_id_record_t *iders[5];
+        int32_t ider_i, ider_count = flecs_event_observers_get(
+            er_onset, cur->id, iders);
+        if (!ider_count) {
+            continue;
+        }
+
+        /* Only emit when tgt is the entities' source for the component */
+        ecs_entity_t direct = 0;
+        ecs_entity_t src = flecs_emit_isa_source(world, table, cur, &direct, 0);
+        if (!src || ((uint32_t)direct != (uint32_t)tgt)) {
+            continue;
+        }
+
+        ecs_table_record_t dummy_tr = {
+            .hdr.cr = cur,
+            .hdr.table = table,
+            .index = -1,
+            .column = -1,
+            .count = 0
+        };
+
+        it->event = er_onset->event;
+        it->ids[0] = cur->id;
+        it->event_id = cur->id;
+        it->sources[0] = src;
+        it->trs[0] = &dummy_tr;
+        ECS_CONST_CAST(int16_t*, it->columns)[0] = -1;
+        ECS_CONST_CAST(int32_t*, it->sizes)[0] = cur->type_info->size;
+        it->up_fields = 1;
+
+        for (ider_i = 0; ider_i < ider_count; ider_i ++) {
+            ecs_event_id_record_t *ider = iders[ider_i];
+            flecs_observers_invoke(world, &ider->up, it, table, EcsIsA);
+
+            /* Owned takes precedence */
+            flecs_emit_invoke_not_owned(
+                world, &ider->self_up, it, table, EcsIsA, cur);
+        }
+
+        it->trs[0] = NULL;
+        it->up_fields = 0;
+    }
+
+    it->event = old_event;
+    it->sources[0] = old_src;
+}
