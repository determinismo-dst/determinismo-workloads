         }
     }
 
+    /* The spawner only holds children with the Parent component. Instantiate
+     * the children with a ChildOf pair of the prefab children it spawned.
+     * Copy the pairs first: the instantiation can use the spawner of another
+     * prefab, which reuses the parents array. */
+    int32_t childof_count = 0;
+    for (i = 0; i < child_count; i ++) {
+        ecs_component_record_t *child_cr = flecs_components_get(
+            world, ecs_childof(spawn_children[i].child));
+        if (child_cr && flecs_table_cache_count(&child_cr->cache)) {
+            childof_count ++;
+        }
+    }
+
+    if (childof_count) {
+        ecs_entity_t *pairs = flecs_walloc_n(
+            world, ecs_entity_t, childof_count * 2);
+        int32_t p = 0;
+        for (i = 0; i < child_count; i ++) {
+            ecs_entity_t child = spawn_children[i].child;
+            ecs_component_record_t *child_cr = flecs_components_get(
+                world, ecs_childof(child));
+            if (child_cr && flecs_table_cache_count(&child_cr->cache)) {
+                pairs[p ++] = flecs_entities_get_alive(world, child);
+                pairs[p ++] = parents[i + 1];
+            }
+        }
+
+        for (i = 0; i < childof_count; i ++) {
+            ecs_component_record_t *child_cr = flecs_components_get(
+                world, ecs_childof(pairs[i * 2]));
+            if (child_cr) {
+                flecs_instantiate_childof_children(world, child_cr,
+                    pairs[i * 2], pairs[i * 2 + 1], &ctx_cur,
+                    depth_instantiate + 1);
+            }
+        }
+
+        flecs_wfree_n(world, ecs_entity_t, childof_count * 2, pairs);
+    }
