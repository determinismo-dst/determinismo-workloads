diff --git a/src/addons/pipeline/pipeline.c b/src/addons/pipeline/pipeline.c
index ec5abbc..91f699a 100644
--- a/src/addons/pipeline/pipeline.c
+++ b/src/addons/pipeline/pipeline.c
@@ -615,6 +615,19 @@ void flecs_run_pipeline(
 
         pq->immediate = immediate;
 
+#ifdef FLECS_CACHED_QUERIES
+        if (op_multi_threaded) {
+            /* Sort the order_by queries of the op's systems now: the worker
+             * threads can't sort the tables they iterate at the same time. */
+            ecs_system_t **systems = ecs_vec_first_t(
+                &pq->systems, ecs_system_t*);
+            int32_t s, end = pq->cur_op->offset + pq->cur_op->count;
+            for (s = pq->cur_i; s < end; s ++) {
+                flecs_query_sort_for_workers(world, systems[s]->query);
+            }
+        }
+#endif
+
         if (!immediate) {
             ecs_readonly_begin(world, multi_threaded);
         } else {
