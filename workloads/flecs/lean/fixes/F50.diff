+/* Invoke observers for the entities of the iterated range that don't own a
+ * DontFragment component. Such a component is in no table type, so whether an
+ * entity owns it (overrides it) is decided per entity. */
+static void flecs_emit_invoke_not_owned(
+    ecs_world_t *world,
+    ecs_map_t *observers,
+    ecs_iter_t *it,
+    ecs_table_t *table,
+    ecs_entity_t trav,
+    ecs_component_record_t *cr)
+{
+    const ecs_entity_t *entities = it->entities;
+    int32_t offset = it->offset, count = it->count;
+    int32_t i = 0;
+    while (i < count) {
+        if (flecs_component_sparse_has(cr, entities[i])) {
+            i ++;
+            continue;
+        }
+
+        int32_t start = i;
+        while (i < count && !flecs_component_sparse_has(cr, entities[i])) {
+            i ++;
+        }
+
+        it->entities = &entities[start];
+        it->offset = offset + start;
+        it->count = i - start;
+        flecs_observers_invoke(world, observers, it, table, trav);
+    }
+
+    it->entities = entities;
+    it->offset = offset;
+    it->count = count;
+}
+
+/* Find the base that provides a component to the entities of a table through
+ * IsA, in the order that ecs_get uses (flecs_get_base_component): the table's
+ * IsA targets in type order, depth first. Returns the entity that owns the
+ * component (0 if there is none), and in direct_out the table's own IsA
+ * target it was found through. */
+static ecs_entity_t flecs_emit_isa_source(
+    ecs_world_t *world,
+    const ecs_table_t *table,
+    ecs_component_record_t *cr,
+    ecs_entity_t *direct_out,
+    int32_t depth)
+{
+    if (!(table->flags & EcsTableHasIsA) || (depth >= FLECS_DAG_DEPTH_MAX)) {
+        return 0;
+    }
+
+    const ecs_table_record_t *tr_isa = flecs_component_get_table(
+        world->cr_isa_wildcard, table);
+    if (!tr_isa) {
+        return 0;
+    }
+
+    const ecs_id_t *ids = table->type.array;
+    int32_t i = tr_isa->index, end = i + tr_isa->count;
+    for (; i < end; i ++) {
+        ecs_entity_t base = flecs_entities_get_alive(
+            world, ECS_PAIR_SECOND(ids[i]));
+        ecs_record_t *r = base ? flecs_entities_get(world, base) : NULL;
+        if (!r || !r->table) {
+            continue;
+        }
+
+        ecs_entity_t src = 0;
+        if (cr->flags & EcsIdDontFragment) {
+            if (flecs_component_sparse_has(cr, base)) {
+                src = base;
+            }
+        } else if (flecs_component_get_table(cr, r->table)) {
+            src = base;
+        }
+
+        if (!src) {
+            src = flecs_emit_isa_source(world, r->table, cr, NULL, depth + 1);
+        }
+
+        if (src) {
+            if (direct_out) {
+                *direct_out = base;
+            }
+            return src;
+        }
+    }
+
+    return 0;
+}
+
+
+/* Whether src is the source of a component for the entities of a table, the
+ * primary source of ObserversManual.md ("Adding an IsA pair"), reached
+ * through the table's IsA target tgt. An OnSet event that names another base
+ * reports a value that the entities don't have. */
+static bool flecs_emit_isa_is_source(
+    ecs_world_t *world,
+    const ecs_table_t *table,
+    ecs_component_record_t *cr,
+    ecs_entity_t src,
+    ecs_entity_t tgt)
+{
+    ecs_entity_t direct = 0;
+    ecs_entity_t owner = flecs_emit_isa_source(world, table, cr, &direct, 0);
+    return ((uint32_t)owner == (uint32_t)src) &&
+        ((uint32_t)direct == (uint32_t)tgt);
+}
+
+/* Whether the component of src reaches base's inheritors through base: base
+ * is src, or an IsA target of base reaches it, and no entity on the way owns
+ * the component (an override stops the propagation from src). */
+static bool flecs_emit_isa_reaches(
+    ecs_world_t *world,
+    ecs_entity_t base,
+    ecs_component_record_t *cr,
+    ecs_entity_t src,
+    int32_t depth)
+{
+    if ((uint32_t)base == (uint32_t)src) {
+        return true;
+    }
+
+    ecs_record_t *r = flecs_entities_get(world, base);
+    if (!r || !r->table || (depth >= FLECS_DAG_DEPTH_MAX)) {
+        return false;
+    }
+
+    if (cr->flags & EcsIdDontFragment) {
+        if (flecs_component_sparse_has(cr, base)) {
+            return false;
+        }
+    } else if (flecs_component_get_table(cr, r->table)) {
+        return false;
+    }
+
+    if (!(r->table->flags & EcsTableHasIsA)) {
+        return false;
+    }
+
+    const ecs_table_record_t *tr_isa = flecs_component_get_table(
+        world->cr_isa_wildcard, r->table);
+    if (!tr_isa) {
+        return false;
+    }
+
+    const ecs_id_t *ids = r->table->type.array;
+    int32_t i = tr_isa->index, end = i + tr_isa->count;
+    for (; i < end; i ++) {
+        ecs_entity_t b = flecs_entities_get_alive(
+            world, ECS_PAIR_SECOND(ids[i]));
+        if (b && flecs_emit_isa_reaches(world, b, cr, src, depth + 1)) {
+            return true;
+        }
+    }
+
+    return false;
+}
+
+/* Whether tgt is the first of a table's IsA targets, in type order, through
+ * which the component of src reaches the table's entities. An event from src
+ * can reach a table through several of its targets (a diamond); only this
+ * path notifies, once. */
+static bool flecs_emit_isa_is_first_path(
+    ecs_world_t *world,
+    const ecs_table_t *table,
+    ecs_component_record_t *cr,
+    ecs_entity_t src,
+    ecs_entity_t tgt)
+{
+    const ecs_table_record_t *tr_isa = flecs_component_get_table(
+        world->cr_isa_wildcard, table);
+    if (!tr_isa) {
+        return false;
+    }
+
+    const ecs_id_t *ids = table->type.array;
+    int32_t i = tr_isa->index, end = i + tr_isa->count;
+    for (; i < end; i ++) {
+        ecs_entity_t b = flecs_entities_get_alive(
+            world, ECS_PAIR_SECOND(ids[i]));
+        if (b && flecs_emit_isa_reaches(world, b, cr, src, 0)) {
+            return (uint32_t)b == (uint32_t)tgt;
+        }
+    }
+
+    return false;
+}
+
 static void flecs_emit_propagate_id_for_range(
     ecs_world_t *world,
     ecs_iter_t *it,
