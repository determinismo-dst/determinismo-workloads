+/* Find the entity that provides a DontFragment component through a
+ * traversable relationship trav (not IsA) from tgt, as up traversal does: tgt
+ * itself, the IsA bases of tgt for a component with the Inherit trait, then
+ * the target of tgt for the same relationship. */
+static ecs_entity_t flecs_emit_dont_fragment_up_source(
+    ecs_world_t *world,
+    ecs_entity_t tgt,
+    ecs_entity_t trav,
+    ecs_component_record_t *cr,
+    int32_t depth)
+{
+    if (!tgt || (depth >= FLECS_DAG_DEPTH_MAX)) {
+        return 0;
+    }
+
+    if (flecs_component_sparse_has(cr, tgt)) {
+        return tgt;
+    }
+
+    ecs_record_t *r = flecs_entities_get(world, tgt);
+    if (!r || !r->table) {
+        return 0;
+    }
+
+    if (cr->flags & EcsIdOnInstantiateInherit) {
+        ecs_entity_t src = flecs_emit_isa_source(world, r->table, cr, NULL, 0);
+        if (src) {
+            return src;
+        }
+    }
+
+    if (trav == EcsIsA) {
+        return 0;
+    }
+
+    return flecs_emit_dont_fragment_up_source(world,
+        ecs_get_target(world, tgt, trav, 0), trav, cr, depth + 1);
+}
+
+/* Emit the OnAdd or OnRemove of a new or removed (trav, tgt) pair for the
+ * DontFragment components that the entities gain or lose through it, and
+ * propagate it to the entities' own inheritors and children. Such components
+ * are in no table type, so the reachable ids of the pair don't list them
+ * (flecs_reachable_cache_ensure). Through IsA only components with the
+ * Inherit trait are reachable. As for the table components of an IsA pair,
+ * up observers get the event when tgt provides the component (once, when the
+ * providing base is reachable through several of the entities' targets), and
+ * self|up observers only when tgt is the base that the entities get the
+ * component from (flecs_emit_forward). */
+static void flecs_emit_forward_dont_fragment(
+    ecs_world_t *world,
+    const ecs_event_record_t *er,
+    ecs_iter_t *it,
+    ecs_table_t *table,
+    ecs_component_record_t *pair_cr)
+{
+    ecs_entity_t trav = ECS_PAIR_FIRST(pair_cr->id);
+    ecs_entity_t tgt = flecs_entities_get_alive(
+        world, ECS_PAIR_SECOND(pair_cr->id));
+    if (!tgt) {
+        return;
+    }
+
+    ecs_entity_t old_src = it->sources[0];
+
+    ecs_component_record_t *cur = world->cr_non_fragmenting_head;
+    for (; cur; cur = cur->non_fragmenting.next) {
+        if (!cur->sparse || ecs_id_is_wildcard(cur->id)) {
+            continue;
+        }
+
+        if ((trav == EcsIsA) && !(cur->flags & EcsIdOnInstantiateInherit)) {
+            continue;
+        }
+
+        ecs_event_id_record_t *iders[5];
+        int32_t ider_i, ider_count = flecs_event_observers_get(
+            er, cur->id, iders);
+        if (!ider_count) {
+            continue;
+        }
+
+        ecs_entity_t src = flecs_emit_dont_fragment_up_source(
+            world, tgt, trav, cur, 0);
+        if (!src) {
+            continue;
+        }
+
+        bool self_up = true;
+        if (trav == EcsIsA) {
+            if (!flecs_emit_isa_is_first_path(world, table, cur, src, tgt)) {
+                continue;
+            }
+
+            self_up = flecs_emit_isa_is_source(world, table, cur, src, tgt);
+        }
+
+        ecs_table_record_t dummy_tr = {
+            .hdr.cr = cur,
+            .hdr.table = table,
+            .index = -1,
+            .column = -1,
+            .count = 0
+        };
+
+        it->ids[0] = cur->id;
+        it->event_id = cur->id;
+        it->sources[0] = src;
+        it->trs[0] = &dummy_tr;
+        ECS_CONST_CAST(int16_t*, it->columns)[0] = -1;
+        ECS_CONST_CAST(int32_t*, it->sizes)[0] =
+            cur->type_info ? cur->type_info->size : 0;
+        it->up_fields = 1;
+
+        for (ider_i = 0; ider_i < ider_count; ider_i ++) {
+            ecs_event_id_record_t *ider = iders[ider_i];
+            if (ider->observer_count == ider->up_notify_count) {
+                continue;
+            }
+
+            flecs_observers_invoke_skip_up_notify(
+                world, &ider->up, it, table, trav);
+
+            /* Owned takes precedence */
+            if (self_up) {
+                flecs_emit_invoke_not_owned(
+                    world, &ider->self_up, it, table, trav, cur);
+            }
+        }
+
+        it->up_fields = 0;
+
+        /* Propagate to the inheritors and children of the entities that gain
+         * or lose the component and don't own it, as for the table
+         * components of the pair. */
+        if (self_up && table->_->traversable_count) {
+            const ecs_entity_t *entities = it->entities;
+            int32_t e;
+            for (e = 0; e < it->count; e ++) {
+                if (!flecs_component_sparse_has(cur, entities[e])) {
+                    flecs_propagate_entities(world, it, cur, &entities[e], 1,
+                        src, iders, ider_count);
+                }
+            }
+        }
+
+        it->trs[0] = NULL;
+    }
+
+    it->sources[0] = old_src;
+}
+
 static void flecs_emit_on_set_for_override_on_add(
