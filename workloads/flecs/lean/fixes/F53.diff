diff --git a/src/query/cache/change_detection.c b/src/query/cache/change_detection.c
index a91ce5c..abd2cdd 100644
--- a/src/query/cache/change_detection.c
+++ b/src/query/cache/change_detection.c
@@ -672,11 +672,126 @@ bool ecs_query_changed(
     return false;
 }
 
+static void flecs_query_match_changed_for_workers(
+    ecs_query_impl_t *impl,
+    ecs_query_cache_match_t *qm)
+{
+    qm->_worker_changed = flecs_query_check_match_monitor(impl, qm, NULL);
+
+    if (qm->wildcard_matches) {
+        ecs_query_cache_match_t *wc_qms = ecs_vec_first(qm->wildcard_matches);
+        int32_t i, count = ecs_vec_count(qm->wildcard_matches);
+        for (i = 0; i < count; i ++) {
+            wc_qms[i]._worker_changed = flecs_query_check_match_monitor(
+                impl, &wc_qms[i], NULL);
+        }
+    }
+}
+
+/* Compute the changed state of a query's results for the worker threads of a
+ * multithreaded pipeline op. The pipeline calls this on the main thread for
+ * the multithreaded systems of the op, before it signals the workers.
+ * Every worker iterates every result and syncs a result's monitor when it is
+ * done with its rows, while the other workers may still have to check it,
+ * and monitors and dirty states are allocated lazily, which isn't thread safe.
+ * ecs_iter_changed on a worker iterator returns the state computed here: the
+ * changes made before the op started. */
+void flecs_query_changed_for_workers(
+    ecs_query_t *q)
+{
+    ecs_query_impl_t *impl = flecs_query_impl(q);
+    ecs_query_cache_t *cache = impl->cache;
+
+    impl->worker_snapshot = false;
+    impl->worker_cache_snapshot = false;
+    impl->worker_fixed_changed = false;
+
+    if (q->read_fields & q->fixed_fields) {
+        impl->worker_fixed_changed = flecs_query_check_fixed_monitor(impl);
+        impl->worker_snapshot = true;
+    }
+
+    /* A query created with EcsQueryDetectChanges creates its monitors when
+     * it first checks for changes, which then happens here. */
+    if (cache && !flecs_query_cache_is_trivial(cache) &&
+        (q->flags & (EcsQueryHasChangeDetection|EcsQueryDetectChanges)))
+    {
+        const ecs_query_cache_group_t *cur = cache->first_group;
+        for (; cur; cur = cur->next) {
+            int32_t i, count = ecs_vec_count(&cur->tables);
+            ecs_query_cache_match_t *qms = ecs_vec_first(&cur->tables);
+            for (i = 0; i < count; i ++) {
+                flecs_query_match_changed_for_workers(impl, &qms[i]);
+            }
+        }
+
+        /* An order_by query iterates copies of its matches */
+        if (cache->order_by_callback) {
+            int32_t i, count = ecs_vec_count(&cache->table_slices);
+            ecs_query_cache_match_t *qms = ecs_vec_first(&cache->table_slices);
+            for (i = 0; i < count; i ++) {
+                if (qms[i].base.table) {
+                    /* A slice copies the monitor of its match */
+                    qms[i]._worker_changed = !qms[i]._monitor ||
+                        flecs_query_check_match_monitor(impl, &qms[i], NULL);
+                }
+            }
+        }
+
+        impl->worker_cache_snapshot = true;
+        impl->worker_snapshot = true;
+    }
+}
+
+/* Called by the pipeline after the workers of the op are done. */
+void flecs_query_changed_for_workers_fini(
+    ecs_query_t *q)
+{
+    ecs_query_impl_t *impl = flecs_query_impl(q);
+    impl->worker_snapshot = false;
+    impl->worker_cache_snapshot = false;
+    impl->worker_fixed_changed = false;
+}
+
 /* Public API call to check if the currently iterated result has changed. */
 bool ecs_iter_changed(
     ecs_iter_t *it)
 {
     ecs_check(it != NULL, ECS_INVALID_PARAMETER, NULL);
+
+    if (it->next == ecs_worker_next) {
+        /* The iterator of a multithreaded system: its result is the current
+         * result of the chained query iterator, restricted to the worker's
+         * rows. Change detection works on whole tables. */
+        ecs_iter_t *chain_it = it->chain_it;
+        ecs_check(chain_it != NULL, ECS_INVALID_PARAMETER, NULL);
+        ecs_check(chain_it->next == ecs_query_next, ECS_UNSUPPORTED, NULL);
+        ecs_check(ECS_BIT_IS_SET(chain_it->flags, EcsIterIsValid),
+            ECS_INVALID_PARAMETER, NULL);
+
+        ecs_query_impl_t *impl = flecs_query_impl(chain_it->query);
+        if (impl->worker_snapshot) {
+            /* In a multithreaded pipeline op: the state computed before the
+             * workers started (flecs_query_changed_for_workers) */
+            if (impl->worker_fixed_changed) {
+                return true;
+            }
+
+            if (impl->worker_cache_snapshot) {
+                ecs_query_cache_match_t *qm = (ecs_query_cache_match_t*)
+                    chain_it->priv_.iter.query.elem;
+                ecs_check(qm != NULL, ECS_INVALID_PARAMETER, NULL);
+                return qm->_worker_changed;
+            }
+
+            if (!impl->cache) {
+                return false;
+            }
+        }
+
+        it = chain_it;
+    }
+
     ecs_check(it->next == ecs_query_next, ECS_UNSUPPORTED, NULL);
     ecs_check(ECS_BIT_IS_SET(it->flags, EcsIterIsValid),
         ECS_INVALID_PARAMETER, NULL);
@@ -715,6 +830,15 @@ error:
 void ecs_iter_skip(
     ecs_iter_t *it)
 {
+    if (it->next == ecs_worker_next) {
+        /* Skip the result for this worker: its chained query iterator then
+         * neither marks the result's fields dirty nor syncs the result's
+         * changed state. Workers that iterate other rows of the same table
+         * and don't skip it still do. */
+        ecs_assert(it->chain_it != NULL, ECS_INVALID_PARAMETER, NULL);
+        it = it->chain_it;
+    }
+
     ecs_assert(it->next == ecs_query_next, ECS_INVALID_PARAMETER, NULL);
     ecs_assert(ECS_BIT_IS_SET(it->flags, EcsIterIsValid),
         ECS_INVALID_PARAMETER, NULL);
