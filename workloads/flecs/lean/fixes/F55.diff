+/* Clear the sorted slices of a table that leaves the cache. The slices are
+ * copies of the table's match, so they point at the table and at the match's
+ * arrays, which the cache frees, and a table created later can take the
+ * table's memory. The iterator skips a cleared slice. The slices are rebuilt
+ * when the next iterator is created (the cache's match_count changed). */
+void flecs_query_cache_remove_table_slices(
+    ecs_query_cache_t *cache,
+    const ecs_table_t *table)
+{
+    int32_t i, count = ecs_vec_count(&cache->table_slices);
+    ecs_query_cache_match_t *slices = ecs_vec_first(&cache->table_slices);
+    for (i = 0; i < count; i ++) {
+        if (slices[i].base.table == table) {
+            ecs_os_zeromem(&slices[i]);
+        }
+    }
+}
