diff --git a/src/query/cache/order_by.c b/src/query/cache/order_by.c
index 53596ce..bfa629a 100644
--- a/src/query/cache/order_by.c
+++ b/src/query/cache/order_by.c
@@ -312,9 +312,15 @@ void flecs_query_cache_sort_tables(
         }
     }
 
-    if (tables_sorted || cache->match_count != cache->prev_match_count) {
+    /* Rebuild the slices when a table was matched or unmatched since they
+     * were built. prev_match_count can't tell: syncing a match monitor (as
+     * every ecs_query_next does for the previous result) resets it, so a
+     * table that left the cache during an iteration would keep its slice,
+     * which names the freed table, in every later iterator. */
+    if (tables_sorted || cache->match_count != cache->sorted_match_count) {
         flecs_query_cache_build_sorted_tables(cache);
         cache->match_count ++; /* Increase version if tables changed */
+        cache->sorted_match_count = cache->match_count;
     }
