diff --git a/src/world.c b/src/world.c
index 387f3f9..abe6460 100644
--- a/src/world.c
+++ b/src/world.c
@@ -1353,12 +1353,54 @@ static void flecs_process_empty_queries(
     flecs_commands_end(world, world->stages[0]);
 }
 
+/* EcsEmpty is removed when a query cache matches its first table. A query
+ * that EcsAperiodicEmptyQueries marked empty can still have matched tables,
+ * and no event is emitted when those tables get entities: test them again. */
+static void flecs_process_nonempty_queries(
+    ecs_world_t *world)
+{
+    if (!flecs_components_get(world, EcsEmpty)) {
+        return;
+    }
+
+    /* Defer removing the tag until after iterating */
+    flecs_commands_begin(world, world->stages[0]);
+
+    ecs_iter_t it = ecs_each_id(world, EcsEmpty);
+    while (ecs_each_next(&it)) {
+        int32_t i;
+        for (i = 0; i < it.count; i ++) {
+            ecs_entity_t e = it.entities[i];
+            const EcsPoly *poly = ecs_get_pair(world, e, EcsPoly, EcsQuery);
+            if (!poly || !poly->poly) {
+                continue;
+            }
+
+            ecs_query_t *query = poly->poly;
+#ifdef FLECS_CACHED_QUERIES
+            ecs_query_cache_t *cache = flecs_query_impl(query)->cache;
+            if (cache && !ecs_map_count(&cache->tables)) {
+                continue; /* Tag is removed when cache matches a table */
+            }
+#endif
+
+            if (ecs_query_is_true(query)) {
+                ecs_remove_id(world, e, EcsEmpty);
+            }
+        }
+    }
+
+    flecs_commands_end(world, world->stages[0]);
+}
+
 void ecs_run_aperiodic(
     ecs_world_t *world,
     ecs_flags32_t flags)
 {
     flecs_poly_assert(world, ecs_world_t);
 
+    flecs_process_nonempty_queries(world);
+
     if ((flags & EcsAperiodicEmptyQueries)) {
         flecs_process_empty_queries(world);
     }
