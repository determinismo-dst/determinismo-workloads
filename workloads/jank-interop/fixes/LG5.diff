+              if(d == 0)
+              {
+                throw make_box("Division by zero is not permitted.").erase();
+              }
+              if(d == -1)
+              {
+                return make_box(static_cast<i64>(0ull - static_cast<unsigned long long>(n))).erase();
+              }
+              return make_box(n / d).erase();
+            }
