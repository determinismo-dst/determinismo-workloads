       [](auto const typed_l, auto const r) -> object_ref {
         return visit_number_like(
           [](auto const typed_r, auto const &typed_l) -> object_ref {
+            /* Two integers divide as integers: as doubles, past 2^53 they lose precision. */
+            using L = std::decay_t<decltype(typed_l)>;
+            using R = std::decay_t<decltype(typed_r->data)>;
