  (is (= (quote ()) (ev "(sort-by str (keys (select-keys (select-keys (frequencies [0 1 2 3 4]) [:a]) [])))")))
  (is (= (quote 1) (ev "(let [x (count (rest (take 2 [0 1 2 3 4])))] (max x -3))")))
  (is (threw? (ev "(reduce + 0 (interleave (interleave (partition-all 2 [0 -1 7 7]) (conj [3 1 2] 0)) (sort-by - (sort-by identity [0 -1 7 7]))))")) "Clojure throws java.lang.ClassCastException")
  (is (= (quote {:a 1}) (ev "{:a 1}")))
  (is (= (quote nil) (ev "(get (dissoc (assoc (select-keys {:k/v \"x\", :a [1]} [:a]) :k/v (dec -128)) :a) :c)")))
  (is (= (quote {:k/v "x", :a [1]}) (ev "{:k/v \"x\", :a [1]}")))
  (is (= (quote (1 2 3 4)) (ev "(filter pos? [0 1 2 3 4])")))
  (is (= (quote #{0 1 4 3 2}) (ev "(into #{} [0 1 2 3 4])")))
  (is (= (quote :b) (ev ":b"))))

(deftest g0047
  (is (= (quote false) (ev "false")))
  (is (= (quote false) (ev "(zero? (nth (vector (+ (count \" t \") (nth (vector 128 1) 1)) (count (list 1 2))) 1))")))
  (is (threw? (ev "(even? (some pos? (concat (drop 2 [3 1 2]) (sort-by str (keys {:k/v \"x\", :a [1]})))))")) "Clojure throws java.lang.IllegalArgumentException")
  (is (= (quote 3) (ev "3")))
  (is (= (quote nil) (ev "(get (zipmap [:a :b :c] (filter odd? (list 1 2))) :c)")))
  (is (= (quote true) (ev "(some even? [0 1 2 3 4])")))
  (is (= (quote :c) (ev ":c")))
  (is (= (quote 0) (ev "(let [x -3] (+ x 3))")))
  (is (= (quote 2) (ev "(count (interleave [0 -1 7 7] (filter zero? (remove pos? [0 -1 7 7]))))")))
  (is (= (quote {7 2, -1 1, 0 1}) (ev "(frequencies (reverse [0 -1 7 7]))"))))

(deftest g0048
  (is (= (quote -1) (ev "(first (vector (compare -9223372036854775808 (count (remove even? [3 1 2])))))")))
  (is (= (quote \z) (ev "\\z")))
  (is (= (quote 0) (ev "(max (first (vector (rem (max 3 1000) -2))) (rem 10 1))")))
  (is (threw? (ev "(+ (* (dec -9223372036854775808) (quot 1000 7)) (inc (nth (vector (compare 10 1) (count [1 1 1])) 1)))")) "Clojure throws java.lang.ArithmeticException")
  (is (threw? (ev "(some even? (sort-by - (sort-by str (keys (zipmap [:a] [1 1 1])))))")) "Clojure throws java.lang.IllegalArgumentException")
  (is (= (quote \z) (ev "\\z")))
  (is (threw? (ev "(if (some? (frequencies (sort-by str (keys (merge {:a 1} {}))))) (let [x (first (vector (min -9223372036854775808 2)))] (* x 256)) (even? (let [x 256] (max x (nth (vector 1 2) 0)))))")) "Clojure throws java.lang.ArithmeticException")
  (is (= (quote [-1]) (ev "[(quot (* 2 -1) 2)]")))
  (is (threw? (ev "(if (zero? (if (coll? :a) (into #{} (conj [0 1 2 3 4] -128)) (into #{} []))) false (sort (take 3 [-9223372036854775808])))")) "Clojure throws java.lang.ClassCastException")
  (is (= (quote -1) (ev "-1"))))

(deftest g0049
  (is (= (quote nil) (ev "(get {} :x)")))
  (is (= (quote false) (ev "(seq? (get (frequencies (butlast [1 2 3])) :b))")))
  (is (= (quote :a) (ev ":a")))
  (is (= (quote false) (ev "(every? even? (conj (butlast [1 1 1]) (count [0 -1 7 7])))")))
  (is (= (quote false) (ev "(every? even? (sort (distinct (list 1 2))))")))
  (is (= (quote "é") (ev "\"é\"")))
  (is (= (quote "a b") (ev "\"a b\"")))
  (is (= (quote false) (ev "false")))
  (is (= (quote false) (ev "(number? (list 1 2))")))
  (is (= (quote false) (ev "(number? :k/v)"))))
