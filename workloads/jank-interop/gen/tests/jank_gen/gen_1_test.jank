(deftest g0020
  (let [found (mismatches (quote [
      ["(select-keys (merge (zipmap [:a :b] [0 1 2 3 4]) (zipmap [:a :b] [])) [:a])" :value {:a 0}]
      ["((fn [x] (and (number? x) (> x 2))) (count [3 1 2]))" :value true]
