(defn- ev
  "The form's value, or [:jank-gen/threw what] for any throw jank's handlers can see (an
   object, a native exception or a jank::error_ref): `is` catches objects only, and an
   uncaught error would end the test before its other forms. An object's message only:
   printing an ex-info makes jank crash as it exits (jankifier's S1)."
  [s]
  (try (eval (read-string s))
       (catch cpp/jank.runtime.object_ref e [:jank-gen/threw (ex-message e)])
       (catch cpp/std.exception e [:jank-gen/threw (str (.what e))])
       (catch cpp/jank.error_ref e [:jank-gen/threw (str (.-message (cpp/* e)))])))

(defn- threw? [v] (and (vector? v) (= :jank-gen/threw (first v))))

