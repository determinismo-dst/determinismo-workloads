      ["(get (frequencies (drop 1 (sort-by identity []))) :b)" :value nil]
      ["(interleave [0 -1 7 7] (mapv (fn [x] [x x]) [3 1 2]))" :value (0 [3 3] -1 [1 1] 7 [2 2])]
      ["(reduce + 0 (partition 1 (conj (sort-by identity [1 2 3]) 0)))" :throws "java.lang.ClassCastException"]
      ["(let [x (compare (nth (vector (min 0 1) (nth (vector 3 256) 1)) 0) (min -128 7))] (max x (min (max (first (vector 0)) (nth (vector 255 -9223372036854775808) 0)) (compare (count [0 -1 7 7]) (compare 1000 127)))))" :value 1]
      ["(number? (some pos? (list 1 2)))" :value false]
      ["(every? pos? (take 1 (interleave (sort-by identity [0 1 2 3 4]) (map dec [1 2 3]))))" :value false]
      ["(get (select-keys (merge {:a 1} (assoc {:a 1} :b 0)) [:a :b]) :x)" :value nil]
      ["(let [x (nth (vector (count (str 10 :x)) (quot 3 1)) 0)] (* x (nth (vector 1 0) 0)))" :value 4]]))]
    (is (= [] found))))

