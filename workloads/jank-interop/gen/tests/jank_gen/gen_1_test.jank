;; SPDX-License-Identifier: MIT
;; Generated by workloads/jank-interop/gen/gen.clj, seed 1: each case's expected
;; outcome is Clojure 1.12's for a random form, so a mismatch on jank is a deviation.
(ns jank-gen.gen-1-test
  (:require [clojure.test :refer [deftest is]]
            [clojure.string]))

(defn- ev
  "The form's value, realized, or [:jank-gen/threw what] for any throw jank's handlers can
   see (an object, a native exception or a jank::error_ref): every form gets its own
   verdict. An object's message only: printing an ex-info makes jank crash as it exits
   (jankifier's S1)."
  [s]
  (try (let [v (eval (read-string s))] (pr-str v) v)
       (catch cpp/jank.runtime.object_ref e [:jank-gen/threw (ex-message e)])
       (catch cpp/std.exception e [:jank-gen/threw (str (.what e))])
       (catch cpp/jank.error_ref e [:jank-gen/threw (str (.-message (cpp/* e)))])))

(defn- threw? [v] (and (vector? v) (= :jank-gen/threw (first v))))

(defn- mismatches
  "The cases jank answers differently from Clojure, as {:i index :jank outcome}: one
   assertion a test, so that its failure (the runner reports a test's first) names them all."
  [cases]
  (vec (remove nil? (map-indexed (fn [i [code kind v]]
                                   (let [got (ev code)
                                         same (try (if (= kind :throws) (threw? got) (= v got))
                                                   (catch cpp/jank.runtime.object_ref _ false))]
                                     (when-not same {:i i :jank got})))
                                 cases))))

(deftest g0000
  (let [found (mismatches (quote [
      ["(into #{} [1 2 3])" :value #{1 3 2}]
      ["(let [x (min 127 (first (vector (count [0 -1 7 7]))))] (max x 127))" :value 127]
      ["(into #{} (mapv keyword? (sort-by identity (take 0 (list 1 2)))))" :value #{}]
      ["(let [x 256] (* x 1))" :value 256]
      ["(let [x (compare 128 0)] (* x (mod (first (vector (count (list 1 2)))) 3)))" :value 2]
      ["(neg? false)" :throws "java.lang.ClassCastException"]
      ["(let [x (dec -3)] (* x (quot (max (inc 9223372036854775807) 3) 1)))" :throws "java.lang.ArithmeticException"]
      ["(into #{} (filter even? (conj [1 2 3] 127)))" :value #{2}]
      ["(zipmap [:a] (sort (list 1 2)))" :value {:a 1}]
      ["(if (set? (if (neg? :x) (inc 255) (if (odd? (let [x 255] (* x 2))) (name :a) (frequencies [])))) (pos? (clojure.string/join \"-\" [3 1 2])) (concat [1 2 3] (list 1 2)))" :throws "java.lang.ClassCastException"]]))]
    (is (= [] found))))

