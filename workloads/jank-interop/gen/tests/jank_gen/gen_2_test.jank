      ["(first (vector (* (first (vector (first (vector 3)))) -9223372036854775808)))" :throws "java.lang.ArithmeticException"]
      ["(if (pos? (let [x (nth (vector (count \"Ab-C\") (count \" t \")) 1)] (* x (mod 1 1)))) \\z (number? (clojure.string/replace (clojure.string/replace \"é\" \"b\" \"\") \" \" \"\")))" :value false]]))]
