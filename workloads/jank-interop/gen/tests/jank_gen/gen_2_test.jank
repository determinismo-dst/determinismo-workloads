      ["(every? pos? (distinct (concat (into (list) []) (list 1 2))))" :value true]
      ["(into #{} (map (fn [x] (* x 2)) (distinct [0 -1 7 7])))" :value #{0 -2 14}]
      ["(clojure.string/join \"\" (interleave [] (interleave (sort-by str (keys {:a 1, :b 2})) [1 2 3])))" :value ""]
      ["(first (vector (first (vector 10))))" :value 10]
      ["(keyword? (if (nil? (into #{} [0 1 2 3 4])) (clojure.string/join \",\" (concat (list 1 2) [1 1 1])) \\a))" :value false]
      ["(str sym :a)" :throws "clojure.lang.Compiler$CompilerException"]
      ["(let [x 0] (+ x 10))" :value 10]
      ["(seq? (count (subs \"é-è\" 0)))" :value false]]))]
    (is (= [] found))))

(deftest g0020
  (let [found (mismatches (quote [
      ["(if (keyword? (into #{} [0 -1 7 7])) (pos? -9223372036854775808) (compare (count (pr-str 3.0)) (max (first (vector 128)) (count \"Ab-C\"))))" :value -1]
      ["(if (map? 9223372036854775807) (zipmap [:a :b] (remove pos? [0 1 2 3 4])) (nth (vector (dec 255) (quot (first (vector 255)) 1)) 0))" :value 254]
      ["(get (select-keys {:a 1} [:a :b]) :a)" :value 1]
      ["(pr-str \\a)" :value "\\a"]
      ["(+ (quot 7 -2) (quot 0 1))" :value -3]
      ["(pr-str (clojure.string/replace (pr-str (compare -9223372036854775808 255)) \"b\" \"\"))" :value "\"-1\""]
