      ["(some odd? [1 2 3])" :value true]
      ["(if (zero? (get (merge (frequencies (list 1 2)) (dissoc {} :x)) :x)) (name :a) ((fn [x] (and (number? x) (> x 2))) (clojure.string/join \"-\" (conj [0 -1 7 7] 10))))" :throws "java.lang.NullPointerException"]
      ["(interleave (remove even? [0 -1 7 7]) (mapv identity [0 -1 7 7]))" :value (-1 0 7 -1 7 7)]
      ["(nil? (if (vector? \\a) (dec (compare 128 9223372036854775807)) (partition 2 (conj [] 3))))" :value false]
      ["(if (pos? [3 1 2]) \\z (get {:a 1, :b 2} :b))" :throws "java.lang.ClassCastException"]]))]
    (is (= [] found))))

