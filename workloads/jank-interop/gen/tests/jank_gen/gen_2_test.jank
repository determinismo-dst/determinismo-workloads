;; SPDX-License-Identifier: MIT
;; Generated by workloads/jank-interop/gen/gen.clj, seed 2: each case's expected
;; outcome is Clojure 1.12's for a random form, so a mismatch on jank is a deviation.
(ns jank-gen.gen-2-test
  (:require [clojure.test :refer [deftest is]]
            [clojure.string]))

(defn- ev
  "The form's value, realized, or [:jank-gen/threw what] for any throw jank's handlers can
   see (an object, a native exception or a jank::error_ref): every form gets its own
   verdict. An object's message only: printing an ex-info makes jank crash as it exits
   (jankifier's S1). A thrown string is its own message: ex-message of one throws in jank
   (jankifier's LU62), which ended the test with no verdict (an overflowing inc throws one)."
  [s]
  (try (let [v (eval (read-string s))] (pr-str v) v)
       (catch cpp/jank.runtime.object_ref e [:jank-gen/threw (if (string? e) e (ex-message e))])
       (catch cpp/std.exception e [:jank-gen/threw (str (.what e))])
       (catch cpp/jank.error_ref e [:jank-gen/threw (str (.-message (cpp/* e)))])))

(defn- threw? [v] (and (vector? v) (= :jank-gen/threw (first v))))

(defn- mismatches
  "The cases jank answers differently from Clojure, as {:i index :jank outcome}: one
   assertion a test, so that its failure (the runner reports a test's first) names them all."
  [cases]
  (vec (remove nil? (map-indexed (fn [i [code kind v]]
                                   (let [got (ev code)
                                         same (try (if (= kind :throws) (threw? got) (= v got))
                                                   (catch cpp/jank.runtime.object_ref _ false))]
                                     (when-not same {:i i :jank got})))
                                 cases))))

(deftest g0000
  (let [found (mismatches (quote [
      ["(get {:k/v \"x\", :a [1]} :x)" :value nil]
      ["(some odd? [1 2 3])" :value true]
      ["(get (assoc {:k/v \"x\", :a [1]} :b 3) :k/v)" :value "x"]
      ["(into #{} (sort-by identity (remove even? [])))" :value #{}]
      ["(seq? {})" :value false]
      ["(clojure.string/replace (clojure.string/trim (subs \"é-è\" 2)) \" \" \"X\")" :value "è"]
      ["(get {:k/v \"x\", :a [1]} :k/v)" :value "x"]
      ["(get (dissoc (merge {} (select-keys {} [:a])) :b) :a)" :value nil]
      ["(let [x 7] (+ x (compare (- (compare 7 7) (rem -128 3)) (inc 3))))" :value 6]
      ["(clojure.string/join \"-\" (list 1 2))" :value "1-2"]]))]
    (is (= [] found))))

(deftest g0001
  (let [found (mismatches (quote [
      ["(let [x (compare (dec (reduce + 0 [])) (dec (nth (vector 10 256) 1)))] (* x (count (mapv (fn [x] (* x 2)) (concat [] (list 1 2))))))" :value -2]
      ["(dissoc (zipmap [:a :b :c] (conj (seq [1 2 3]) (count \"a\"))) :b)" :value {:a 1, :c 2}]
      ["(frequencies (mapv inc (map dec (interleave [0 -1 7 7] (list 1 2)))))" :value {0 1, 1 1, -1 1, 2 1}]
      ["(frequencies (concat (interleave [] (partition 3 [3 1 2])) [1 2 3]))" :value {1 1, 2 1, 3 1}]
      ["(into #{} [])" :value #{}]
      ["(let [x 10] (max x -9223372036854775808))" :value 10]
      ["(inc (first (vector 2)))" :value 3]
      ["(select-keys (frequencies (sort-by identity (vec [0 -1 7 7]))) [])" :value {}]
      ["(if (number? 3) (get (select-keys (frequencies []) []) :b) (str :a :c))" :value nil]
      ["(let [x (quot (nth (vector 127 (+ -3 10)) 0) 7)] (* x 127))" :value 2286]]))]
    (is (= [] found))))

(deftest g0002
  (let [found (mismatches (quote [
      ["(vector? \\a)" :value false]
      ["(number? (let [x 10] (+ x 0)))" :value true]
      ["(odd? :x)" :throws "java.lang.IllegalArgumentException"]
      ["(clojure.string/replace (clojure.string/join \"-\" [0 -1 7 7]) \"a\" \"\")" :value "0--1-7-7"]
      ["(let [x (count (clojure.string/replace \"\" \"b\" \"X\"))] (* x (count (filter zero? (sort-by identity [])))))" :value 0]
      ["((fn [x] (and (number? x) (> x 2))) (let [x (count (filter even? [1 1 1]))] (+ x (compare 7 1))))" :value false]
      ["(sort-by - [])" :value ()]
      ["(set? (if (neg? sym) 1 (even? (let [x -9223372036854775808] (* x 1000)))))" :throws "clojure.lang.Compiler$CompilerException"]
      ["(coll? [0 -1 7 7])" :value true]
      ["(odd? (select-keys (merge (dissoc {} :b) (dissoc {:k/v \"x\", :a [1]} :a)) [:a :b]))" :throws "java.lang.IllegalArgumentException"]]))]
    (is (= [] found))))

(deftest g0003
  (let [found (mismatches (quote [
      ["(clojure.string/trim \"Ab-C\")" :value "Ab-C"]
      ["(even? (drop 1 (remove odd? (partition-all 1 []))))" :throws "java.lang.IllegalArgumentException"]
      ["(into (list) (sort-by identity [1 1 1]))" :value (1 1 1)]
      ["(every? even? [0 1 2 3 4])" :value false]
      ["(group-by even? [-3 -3 (* (- -9223372036854775808 1) (- -128 -128))])" :throws "java.lang.ArithmeticException"]
      ["(map inc (into [] (map (fn [x] (* x 2)) [1 2 3])))" :value (3 5 7)]
      ["(into #{} (conj [3 (count \"a\")] (reduce + 0 (filter pos? [0 1 2 3 4]))))" :value #{1 3 10}]
      ["(let [x 1000] (+ x (compare 255 (dec (- 255 0)))))" :value 1001]
      ["(get (dissoc {:a 1} :c) :b)" :value nil]
      ["(if (zero? \"é\") (let [x -9223372036854775808] (* x (rem (reduce + 0 (list 1 2)) -2))) (into #{} [0 1 2 3 4]))" :throws "java.lang.ClassCastException"]]))]
    (is (= [] found))))

