      ["(every? odd? (interleave (map dec (concat [0 -1 7 7] [])) (sort-by str (keys (group-by even? [1 2 3])))))" :throws "java.lang.IllegalArgumentException"]
      ["[(rem (compare 9223372036854775807 -3) 3)]" :value [1]]
