      ["(some even? [1 2 3])" :value true]
      ["(subs \"abcdef\" 2)" :value "cdef"]
      ["(let [x (- (count (sort-by - (list 1 2))))] (* x (dec (max (max -9223372036854775808 -128) 255))))" :value -508]
      ["(every? even? [1 1 1])" :value false]
