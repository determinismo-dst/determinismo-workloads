      ["(select-keys {} [])" :value {}]
      ["(group-by even? [0 1 2 3 4])" :value {true [0 2 4], false [1 3]}]
      ["(every? odd? [1 2 3])" :value false]
      ["(pr-str nil)" :value "nil"]]))]
    (is (= [] found))))

(deftest g0018
  (let [found (mismatches (quote [
      ["(float? {:k/v \"x\", :a [1]})" :value false]
      ["(into #{} (interleave (concat (concat [0 -1 7 7] (list 1 2)) [1 1 1]) (sort-by - [-9223372036854775808 1])))" :throws "java.lang.ArithmeticException"]
