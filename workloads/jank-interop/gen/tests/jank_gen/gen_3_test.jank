(deftest g0016
  (let [found (mismatches (quote [
      ["(/ (dec (inc (bit-and -1 256))) 7)" :value 256/7]
      ["(if (number? (if (neg? :k/v) (count (remove odd? (list 1 2))) nil)) false [3 1 2])" :throws "java.lang.ClassCastException"]
      ["(quot (unchecked-subtract 3 (dec' (max -3 128))) -2)" :value 62]
      ["(if (NaN? (some pos? (remove odd? (mapv str [0 1 2 3 4])))) (select-keys (dissoc (merge {:a 1} {:a 1}) :c) []) (if (some? (let [x (compare 256 -1)] (+ x (reduce + 0 [1 2 3])))) (into #{} (sort-by str (keys {}))) \"é\"))" :throws "java.lang.IllegalArgumentException"]
      ["(unsigned-bit-shift-right (count (map (fn [x] (* x 2)) (mapv (fn [x] (* x 2)) [0 1 2 3 4]))) -1)" :value 0]
      ["(get {:a 1} :a)" :value 1]
      ["(into #{} (mapv str (conj (list 1 2) (first (vector 3)))))" :value #{"3" "1" "2"}]
      ["(rational? \" t \")" :value false]
      ["(get (dissoc (frequencies (remove odd? [0 -1 7 7])) :b) :a)" :value nil]
      ["(if (float? (get (merge (dissoc {} :c) (group-by odd? [1 1 1])) :c)) 1.0E10 (clojure.string/upper-case \"a😀b\"))" :value "A😀B"]]))]
    (is (= [] found))))

(deftest g0017
  (let [found (mismatches (quote [
