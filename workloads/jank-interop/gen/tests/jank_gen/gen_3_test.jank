      ["(group-by pos? (filter pos? (map inc [128])))" :value {true [129]}]
      ["(zipmap [:a :b :c] (sort-by str (keys (zipmap [:a :b] [3 1 2]))))" :value {:a :a, :b :b}]
      ["(let [x (nth (vector (count \"日本語\") (unchecked-dec (reduce + 0 []))) 0)] (max x (unchecked-multiply (reduce + 0 (partition-all 2 [3 1 2])) 128)))" :throws "java.lang.ClassCastException"]
      ["(let [x (+' (+' 9223372036854775807 (first (vector 2))) (* (compare 2 128) 1000))] (* x (reduce + 0 [1 2 3])))" :value 55340232221128648854N]
      ["(into #{} [(count (subs \"é-è\" 2)) (inc' 127)])" :value #{128 1}]
      ["(get (dissoc (zipmap [:a] [0 -1 7 7]) :k/v) :b)" :value nil]]))]
    (is (= [] found))))

