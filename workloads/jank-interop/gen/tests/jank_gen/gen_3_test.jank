;; SPDX-License-Identifier: MIT
;; Generated by workloads/jank-interop/gen/gen.clj, seed 3: each case's expected
;; outcome is Clojure 1.12's for a random form, so a mismatch on jank is a deviation.
(ns jank-gen.gen-3-test
  (:require [clojure.test :refer [deftest is]]
            [clojure.string]))

(defn- ev
  "The form's value, realized, or [:jank-gen/threw what] for any throw jank's handlers can
   see (an object, a native exception or a jank::error_ref): every form gets its own
   verdict. An object's message only: printing an ex-info makes jank crash as it exits
   (jankifier's S1). A thrown string is its own message: ex-message of one throws in jank
   (jankifier's LU62), which ended the test with no verdict (an overflowing inc throws one)."
  [s]
  (try (let [v (eval (read-string s))] (pr-str v) v)
       (catch cpp/jank.runtime.object_ref e [:jank-gen/threw (if (string? e) e (ex-message e))])
       (catch cpp/std.exception e [:jank-gen/threw (str (.what e))])
       (catch cpp/jank.error_ref e [:jank-gen/threw (str (.-message (cpp/* e)))])))

(defn- threw? [v] (and (vector? v) (= :jank-gen/threw (first v))))

(defn- mismatches
  "The cases jank answers differently from Clojure, as {:i index :jank outcome}: one
   assertion a test, so that its failure (the runner reports a test's first) names them all."
  [cases]
  (vec (remove nil? (map-indexed (fn [i [code kind v]]
                                   (let [got (ev code)
                                         same (try (if (= kind :throws) (threw? got) (= v got))
                                                   (catch cpp/jank.runtime.object_ref _ false))]
                                     (when-not same {:i i :jank got})))
                                 cases))))

(deftest g0000
  (let [found (mismatches (quote [
      ["(into #{} (into (list) (sort-by identity (sort-by str (keys {})))))" :value #{}]
      ["(into #{} (sort-by str (keys (merge (merge {} {:a 1, :b 2}) {:a 1}))))" :value #{:b :a}]
      ["(get (frequencies (list 1 2)) :x)" :value nil]
      ["(let [x 9223372036854775807] (max x (dec -3)))" :value 9223372036854775807]
      ["(get {:a 1} :a)" :value 1]
      ["(zipmap [:a] (map (fn [x] (* x 2)) [0 1 2 3 4]))" :value {:a 0}]
      ["(get {:a 1, :b 2} :a)" :value 1]
      ["(frequencies (filter odd? (rest (remove pos? [3 1 2]))))" :value {}]
      ["(into #{} [3 1 2])" :value #{1 3 2}]
      ["(pr-str [0 -1 7 7])" :value "[0 -1 7 7]"]]))]
    (is (= [] found))))

(deftest g0001
  (let [found (mismatches (quote [
      ["(pos? (vector? 10))" :throws "java.lang.ClassCastException"]
      ["(merge (dissoc (assoc (dissoc {:a 1, :b 2} :c) :x -9223372036854775808) :x) (merge (zipmap [:a :b :c] [1 2 3]) (frequencies [3 1 2])))" :value {:a 1, :b 2, :c 3, 3 1, 1 1, 2 1}]
      ["(NaN? :k/v)" :throws "java.lang.ClassCastException"]
      ["(odd? 1.0E10)" :throws "java.lang.IllegalArgumentException"]
      ["(rest (partition 1 (list 1 2)))" :value ((2))]
      ["(let [x 10] (+ x 128))" :value 138]
      ["(zero? (zero? \"ü\"))" :throws "java.lang.ClassCastException"]
      ["(set? nil)" :value false]
      ["(some even? (sort-by str (keys (frequencies (partition 1 [0 1 2 3 4])))))" :throws "java.lang.IllegalArgumentException"]
      ["(into #{} (map (fn [x] (* x 2)) [3 1 2]))" :value #{4 6 2}]]))]
    (is (= [] found))))

(deftest g0002
  (let [found (mismatches (quote [
      ["(zero? (if (double? (merge (dissoc {:a 1, :b 2} :x) (merge {} {}))) false (if (zero? (some odd? (list 1 2))) (coll? (get {:a 1} :a)) \" t \")))" :throws "java.lang.ClassCastException"]
      ["(into #{} [(compare (name :b) (subs \"日本語\" 0 3)) (compare 9223372036854775807 10) 0])" :value #{0 1 -25987}]
      ["(max (*' (compare \"abc\" \" t \") 0) -1)" :value 0]
      ["(float? (sort-by str (keys {:a 1})))" :value false]
      ["(let [x 10] (max x (count (butlast [3 1 2]))))" :value 10]
      ["(let [x (reduce + 0 (list 1 2))] (* x (compare (subs \"hello\" 0) (subs \"😀\" 0 2))))" :value -165759]
      ["(some even? (drop 2 (sort-by str (keys {:a 1}))))" :value nil]
      ["(compare (compare (pr-str \"ü\") \"日本語\") 128)" :value -1]
      ["((fn [x] (and (number? x) (> x 2))) (bit-shift-right 256 -1))" :value false]
      ["(get (group-by pos? (conj (map (fn [x] (* x 2)) []) 2)) :x)" :value nil]]))]
    (is (= [] found))))

