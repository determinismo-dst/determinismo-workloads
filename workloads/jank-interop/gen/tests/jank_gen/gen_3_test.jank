      ["(if (pos? (compare (bit-xor (quot -9223372036854775808 3) 1) -9223372036854775808)) (* 128 1) \\a)" :value 128]
      ["(some even? [3 1 2])" :value true]
      ["(get (assoc (merge (frequencies [0 1 2 3 4]) {:a 1}) :x (bit-shift-right 1 64)) :c)" :value nil]]))]
    (is (= [] found))))

