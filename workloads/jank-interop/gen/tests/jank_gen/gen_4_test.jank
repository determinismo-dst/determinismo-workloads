(deftest g0049
  (let [found (mismatches (quote [
      ["(not-empty (filter (some-fn odd? pos?) (keys (into (sorted-map) {:a 1, :b 2}))))" :throws "java.lang.IllegalArgumentException"]
      ["(get (zipmap [:a :b :c] [3 1 2]) :b)" :value 1]
      ["(clojure.set/rename-keys (update {:a 1} :b (fnil inc' 0)) {:a :z})" :throws "clojure.lang.Compiler$CompilerException"]
      ["(str (clojure.string/ends-with? (clojure.string/join \"|\" (clojure.string/split (apply str (interpose \",\" (filter (some-fn odd? pos?) (list 1 2)))) #\"b\")) \"a\"))" :value "false"]
      ["(if (seq (map (juxt inc identity) [0 -1 7 7])) 2 (empty? (range -1 5 1)))" :value 2]
      ["(empty? (take 2 (cycle (cons 1 (map (comp inc -) (distinct [0 -1 7 7]))))))" :value false]
      ["(empty? (mapcat (fn [x] [x x]) (partition-all 2 1 (sort-by first (map vector (list 1 2) (range))))))" :value false]
      ["(disj (into #{} (map inc (filter (every-pred odd? pos?) (take 0 (cycle (cons 1 [0 -1 7 7])))))) 2)" :value #{}]
      ["(get (clojure.set/rename-keys (zipmap [:a :b :c] (partition-all 1 2 (list 1 2))) {:a :z}) :a)" :throws "clojure.lang.Compiler$CompilerException"]
      ["(into #{} (map inc (list 1 2)))" :value #{3 2}]]))]
    (is (= [] found))))
