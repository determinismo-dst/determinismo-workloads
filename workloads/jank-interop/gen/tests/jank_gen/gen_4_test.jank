;; SPDX-License-Identifier: MIT
;; Generated by workloads/jank-interop/gen/gen.clj, seed 4: each case's expected
;; outcome is Clojure 1.12's for a random form, so a mismatch on jank is a deviation.
(ns jank-gen.gen-4-test
  (:require [clojure.test :refer [deftest is]]
            [clojure.string]))

(defn- ev
  "The form's value, realized, or [:jank-gen/threw what] for any throw jank's handlers can
   see (an object, a native exception or a jank::error_ref): every form gets its own
   verdict. An object's message only: printing an ex-info makes jank crash as it exits
   (jankifier's S1). A thrown string is its own message: ex-message of one throws in jank
   (jankifier's LU62), which ended the test with no verdict (an overflowing inc throws one)."
  [s]
  (try (let [v (eval (read-string s))] (pr-str v) v)
       (catch cpp/jank.runtime.object_ref e [:jank-gen/threw (if (string? e) e (ex-message e))])
       (catch cpp/std.exception e [:jank-gen/threw (str (.what e))])
       (catch cpp/jank.error_ref e [:jank-gen/threw (str (.-message (cpp/* e)))])))

(defn- threw? [v] (and (vector? v) (= :jank-gen/threw (first v))))

(defn- mismatches
  "The cases jank answers differently from Clojure, as {:i index :jank outcome}: one
   assertion a test, so that its failure (the runner reports a test's first) names them all."
  [cases]
  (vec (remove nil? (map-indexed (fn [i [code kind v]]
                                   (let [got (ev code)
                                         same (try (if (= kind :throws) (threw? got) (= v got))
                                                   (catch cpp/jank.runtime.object_ref _ false))]
                                     (when-not same {:i i :jank got})))
                                 cases))))

(deftest g0000
  (let [found (mismatches (quote [
      ["(zipmap [:a :b :c] (interpose 0 (list 1 2)))" :value {:a 1, :b 0, :c 2}]
      ["(merge-with min {:a 1, :b 2} (clojure.set/rename-keys (update-in (update-in {:a 1} [:x :z] (fnil inc' 0)) [:a :z] (fnil inc' 0)) {:a :z}))" :throws "clojure.lang.Compiler$CompilerException"]
      ["(merge-with +' {:a 1} {:a 1, :x {:y 2}})" :value {:a 2, :x {:y 2}}]
      ["(find (frequencies (map vector [3 1 2] (list 1 2))) :b)" :value nil]
      ["(let [x (get (assoc-in (group-by odd? [3 1 2]) [:x :y] 1000) :a -5) c (subvec [0 1 2 3 4 5] 1 5)] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(into #{} (map inc (subvec [0 1 2 3 4 5] 2 3)))" :value #{3}]
      ["(clojure.set/rename-keys (update-in (merge-with max (frequencies [0 -1 7 7]) (assoc-in {:a 1, :b 2} [:x :y] -1)) [:x :z] (fnil inc' 0)) {:a :z})" :throws "clojure.lang.Compiler$CompilerException"]
      ["(not-empty (filter (some-fn odd? pos?) (partition-by odd? [5 4 4 2 9 0])))" :throws "java.lang.IllegalArgumentException"]
      ["(find (frequencies (list 1 2)) :b)" :value nil]
      ["(set (map + (take 5 (cycle (cons 1 (vals (into (sorted-map) (zipmap [:a :b :c :d] [])))))) (partition 3 1 (mapcat (fn [x] [x x]) [1 2 3]))))" :throws "java.lang.ClassCastException"]]))]
    (is (= [] found))))

(deftest g0001
  (let [found (mismatches (quote [
      ["(if (seq (list 1 2)) (subvec [0 1 2 3 4 5] 1 5) (conj (clojure.set/select odd? (set (range 0 6 3))) 127))" :throws "clojure.lang.Compiler$CompilerException"]
      ["(get (update-in (zipmap [:a :b :c] (flatten (list [0 -1 7 7] (list [0 1 2 3 4])))) [:x :z] (fnil inc' 0)) :a -5)" :value 0]
      ["(boolean (interpose 0 (flatten (list (split-with (fn [x] (< x 3)) [1 1 1]) (list [0 -1 7 7])))))" :value true]
      ["(seq (sort (drop-while odd? (map-indexed vector []))))" :value nil]
      ["(if (seq (reductions min (flatten (list [] (list (seq (into (sorted-set) [1 2 3]))))))) (min (apply min 0 (range 2 3 -1)) (min (long (count [3 1 2])) (*' 3 1))) (clojure.string/join \",\" []))" :value 0]
      ["(if (empty? (subvec [0 1 2 3 4 5] 1 4)) (let [x 10 c [5 4 4 2 9 0]] (conj x c)) #{1 3 2})" :value #{1 3 2}]
      ["(empty? [0 -1 7 7])" :value false]
      ["(contains? (group-by odd? (sort compare [])) :b)" :value false]
      ["(not-any? #{1 2} (take-while neg? []))" :value true]
      ["(get {} :x)" :value nil]]))]
    (is (= [] found))))

(deftest g0002
  (let [found (mismatches (quote [
      ["(sort-by first (map vector (seq (into (sorted-set) (split-with (fn [x] (< x 3)) [0 1 2 3 4]))) (range)))" :throws "java.lang.ClassCastException"]
      ["(into #{} (map inc [0 -1 7 7]))" :value #{0 1 8}]
      ["(group-by pos? (map-indexed vector (map min (filter (every-pred odd? pos?) [0 -1 7 7]) (list 1 2))))" :throws "java.lang.ClassCastException"]
      ["(contains? (clojure.set/rename-keys (update-in (assoc-in {:a 1, :b 2} [:x :y] 1000) [:a :z] (fnil inc' 0)) {:a :z}) :a)" :throws "clojure.lang.Compiler$CompilerException"]
      ["(zipmap [:a :b :c] [0 1 2 3 4])" :value {:a 0, :b 1, :c 2}]
      ["(clojure.set/difference #{} (set [1 7 (reduce min 0 [1 2 3])]))" :throws "clojure.lang.Compiler$CompilerException"]
      ["(subs \"abcdef\" 0 4)" :value "abcd"]
      ["(if (empty? (subvec [0 1 2 3 4 5] 1 4)) (into #{} (map inc (reverse [3 1 2]))) (frequencies (seq (into (sorted-set) []))))" :value {}]
      ["(if (empty? (list 1 2)) (find (update-in {:a 1} [:a :z] (fnil inc' 0)) :a) (if (empty? (filter even? (take 6 (cycle (cons 1 [3 1 2]))))) (not-empty (seq (into (sorted-set) [1 1 1]))) {:a 1, :b 2}))" :value {:a 1, :b 2}]
      ["(quot (bit-flip (bit-or (- 7) (unsigned-bit-shift-right -128 57)) 19) -2)" :value 262144]]))]
    (is (= [] found))))

(deftest g0003
  (let [found (mismatches (quote [
      ["(frequencies [0 1 2 3 4])" :value {0 1, 1 1, 2 1, 3 1, 4 1}]
      ["(if (empty? [0 1 2 3 4]) (let [x 10 c [3 1 2]] (conj x c)) (contains? (group-by odd? (reductions max [0 1 2 3 4])) :x))" :value false]
      ["(clojure.string/join \"|\" (clojure.string/split (clojure.string/replace (clojure.string/join \",\" [3 1 2]) \"a\" \"\") #\" \"))" :value "3,1,2"]
      ["(conj (set (drop-while even? [3 1 2])) (reduce +' 0 (partition-by pos? (partition 3 1 [3 1 2]))))" :throws "java.lang.ClassCastException"]
      ["(boolean (map vector (mapcat (fn [x] [x x]) (partition-all 3 2 [0 1 2 3 4])) [255 -1 7]))" :value true]
      ["(not-empty (map (comp inc identity) (take 3 (cycle (cons 1 (vals (into (sorted-map) (zipmap [:a :b :c :d] (list 1 2)))))))))" :value (2 2 3)]
      ["(every? even? (keys (into (sorted-map) (merge-with max (zipmap [:a :b :c] [1 1 1]) (reduce-kv (fn [m k v] (assoc m k [v])) {} {:a 1})))))" :throws "java.lang.ClassCastException"]
      ["(disj (conj (set [1 2 3]) 127) 2)" :value #{1 3 127}]
      ["(get (clojure.set/rename-keys {} {:a :z}) :b)" :throws "clojure.lang.Compiler$CompilerException"]
      ["(empty? (sort compare (reductions +' (remove odd? [1 2 3]))))" :value false]]))]
    (is (= [] found))))

(deftest g0004
  (let [found (mismatches (quote [
      ["(empty? (flatten (list (filter (every-pred odd? pos?) [1 1 1]) (list (mapcat (fn [x] [x x]) (filter (every-pred odd? pos?) [0 1 2 3 4]))))))" :value false]
      ["(let [x 9223372036854775807 c (nthrest (flatten (list (flatten (list [1 1 1] (list [0 1 2 3 4]))) (list (take-while odd? [0 1 2 3 4])))) 1)] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(clojure.set/select odd? (set (map vector (flatten (list [3 1 2] (list (reverse [1 1 1])))) [0 1 2 3 4])))" :throws "clojure.lang.Compiler$CompilerException"]
      ["(drop-last (sort-by first (map vector (keep-indexed (fn [i x] (when (even? i) x)) (mapcat (fn [x] [x x]) [1 2 3])) (range))) 0)" :throws "java.lang.IllegalArgumentException"]
      ["(if (seq (keep-indexed (fn [i x] (when (even? i) x)) [0 1 2 3 4])) (if (seq (map-indexed vector [0 -1 7 7])) (if (empty? (reductions +' [0 1 2 3 4])) (if (empty? [1 1 1]) (not-any? #{1 2} [0 -1 7 7]) {}) (let [x -1 c [3 1 2]] (cons x c))) (empty? [3 1 2])) (not-any? #{1 2} (sort-by first (map vector (flatten (list [] (list [1 2 3]))) (range)))))" :value (-1 3 1 2)]
      ["(contains? (frequencies [0 1 2 3 4]) :b)" :value false]
      ["(frequencies (reverse [5 4 4 2 9 0]))" :value {0 1, 9 1, 2 1, 4 2, 5 1}]
      ["(let [x 0 c (distinct [0 -1 7 7])] (cons x c))" :value (0 0 -1 7)]
      ["(empty? (map (comp inc -) [1 2 3]))" :value false]
      ["(bit-shift-right -3 7)" :value -1]]))]
    (is (= [] found))))

(deftest g0005
  (let [found (mismatches (quote [
      ["(bit-and-not (min 1000 (inc' (apply max 0 []))) 7)" :value 0]
      ["(clojure.set/rename-keys (select-keys (zipmap [:a :b :c] [0 1 2 3 4]) [:a :b]) {:a :z})" :throws "clojure.lang.Compiler$CompilerException"]
      ["(get (zipmap [:a :b :c] [3 1 2]) :a)" :value 3]
      ["(let [x (max (long (count [3 1 2])) (bit-flip 255 32)) c (take-while odd? (subvec [0 1 2 3 4 5] 2 6))] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(min-key abs (get (group-by even? [0 -1 7 7]) :a -5) (long (count (sort compare [3 1 2]))) (first (vec (cons 0 [1 1 1]))))" :value 0]
      ["(if (seq (subvec [0 1 2 3 4 5] 0 6)) (split-at 2 [0 1 2 3 4]) (every? even? (interpose 0 (map (juxt inc dec) (list 1 2)))))" :value [(0 1) (2 3 4)]]
      ["(map (juxt inc dec) (butlast (nthrest (list 1 2) 2)))" :value ()]
      ["(let [x (apply max 0 (take-while pos? [1 2 3])) c (keys (into (sorted-map) (assoc-in (assoc-in {:a 1, :b 2} [:x :y] 2) [:x :y] (get {:a 1} :a -5))))] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(let [x 3 c (keys (into (sorted-map) {:a 1}))] (cons x c))" :value (3 :a)]
      ["(update (zipmap [:a :b :c] (partition-by pos? (range 0 3 -1))) :b (fnil inc' 0))" :value {:b 1}]]))]
    (is (= [] found))))

(deftest g0006
  (let [found (mismatches (quote [
      ["(list 1 2)" :value (1 2)]
      ["(select-keys (assoc-in (reduce-kv (fn [m k v] (assoc m k [v])) {} (group-by pos? [1 1 1])) [:x :y] -128) [:a :b])" :value {}]
      ["(mod -1 2)" :value 1]
      ["(not-every? #{1 2} [10 7 (bit-and-not (long (count [1 1 1])) -1)])" :value true]
      ["(if (seq (map min (keep-indexed (fn [i x] (when (even? i) x)) (flatten (list [1 1 1] (list [0 -1 7 7])))) [5 4 4 2 9 0])) (seq [0 -1 7 7]) (find (merge-with min (select-keys {:a 1, :x {:y 2}} []) (zipmap [:a :b :c] [0 -1 7 7])) :b))" :value (0 -1 7 7)]
      ["(boolean (split-with 3 (interpose 0 [5 4 4 2 9 0])))" :value true]
      ["(update-in {} [:a :z] (fnil inc' 0))" :value {:a {:z 1}}]
      ["(let [x 2 c []] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(set (take 2 (cycle (cons 1 (keys (into (sorted-map) {:a 1, :b 2}))))))" :value #{1 :a}]
      ["(get (merge-with max (clojure.set/rename-keys (update-in {} [:x :z] (fnil inc' 0)) {:a :z}) (assoc-in (clojure.set/rename-keys {:a 1, :x {:y 2}} {:a :z}) [:x :y] (reduce +' 0 [0 1 2 3 4]))) :a)" :throws "clojure.lang.Compiler$CompilerException"]]))]
    (is (= [] found))))

(deftest g0007
  (let [found (mismatches (quote [
      ["(some pos? (map (juxt inc identity) (map vector (map-indexed vector [0 -1 7 7]) (list 1 2))))" :throws "java.lang.ClassCastException"]
      ["(let [x (long (count (filter (some-fn odd? pos?) (keep-indexed (fn [i x] (when (even? i) x)) (list 1 2))))) c [0 1 2 3 4]] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(get (merge-with +' {:a 1, :b 2} {:a 1, :b 2}) :x)" :value nil]
      ["(if (seq [3 1 2]) (get {:a 1, :b 2} :b) -3)" :value 2]
      ["(clojure.string/join \"-\" [0 1 2 3 4])" :value "0-1-2-3-4"]
      ["(contains? {:a 1, :x {:y 2}} :x)" :value true]
      ["(into #{} (map inc [0 -1 7 7]))" :value #{0 1 8}]
      ["(nthnext (partition 1 1 []) 1)" :value nil]
      ["(disj (clojure.set/difference #{:b :a} (conj (set (list 1 2)) (first (vec (cons 0 [3 1 2]))))) :a)" :throws "clojure.lang.Compiler$CompilerException"]
      ["(find (zipmap [:a :b :c] (take 3 (cycle (cons 1 (seq (into (sorted-set) [5 4 4 2 9 0])))))) :x)" :value nil]]))]
    (is (= [] found))))

(deftest g0008
  (let [found (mismatches (quote [
      ["(str (inc' -128) \":\" (subs \"abcdef\" 0 4))" :value "-127:abcd"]
      ["(let [x 2 c [0 -1 7 7]] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(let [x 9223372036854775807 c [0 -1 7 7]] (cons x c))" :value (9223372036854775807 0 -1 7 7)]
      ["(not-empty (rest [5 4 4 2 9 0]))" :value (4 4 2 9 0)]
      ["(let [x 3 c [0 -1 7 7]] (cons x c))" :value (3 0 -1 7 7)]
      ["(update-in {} [:x :z] (fnil inc' 0))" :value {:x {:z 1}}]
      ["(boolean (vals (into (sorted-map) (zipmap [:a :b :c :d] [5 4 4 2 9 0]))))" :value true]
      ["(into #{} (map inc [0 1 2 3 4]))" :value #{1 4 3 2 5}]
      ["(contains? (frequencies (sort < (rest [1 2 3]))) :x)" :value false]
      ["(not-any? even? (vals (into (sorted-map) (zipmap [:a :b :c :d] [1 1 1]))))" :value true]]))]
    (is (= [] found))))

(deftest g0009
  (let [found (mismatches (quote [
      ["(let [x 127 c []] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(let [x -1 c (map (juxt inc identity) (filter (some-fn odd? pos?) (take 2 (cycle (cons 1 [0 1 2 3 4])))))] (cons x c))" :value (-1 [2 1])]
      ["(let [x -1 c (mapcat (fn [x] [x x]) (sort-by first (map vector [1 1 1] (range))))] (cons x c))" :value (-1 [1 0] [1 0] [1 1] [1 1] [1 2] [1 2])]
      ["(not-every? even? (interpose 0 (interpose 0 (split-with (fn [x] (< x 3)) [5 4 4 2 9 0]))))" :throws "java.lang.IllegalArgumentException"]
      ["[(bit-clear 1 45) (-' (apply +' 0 (drop [0 1 2 3 4] 1)) -1) (long (count (filter (some-fn odd? pos?) (butlast [0 -1 7 7]))))]" :throws "java.lang.IllegalArgumentException"]
      ["(remove even? [1 2 3])" :value (1 3)]
      ["(str (clojure.string/includes? \"a\\nb\" \"b\"))" :value "true"]
      ["(drop-last (mapcat (fn [x] [x x]) [5 4 4 2 9 0]) 1)" :throws "java.lang.IllegalArgumentException"]
      ["(-' 1000 (+' (reduce max 0 (map vector [1 2 3] [1 1 1])) (apply min 0 (range -2 4 1))))" :throws "java.lang.ClassCastException"]
      ["(bit-and-not 127 (bit-flip (reduce +' 0 (reductions +' [0 -1 7 7])) 21))" :value 109]]))]
    (is (= [] found))))

(deftest g0010
  (let [found (mismatches (quote [
      ["(boolean (filter even? [0 1 2 3 4]))" :value true]
      ["(max 9223372036854775807 (+' (bit-set 1 49) 255))" :value 9223372036854775807]
      ["(let [x -3 c [0 -1 7 7]] (cons x c))" :value (-3 0 -1 7 7)]
      ["(contains? (update (merge-with min (frequencies []) (reduce-kv (fn [m k v] (assoc m k [v])) {} {})) :b (fnil inc' 0)) :a)" :value false]
      ["(let [x (bit-flip (get (zipmap [:a :b :c] [3 1 2]) :x -5) 37) c []] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(let [x -3 c (interpose 0 [])] (cons x c))" :value (-3)]
      ["(disj (set (remove pos? (remove odd? []))) :a)" :value #{}]
      ["(seq (mapcat (fn [x] [x x]) (split-with (fn [x] (< x 3)) (filter (some-fn odd? pos?) [1 1 1]))))" :value ((1 1 1) (1 1 1) () ())]
      ["(boolean (list 1 2))" :value true]
      ["(some even? [])" :value nil]]))]
    (is (= [] found))))

(deftest g0011
  (let [found (mismatches (quote [
      ["(subs \"abcdef\" 2 4)" :value "cd"]
      ["(update-in (zipmap [:a :b :c] (sort < (split-with 2 [1 2 3]))) [:a :z] (fnil inc' 0))" :throws "java.lang.ClassCastException"]
      ["(if (empty? [1 1 1]) (contains? {:a 1} :x) (list 1 2))" :value (1 2)]
      ["(not-every? even? (keep-indexed (fn [i x] (when (even? i) x)) (drop (filter (every-pred odd? pos?) [0 1 2 3 4]) 2)))" :throws "java.lang.IllegalArgumentException"]
      ["(get {:a 1} :x)" :value nil]
      ["(not-every? even? (keep-indexed (fn [i x] (when (even? i) x)) [3 1 2]))" :value true]
      ["(take 4 (cycle (cons 1 (partition-all 3 1 (partition 3 1 (partition-all 3 2 (list 1 2)))))))" :value (1 1 1 1)]
      ["(conj (clojure.set/union (clojure.set/difference #{} (into #{} (map inc [0 -1 7 7]))) (clojure.set/difference (conj #{1 3 2} 127) (clojure.set/difference #{1} #{}))) (bit-shift-right 10 49))" :throws "clojure.lang.Compiler$CompilerException"]
      ["(not-every? pos? [5 4 4 2 9 0])" :value true]
      ["(not-any? odd? (take (sort-by first (map vector (map (comp inc identity) [0 -1 7 7]) (range))) 0))" :throws "java.lang.ClassCastException"]]))]
    (is (= [] found))))

(deftest g0012
  (let [found (mismatches (quote [
      ["(get (update (update-in (assoc-in {:a 1} [:x :y] 9223372036854775807) [:a :z] (fnil inc' 0)) :a (fnil inc' 0)) :b)" :throws "java.lang.ClassCastException"]
      ["(inc' (get (merge-with max (clojure.set/rename-keys {:a 1} {:a :z}) (update-in {:a 1, :b 2} [:x :z] (fnil inc' 0))) :x -5))" :throws "clojure.lang.Compiler$CompilerException"]
      ["(select-keys (select-keys (reduce-kv (fn [m k v] (assoc m k [v])) {} {}) [:a :b]) [])" :value {}]
      ["(let [x 7 c (filter (every-pred odd? pos?) (reductions +' (reductions max [5 4 4 2 9 0])))] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(if (empty? (map (juxt inc -) (keep-indexed (fn [i x] (when (even? i) x)) (flatten (list [] (list [0 -1 7 7])))))) (merge-with +' (frequencies (sort > (list 1 2))) (reduce-kv (fn [m k v] (assoc m k [v])) {} (update-in {:a 1} [:a :z] (fnil inc' 0)))) {:a 1})" :value {:a 1}]
      ["(if (empty? (map max (keys (into (sorted-map) {:a 1, :b 2})) (partition 3 1 (map + [] [0 -1 7 7])))) (get (select-keys (zipmap [:a :b :c] []) [:a :b]) :b) (every? #{1 2} (seq (into (sorted-set) (list 1 2)))))" :value nil]
      ["(clojure.string/replace (apply str (interpose \",\" [])) \"b\" \"--\")" :value ""]
      ["(empty? (dedupe (reductions +' (range -3 7 2))))" :value false]
      ["(if (seq (reductions +' (take (interpose 0 [1 1 1]) 3))) (subvec [0 1 2 3 4 5] 0 5) (get (group-by even? (flatten (list [1 1 1] (list [5 4 4 2 9 0])))) :a))" :throws "java.lang.ClassCastException"]
      ["(peek (vec (cons 0 (seq (into (sorted-set) (range 1 4 3))))))" :value 1]]))]
    (is (= [] found))))

(deftest g0013
  (let [found (mismatches (quote [
      ["(if (empty? [0 -1 7 7]) (set (take 1 (cycle (cons 1 (reductions max []))))) (every? #{1 2} (sort-by first (map vector (partition-by identity [5 4 4 2 9 0]) (range)))))" :throws "java.lang.ClassCastException"]
      ["(if (empty? [3 1 2]) (map-indexed vector (map vector (subvec [0 1 2 3 4 5] 0 5) (sort-by first (map vector (list 1 2) (range))))) (let [x 10 c (filter (some-fn odd? pos?) (split-at (fn [x] (< x 3)) [5 4 4 2 9 0]))] (conj x c)))" :throws "java.lang.ClassCastException"]
      ["(set (take 1 (cycle (cons 1 (subvec [0 1 2 3 4 5] 1 3)))))" :value #{1}]
      ["(str (clojure.string/includes? \" t \" \"a\"))" :value "false"]
      ["(if (seq (map min (split-at (fn [x] (< x 3)) [0 -1 7 7]) (filter (some-fn odd? pos?) (subvec [0 1 2 3 4 5] 0 4)))) #{} (conj #{1} (bit-xor (- 127) (get {} :a -5))))" :throws "java.lang.ClassCastException"]
      ["(find (update (zipmap [:a :b :c] (list 1 2)) :b (fnil inc' 0)) :b)" :value [:b 3]]
      ["(if (seq (take [1 1 1] 1)) \"hello world\" #{1 3 2})" :throws "java.lang.ClassCastException"]
      ["(let [x 9223372036854775807 c (remove neg? (seq (into (sorted-set) (interpose 0 [0 1 2 3 4]))))] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(find (frequencies (keys (into (sorted-map) (reduce-kv (fn [m k v] (assoc m k [v])) {} {})))) :x)" :value nil]
      ["(not-every? pos? (list 1 2))" :value false]]))]
    (is (= [] found))))

(deftest g0014
  (let [found (mismatches (quote [
      ["(every? #{1 2} (range -2 3 3))" :value false]
      ["(if (empty? (list 1 2)) 128 (subvec [0 1 2 3 4 5] 2 5))" :value [2 3 4]]
      ["(some odd? (interpose 0 [5 4 4 2 9 0]))" :value true]
