      ["(clojure.string/trimr \"Ab-C\")" :value "Ab-C"]
      ["(disj (set [0 -1 7 7]) :a)" :value #{0 7 -1}]
      ["(if (empty? [5 4 4 2 9 0]) (if (seq [5 4 4 2 9 0]) [1 2 3] (find (select-keys {:a 1, :b 2} [:a :b]) :a)) (get (update (zipmap [:a :b :c] [1 1 1]) :b (fnil inc' 0)) :a))" :value 1]
