      ["(not-empty (interpose 0 [1 2 3]))" :value (1 0 2 0 3)]
      ["(if (seq [0 -1 7 7]) (contains? {:a 1, :b 2} :x) (not-every? pos? (partition-all 2 2 (take-while pos? [1 1 1]))))" :value false]
      ["(rem 9223372036854775807 2)" :value 1]
      ["(seq [0 1 2 3 4])" :value (0 1 2 3 4)]
      ["(into #{} (map inc (partition-by identity (take 1 (cycle (cons 1 (take 3 (cycle (cons 1 [0 1 2 3 4])))))))))" :throws "java.lang.ClassCastException"]
      ["(apply str (interpose \",\" [1 1 1]))" :value "1,1,1"]
      ["(clojure.string/lower-case \"\")" :value ""]]))]
