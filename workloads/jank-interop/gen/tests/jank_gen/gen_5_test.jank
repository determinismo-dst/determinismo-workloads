      ["(range 2 4 2)" :value (2)]
      ["(get (update (zipmap [:a :b :c] (sort-by first (map vector (list 1 2) (range)))) :a (fnil inc' 0)) :b)" :throws "java.lang.ClassCastException"]]))]
    (is (= [] found))))

(deftest g0013
  (let [found (mismatches (quote [
      ["(flatten (list (mapcat (fn [x] [x x]) (split-with 3 [1 1 1])) (list (vals (into (sorted-map) (zipmap [:a :b :c :d] (take 3 (cycle (cons 1 [-1 10])))))))))" :throws "java.lang.ClassCastException"]
      ["(every? odd? (take 1 (cycle (cons 1 (map (comp inc identity) [1000 9223372036854775807 7])))))" :value true]
      ["(vals (into (sorted-map) (zipmap [:a :b :c :d] (keep-indexed (fn [i x] (when (even? i) x)) (list 1 2)))))" :value (1)]
      ["(seq (map vector (mapcat (fn [x] [x x]) [0 -1 7 7]) (seq (into (sorted-set) [3 1 2]))))" :value ([0 1] [0 2] [-1 3])]
      ["(map max [5 4 4 2 9 0] (partition-by identity [-1 (first (vec (cons 0 [1 1 1]))) (reduce +' 0 [5 4 4 2 9 0])]))" :throws "java.lang.ClassCastException"]
      ["(let [x 9223372036854775807 c (subvec [0 1 2 3 4 5] 0 5)] (cons x c))" :value (9223372036854775807 0 1 2 3 4)]
      ["(drop-while even? [0 1 2 3 4])" :value (1 2 3 4)]
