      ["(let [x (min-key abs 7 (dec' -128) (rem 10 -2)) c (subvec [0 1 2 3 4 5] 0 5)] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(if (seq [1 1 1]) (find (group-by odd? []) :x) #{1 3 2})" :value nil]
      ["(if (seq (sort > (partition-by odd? [5 4 4 2 9 0]))) (seq (nthnext [3 1 2] 0)) (range 2 7 -1))" :throws "java.lang.ClassCastException"]
      ["(if (seq (take 0 (cycle (cons 1 (sort-by first (map vector (map max [5 4 4 2 9 0] [0 -1 7 7]) (range))))))) (reduce max 0 (list 1 2)) (zipmap [:a :b :c] (split-at (fn [x] (< x 3)) (take [0 -1 7 7] 0))))" :throws "java.lang.ClassCastException"]
      ["(clojure.set/intersection (clojure.set/select odd? (set (reductions max (take 0 (cycle (cons 1 (list 1 2))))))) (set (keys (into (sorted-map) {:a 1, :x {:y 2}}))))" :throws "clojure.lang.Compiler$CompilerException"]
      ["(update-in (merge-with +' {:a 1} (select-keys (clojure.set/rename-keys {:a 1, :x {:y 2}} {:a :z}) [:a])) [:x :z] (fnil inc' 0))" :throws "clojure.lang.Compiler$CompilerException"]
      ["(seq (range -2 5 2))" :value (-2 0 2 4)]
      ["(min-key abs (inc' (min-key - (get {:a 1, :x {:y 2}} :b -5) (abs -1) 10)) 9223372036854775807 2)" :value 2]]))]
