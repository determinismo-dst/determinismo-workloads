      ["(if (empty? (map (comp inc dec) [3 1 2])) {:a 1, :b 2} [5 4 4 2 9 0])" :value [5 4 4 2 9 0]]
      ["(contains? (frequencies (subvec [0 1 2 3 4 5] 0 3)) :a)" :value false]
      ["(contains? {:a 1, :b 2} :a)" :value true]
      ["(take-last (mapcat (fn [x] [x x]) (list 1 2)) 2)" :throws "java.lang.IllegalArgumentException"]
      ["(empty? (take 2 (cycle (cons 1 (sort-by first (map vector (range -3 3 1) (range)))))))" :value false]
      ["(bit-xor (bit-and (+' (bit-set 128 11) 10) (reduce +' 0 (filter (every-pred odd? pos?) [3 1 2]))) (apply max 0 []))" :value 0]
      ["(not-any? #{1 2} [0 -1 7 7])" :value true]
      ["(if (empty? [1 2 3]) (reduce-kv (fn [m k v] (assoc m k [v])) {} (assoc-in (group-by pos? [0 1 2 3 4]) [:x :y] 10)) (some even? (rest (sort < [0 -1 7 7]))))" :value true]]))]
    (is (= [] found))))

