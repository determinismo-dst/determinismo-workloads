      ["(vals (into (sorted-map) (zipmap [:a :b :c :d] (partition 3 1 (split-with (fn [x] (< x 3)) [1 2 3])))))" :value nil]
      ["(get (frequencies (interpose 0 (map (juxt inc -) [0 -1 7 7]))) :x)" :value nil]
      ["(conj #{} -1)" :value #{-1}]
      ["(not-every? even? (map (juxt inc -) (range -3 6 1)))" :throws "java.lang.IllegalArgumentException"]
