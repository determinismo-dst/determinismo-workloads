      ["(reduce min 0 (range -2 5 -1))" :value 0]
      ["(let [x (get (update-in (merge-with max {} {:a 1, :x {:y 2}}) [:x :z] (fnil inc' 0)) :a -5) c (mapcat (fn [x] [x x]) [1 1 1])] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(if (seq (keys (into (sorted-map) (assoc-in {} [:x :y] 0)))) (disj #{} 1) (nthnext [3 1 2] 1))" :value #{}]]))]
