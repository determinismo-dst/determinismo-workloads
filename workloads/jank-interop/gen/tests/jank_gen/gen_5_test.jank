      ["(update-in (update-in (clojure.set/rename-keys (reduce-kv (fn [m k v] (assoc m k [v])) {} {:a 1}) {:a :z}) [:x :z] (fnil inc' 0)) [:x :z] (fnil inc' 0))" :throws "clojure.lang.Compiler$CompilerException"]
      ["(clojure.set/rename-keys (reduce-kv (fn [m k v] (assoc m k [v])) {} (zipmap [:a :b :c] (mapcat (fn [x] [x x]) (list 1 2)))) {:a :z})" :throws "clojure.lang.Compiler$CompilerException"]
      ["(boolean (distinct [0 -1 7 7]))" :value true]
      ["(contains? (select-keys (select-keys (merge-with max {:a 1, :b 2} {:a 1, :b 2}) [:a :b]) [:a]) :b)" :value false]
      ["(boolean (map-indexed vector (take 3 (cycle (cons 1 (map vector [] [1 1 1]))))))" :value true]
