      ["(let [x (-' (mod 128 7) (apply min 0 [1 2 3])) c (sort (drop-last [3 1 2] 3))] (conj x c))" :throws "java.lang.IllegalArgumentException"]
      ["(not-every? #{1 2} (take 3 (cycle (cons 1 (keys (into (sorted-map) (update-in {} [:a :z] (fnil inc' 0))))))))" :value true]
      ["(long (count (sort-by first (map vector (sort-by first (map vector [3 1 2] (range))) (range)))))" :value 3]
      ["(let [x -128 c (sort > (keys (into (sorted-map) (merge-with +' {:a 1} {}))))] (cons x c))" :value (-128 :a)]]))]
