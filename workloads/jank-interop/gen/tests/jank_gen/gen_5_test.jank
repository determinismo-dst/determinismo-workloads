(deftest g0047
  (let [found (mismatches (quote [
      ["(if (empty? [5 4 4 2 9 0]) (some pos? (map (juxt inc identity) (map max [5 4 4 2 9 0] []))) (merge-with min {:a 1, :x {:y 2}} {:a 1}))" :value {:a 1, :x {:y 2}}]
