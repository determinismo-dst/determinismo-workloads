      ["(let [x (bit-and-not (first (vec (cons 0 (flatten (list [0 1 2 3 4] (list [0 -1 7 7])))))) (*' -128 (get {:a 1, :x {:y 2}} :x -5))) c (mapcat (fn [x] [x x]) [5 4 4 2 9 0])] (cons x c))" :throws "java.lang.ClassCastException"]
