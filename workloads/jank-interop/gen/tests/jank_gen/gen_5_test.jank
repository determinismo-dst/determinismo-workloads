      ["(find {} :b)" :value nil]
      ["(find (group-by even? (vals (into (sorted-map) (zipmap [:a :b :c :d] [127 127 7])))) :x)" :value nil]
      ["(let [x (get (group-by even? (map-indexed vector [1 2 3])) :x -5) c (sort > (vals (into (sorted-map) (zipmap [:a :b :c :d] (dedupe [1 1 1])))))] (conj x c))" :throws "java.lang.IllegalArgumentException"]
      ["(merge-with min (zipmap [:a :b :c] (keep-indexed (fn [i x] (when (even? i) x)) [3 1 2])) {:a 1, :x {:y 2}})" :value {:a 1, :b 2, :x {:y 2}}]
      ["(let [x (long (count [0 1 2 3 4])) c (filter neg? (dedupe (flatten (list [3 1 2] (list [5 4 4 2 9 0])))))] (cons x c))" :value (5)]]))]
    (is (= [] found))))

(deftest g0049
  (let [found (mismatches (quote [
      ["(let [x (rem (second (vec (cons 0 (map (juxt inc -) [1 1 1])))) 1) c (take 5 (cycle (cons 1 (sort-by first (map vector (seq (into (sorted-set) (list 1 2))) (range))))))] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(let [x (quot (second (vec (cons 0 [0 1 2 3 4]))) 2) c (mapcat (fn [x] [x x]) (keep-indexed (fn [i x] (when (even? i) x)) (map-indexed vector [])))] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(select-keys {:a 1, :b 2} [:a :b])" :value {:a 1, :b 2}]
      ["(some #{1 2} [3 1 2])" :value 1]
      ["(clojure.set/select odd? (set []))" :throws "clojure.lang.Compiler$CompilerException"]
      ["(find (merge-with max (group-by pos? (map (comp inc identity) [5 4 4 2 9 0])) (group-by pos? (sort > [5 4 4 2 9 0]))) :x)" :throws "java.lang.ClassCastException"]
      ["(clojure.string/capitalize (str (clojure.string/index-of \"a b\" \"b\")))" :value "2"]
      ["(into #{} (map inc (partition-by identity (keys (into (sorted-map) {:a 1, :b 2})))))" :throws "java.lang.ClassCastException"]
      ["(empty? [0 -1 7 7])" :value false]
      ["(let [x (-' -1 -3) c (keep-indexed (fn [i x] (when (even? i) x)) (map vector (reductions min [0 -1 7 7]) (rest (list 1 2))))] (conj x c))" :throws "java.lang.ClassCastException"]]))]
    (is (= [] found))))
