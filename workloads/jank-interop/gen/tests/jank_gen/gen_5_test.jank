;; SPDX-License-Identifier: MIT
;; Generated by workloads/jank-interop/gen/gen.clj, seed 5: each case's expected
;; outcome is Clojure 1.12's for a random form, so a mismatch on jank is a deviation.
(ns jank-gen.gen-5-test
  (:require [clojure.test :refer [deftest is]]
            [clojure.string]))

(defn- ev
  "The form's value, realized, or [:jank-gen/threw what] for any throw jank's handlers can
   see (an object, a native exception or a jank::error_ref): every form gets its own
   verdict. An object's message only: printing an ex-info makes jank crash as it exits
   (jankifier's S1). A thrown string is its own message: ex-message of one throws in jank
   (jankifier's LU62), which ended the test with no verdict (an overflowing inc throws one)."
  [s]
  (try (let [v (eval (read-string s))] (pr-str v) v)
       (catch cpp/jank.runtime.object_ref e [:jank-gen/threw (if (string? e) e (ex-message e))])
       (catch cpp/std.exception e [:jank-gen/threw (str (.what e))])
       (catch cpp/jank.error_ref e [:jank-gen/threw (str (.-message (cpp/* e)))])))

(defn- threw? [v] (and (vector? v) (= :jank-gen/threw (first v))))

(defn- mismatches
  "The cases jank answers differently from Clojure, as {:i index :jank outcome}: one
   assertion a test, so that its failure (the runner reports a test's first) names them all."
  [cases]
  (vec (remove nil? (map-indexed (fn [i [code kind v]]
                                   (let [got (ev code)
                                         same (try (if (= kind :throws) (threw? got) (= v got))
                                                   (catch cpp/jank.runtime.object_ref _ false))]
                                     (when-not same {:i i :jank got})))
                                 cases))))

(deftest g0000
  (let [found (mismatches (quote [
      ["(some odd? (rest (mapcat (fn [x] [x x]) (vals (into (sorted-map) (zipmap [:a :b :c :d] [3 1 2]))))))" :value true]
      ["(if (seq [5 4 4 2 9 0]) (not-every? even? [5 4 4 2 9 0]) (clojure.set/rename-keys (assoc-in (group-by pos? [1 2 3]) [:x :y] 9223372036854775807) {:a :z}))" :throws "clojure.lang.Compiler$CompilerException"]
      ["(str (clojure.string/includes? \"Ab-C\" \"\"))" :value "true"]
      ["(not-empty (butlast [0 -1 7 7]))" :value (0 -1 7)]
      ["(not-any? odd? (subvec [0 1 2 3 4 5] 1 3))" :value false]
      ["(clojure.set/intersection (clojure.set/intersection (clojure.set/select odd? (set (map-indexed vector [1 1 1]))) (clojure.set/intersection (conj #{:b :a} 1) (conj #{1} 128))) (clojure.set/difference #{} (set [5 4 4 2 9 0])))" :throws "clojure.lang.Compiler$CompilerException"]
      ["(let [x (min (apply min 0 (take 2 (cycle (cons 1 [0 1 2 3 4])))) 0) c (partition-by pos? [3 1 2])] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(if (seq (mapcat (fn [x] [x x]) (sort > (list 1 2)))) (let [x (bit-and (inc' 9223372036854775807) (get {:a 1} :b -5)) c (range -3 6 2)] (cons x c)) (conj #{:b :a} (dec' (apply +' 0 [0 -1 7 7]))))" :throws "java.lang.IllegalArgumentException"]
      ["(not-empty (rest (keep-indexed (fn [i x] (when (even? i) x)) [1 1 1])))" :value (1)]
      ["(split-with (fn [x] (< x 3)) (mapcat (fn [x] [x x]) (map (comp inc dec) [1 2 3])))" :value [(1 1 2 2) (3 3)]]]))]
    (is (= [] found))))

(deftest g0001
  (let [found (mismatches (quote [
      ["(get (assoc-in (update-in (merge-with +' {:a 1, :b 2} {}) [:x :z] (fnil inc' 0)) [:x :y] (reduce max 0 (reductions max (list 1 2)))) :a -5)" :value 1]
      ["(contains? (zipmap [:a :b :c] (list 1 2)) :x)" :value false]
      ["(get (zipmap [:a :b :c] (filter neg? (reverse [0 1 2 3 4]))) :b)" :value nil]
      ["(not-any? even? (map vector [(rem 1 2) (first (vec (cons 0 [5 4 4 2 9 0]))) 9223372036854775807] (vals (into (sorted-map) (zipmap [:a :b :c :d] (map vector (list 1 2) [1 2 3]))))))" :throws "java.lang.IllegalArgumentException"]
      ["(if (empty? (filter odd? (sort-by first (map vector (drop [1 1 1] 3) (range))))) (not-any? pos? (flatten (list (sort compare []) (list (reductions max []))))) (empty? (map (juxt inc dec) (list 1 2))))" :throws "java.lang.IllegalArgumentException"]
      ["(not-any? #{1 2} (keep-indexed (fn [i x] (when (even? i) x)) (sort > [5 4 4 2 9 0])))" :value false]
      ["(zipmap [:a :b :c] (map (comp inc -) (sort > (reductions min [0 -1 7 7]))))" :value {:a 1, :b 2, :c 2}]
      ["(seq (mapcat (fn [x] [x x]) (vals (into (sorted-map) (zipmap [:a :b :c :d] (keys (into (sorted-map) {})))))))" :value nil]
      ["(str (clojure.string/includes? (apply str (interpose \",\" [0 -1 7 7])) \"b\"))" :value "false"]
      ["(seq (flatten (list [3 1 2] (list (vals (into (sorted-map) (zipmap [:a :b :c :d] (seq (into (sorted-set) [1 1 1])))))))))" :value (3 1 2 1)]]))]
    (is (= [] found))))

(deftest g0002
  (let [found (mismatches (quote [
      ["(clojure.set/rename-keys (frequencies (range 2 7 2)) {:a :z})" :throws "clojure.lang.Compiler$CompilerException"]
      ["(group-by pos? (distinct (keys (into (sorted-map) (zipmap [:a :b :c] [3 1 2])))))" :throws "java.lang.ClassCastException"]
      ["(apply str (interpose \",\" (partition-by identity (partition-by pos? [5 4 4 2 9 0]))))" :value "((5 4 4 2 9)),((0))"]
      ["(if (seq (take 5 (cycle (cons 1 (take 0 (cycle (cons 1 (subvec [0 1 2 3 4 5] 0 6)))))))) (let [x (min 127 9223372036854775807) c (reductions min [5 4 4 2 9 0])] (conj x c)) (if (seq [(mod 10 3) 255]) (some even? (interpose 0 [])) (str (clojure.string/starts-with? (str (clojure.string/ends-with? \"\" \"a\")) \"ld\"))))" :throws "java.lang.ClassCastException"]
      ["(contains? (reduce-kv (fn [m k v] (assoc m k [v])) {} {}) :b)" :value false]
      ["(let [x (- (inc' 1)) c (dedupe [1 2 3])] (cons x c))" :value (-2 1 2 3)]
      ["(let [x (get (merge-with max {} (frequencies [0 -1 7 7])) :x -5) c (map min [1 1 1] (keep-indexed (fn [i x] (when (even? i) x)) [0 1 2 3 4]))] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(if (empty? (split-at (fn [x] (< x 3)) (interpose 0 (sort-by first (map vector [1 1 1] (range)))))) (boolean (range -1 6 2)) (not-empty []))" :value nil]
      ["(if (seq [5 4 4 2 9 0]) (let [x (*' 7 (long (count [1 2 3]))) c (split-at 3 (keep-indexed (fn [i x] (when (even? i) x)) [0 1 2 3 4]))] (cons x c)) (seq (sort-by first (map vector (partition-by odd? [1 1 1]) (range)))))" :value (21 (0 2 4) ())]
      ["(get (zipmap [:a :b :c] (keys (into (sorted-map) (assoc-in {:a 1} [:x :y] -128)))) :a)" :value :a]]))]
    (is (= [] found))))

(deftest g0003
  (let [found (mismatches (quote [
      ["(conj (disj (clojure.set/select odd? (set [1 1 1])) 2) (max -1 (+' 255 (reduce +' 0 [0 -1 7 7]))))" :throws "clojure.lang.Compiler$CompilerException"]
      ["(get (reduce-kv (fn [m k v] (assoc m k [v])) {} (merge-with +' (frequencies [5 4 4 2 9 0]) (frequencies (list 1 2)))) :a)" :value nil]
      ["(conj (conj (conj (set [5 4 4 2 9 0]) 7) 255) (max 10 (get (frequencies [0 -1 7 7]) :x -5)))" :value #{0 7 4 2 255 9 5 10}]
      ["(get {:a 1, :x {:y 2}} :x -5)" :value {:y 2}]
      ["(map (comp inc identity) (mapcat (fn [x] [x x]) (filter (some-fn odd? pos?) (flatten (list [1 1 1] (list [3 1 2]))))))" :value (2 2 2 2 2 2 4 4 2 2 3 3)]
      ["(find (clojure.set/rename-keys (update-in {:a 1} [:a :z] (fnil inc' 0)) {:a :z}) :x)" :throws "clojure.lang.Compiler$CompilerException"]
      ["(get (frequencies []) :b)" :value nil]
      ["(boolean [1 1 1])" :value true]
      ["(into #{} (map inc (sort > (sort < (drop-last (list 1 2) 3)))))" :throws "java.lang.IllegalArgumentException"]
      ["(every? #{1 2} (drop-while odd? (keys (into (sorted-map) (group-by pos? [3 1 2])))))" :throws "java.lang.IllegalArgumentException"]]))]
    (is (= [] found))))

