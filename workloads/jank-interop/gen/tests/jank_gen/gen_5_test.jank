      ["(find (reduce-kv (fn [m k v] (assoc m k [v])) {} (frequencies (sort [3 1 2]))) :x)" :value nil]
      ["(disj #{1} 1)" :value #{}]
      ["(frequencies (keep-indexed (fn [i x] (when (even? i) x)) (subvec [0 1 2 3 4 5] 0 5)))" :value {0 1, 2 1, 4 1}]
      ["(find (update-in {} [:x :z] (fnil inc' 0)) :x)" :value [:x {:z 1}]]
      ["(find {:a 1, :x {:y 2}} :x)" :value [:x {:y 2}]]
      ["(group-by pos? (map-indexed vector (flatten (list (vals (into (sorted-map) (zipmap [:a :b :c :d] [0 -1 7 7]))) (list [1 1 1])))))" :throws "java.lang.ClassCastException"]
      ["(not-every? pos? [])" :value false]
