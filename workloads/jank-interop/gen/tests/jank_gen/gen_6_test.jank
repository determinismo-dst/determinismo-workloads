      ["(let [x (+' (get {:a 1, :x {:y 2}} :b -5) 3) c (keep-indexed (fn [i x] (when (even? i) x)) (split-with (fn [x] (< x 3)) [1 1 1]))] (conj x c))" :throws "java.lang.ClassCastException"]]))]
    (is (= [] found))))

(deftest g0046
  (let [found (mismatches (quote [
      ["(let [x 7 c (keys (into (sorted-map) {:a 1, :b 2}))] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(let [x (first (vec (cons 0 (partition-by odd? [0 -1 7 7])))) c (seq (into (sorted-set) [3 1 2]))] (cons x c))" :value (0 1 2 3)]
      ["(into #{} (map inc [3 1 2]))" :value #{4 3 2}]
      ["(not-empty (take-while odd? [1 2 3]))" :value (1)]
      ["(if (seq (range -1 4 3)) (boolean (list 1 2)) (subs \"hello world\" 2 3))" :value true]
      ["(let [x -128 c (list 1 2)] (cons x c))" :value (-128 1 2)]
      ["(vals (into (sorted-map) (zipmap [:a :b :c :d] (keep-indexed (fn [i x] (when (even? i) x)) [0 -1 7 7]))))" :value (0 7)]
      ["(reductions max (subvec [0 1 2 3 4 5] 1 4))" :value (1 2 3)]
      ["(contains? (zipmap [:a :b :c] [1 1 1]) :a)" :value true]
      ["(str (- 128) \"-\" (str 255 \"\" (clojure.string/replace (apply str (interpose \",\" [])) \"l\" \"\")))" :value "-128-255"]]))]
    (is (= [] found))))

(deftest g0047
  (let [found (mismatches (quote [
      ["(not-any? pos? (split-with 3 (split-at (fn [x] (< x 3)) (partition 3 1 [3 1 2]))))" :throws "java.lang.ClassCastException"]
      ["(let [x 9223372036854775807 c (partition-by identity (map max (map vector [0 1 2 3 4] [1 1 1]) (range 1 8 3)))] (cons x c))" :throws "java.lang.ClassCastException"]
      ["(empty? [1 1 1])" :value false]
      ["(zipmap [:a :b :c] (nthnext [3 1 2] 1))" :value {:a 1, :b 2}]
      ["(map-indexed vector (keep-indexed (fn [i x] (when (even? i) x)) (sort-by first (map vector (reductions min [3 1 2]) (range)))))" :value ([0 [1 1]] [1 [3 0]])]
      ["(clojure.set/union (set (reductions min (range 1 5 2))) (into #{} (map inc (subvec [0 1 2 3 4 5] 1 4))))" :throws "clojure.lang.Compiler$CompilerException"]
      ["(not-empty [0 -1 7 7])" :value [0 -1 7 7]]
      ["(clojure.set/rename-keys (reduce-kv (fn [m k v] (assoc m k [v])) {} (update-in {:a 1, :b 2} [:a :z] (fnil inc' 0))) {:a :z})" :throws "clojure.lang.Compiler$CompilerException"]
      ["(boolean [3 1 2])" :value true]
      ["(find (update-in {:a 1, :x {:y 2}} [:x :z] (fnil inc' 0)) :b)" :value nil]]))]
    (is (= [] found))))

(deftest g0048
  (let [found (mismatches (quote [
      ["(find (assoc-in {} [:x :y] (max 2 (long (count [1 1 1])))) :b)" :value nil]
      ["(get (assoc-in {:a 1, :x {:y 2}} [:x :y] (dec' (get {:a 1, :b 2} :x -5))) :x)" :value {:y -6}]
      ["(split-with (fn [x] (< x 3)) (take-while neg? (range -3 5 3)))" :value [(-3) ()]]
      ["(interpose 0 [0 -1 7 7])" :value (0 0 -1 0 7 0 7)]
      ["(sort-by first (map vector (interpose 0 (filter (some-fn odd? pos?) (keep-indexed (fn [i x] (when (even? i) x)) [5 4 4 2 9 0]))) (range)))" :value ([0 1] [0 3] [4 2] [5 0] [9 4])]
      ["(get (clojure.set/rename-keys {:a 1, :x {:y 2}} {:a :z}) :a)" :throws "clojure.lang.Compiler$CompilerException"]
      ["(let [x 255 c (partition-all 1 2 (drop-while odd? [5 4 4 2 9 0]))] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(reductions min (take 2 (cycle (cons 1 (drop-while odd? [1 1 1])))))" :value (1 1)]
      ["(if (seq (drop-while pos? (reverse []))) {:a 1, :x {:y 2}} (not-every? odd? (vals (into (sorted-map) (zipmap [:a :b :c :d] (vals (into (sorted-map) (zipmap [:a :b :c :d] []))))))))" :value false]
      ["(group-by pos? (filter (some-fn odd? pos?) (take 2 (cycle (cons 1 (distinct [1 2 3]))))))" :value {true [1 1]}]]))]
    (is (= [] found))))

(deftest g0049
  (let [found (mismatches (quote [
      ["(map min (keep-indexed (fn [i x] (when (even? i) x)) [0 1 2 3 4]) [1 2 3])" :value (0 2 3)]
      ["(str (clojure.string/ends-with? (str 255 \"\" (clojure.string/join \",\" (split-with 3 [0 1 2 3 4]))) \"b\"))" :throws "java.lang.ClassCastException"]
      ["(let [x (reduce min 0 (sort-by first (map vector [1 1 1] (range)))) c (reverse (subvec [0 1 2 3 4 5] 0 6))] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(not-any? pos? (keys (into (sorted-map) (update (select-keys {} [:a :b]) :b (fnil inc' 0)))))" :throws "java.lang.ClassCastException"]
      ["(every? odd? (map-indexed vector (take 1 (cycle (cons 1 (keep-indexed (fn [i x] (when (even? i) x)) [5 4 4 2 9 0]))))))" :throws "java.lang.IllegalArgumentException"]
      ["(not-any? odd? (vals (into (sorted-map) (zipmap [:a :b :c :d] (partition-all 3 1 (map + [1 1 1] []))))))" :value true]
      ["(clojure.string/replace \"x,y,z\" \"a\" \"--\")" :value "x,y,z"]
      ["(let [x (bit-shift-right (max-key identity 7 -1 (apply +' 0 (list 1 2))) 62) c (range -3 6 3)] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(let [x 3 c (vals (into (sorted-map) (zipmap [:a :b :c :d] (sort-by first (map vector [3 1 2] (range))))))] (cons x c))" :value (3 [1 1] [2 2] [3 0])]
      ["(let [x -128 c (vals (into (sorted-map) (zipmap [:a :b :c :d] (take 0 (cycle (cons 1 [0 1 2 3 4]))))))] (cons x c))" :value (-128)]]))]
    (is (= [] found))))
