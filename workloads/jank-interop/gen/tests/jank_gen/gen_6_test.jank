;; SPDX-License-Identifier: MIT
;; Generated by workloads/jank-interop/gen/gen.clj, seed 6: each case's expected
;; outcome is Clojure 1.12's for a random form, so a mismatch on jank is a deviation.
(ns jank-gen.gen-6-test
  (:require [clojure.test :refer [deftest is]]
            [clojure.string]))

(defn- ev
  "The form's value, realized, or [:jank-gen/threw what] for any throw jank's handlers can
   see (an object, a native exception or a jank::error_ref): every form gets its own
   verdict. An object's message only: printing an ex-info makes jank crash as it exits
   (jankifier's S1). A thrown string is its own message: ex-message of one throws in jank
   (jankifier's LU62), which ended the test with no verdict (an overflowing inc throws one)."
  [s]
  (try (let [v (eval (read-string s))] (pr-str v) v)
       (catch cpp/jank.runtime.object_ref e [:jank-gen/threw (if (string? e) e (ex-message e))])
       (catch cpp/std.exception e [:jank-gen/threw (str (.what e))])
       (catch cpp/jank.error_ref e [:jank-gen/threw (str (.-message (cpp/* e)))])))

(defn- threw? [v] (and (vector? v) (= :jank-gen/threw (first v))))

(defn- mismatches
  "The cases jank answers differently from Clojure, as {:i index :jank outcome}: one
   assertion a test, so that its failure (the runner reports a test's first) names them all."
  [cases]
  (vec (remove nil? (map-indexed (fn [i [code kind v]]
                                   (let [got (ev code)
                                         same (try (if (= kind :throws) (threw? got) (= v got))
                                                   (catch cpp/jank.runtime.object_ref _ false))]
                                     (when-not same {:i i :jank got})))
                                 cases))))

(deftest g0000
  (let [found (mismatches (quote [
      ["(sort-by first (map vector (map (juxt inc -) (keys (into (sorted-map) (reduce-kv (fn [m k v] (assoc m k [v])) {} {})))) (range)))" :value ()]
      ["(disj (set (sort-by first (map vector (drop [0 -1 7 7] 2) (range)))) 1)" :throws "java.lang.IllegalArgumentException"]
      ["(clojure.set/select odd? (set [1 1 1]))" :throws "clojure.lang.Compiler$CompilerException"]
      ["(boolean (map max (interpose 0 (sort > [3 1 2])) (take 5 (cycle (cons 1 (partition-by odd? [1 2 3]))))))" :value true]
      ["(let [x (bit-xor (get (assoc-in {:a 1, :b 2} [:x :y] -3) :b -5) -128) c [5 4 4 2 9 0]] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(contains? (update (group-by pos? (map min [0 1 2 3 4] [1 2 3])) :a (fnil inc' 0)) :x)" :value false]
      ["(let [x (bit-set 7 48) c (reductions max (map-indexed vector [1 2 3]))] (cons x c))" :throws "java.lang.ClassCastException"]
      ["(let [x 3 c (range -1 3 3)] (cons x c))" :value (3 -1 2)]
      ["(into #{} (map inc [3 1 2]))" :value #{4 3 2}]
      ["(reduce max 0 (sort-by first (map vector (seq (into (sorted-set) (sort-by first (map vector [1 2 3] (range))))) (range))))" :throws "java.lang.ClassCastException"]]))]
    (is (= [] found))))

(deftest g0001
  (let [found (mismatches (quote [
      ["(every? pos? (seq (into (sorted-set) (reductions min [3 1 2]))))" :value true]
      ["(let [x (bit-xor (reduce min 0 (keys (into (sorted-map) {:a 1, :x {:y 2}}))) -128) c [1 2 3]] (cons x c))" :throws "java.lang.ClassCastException"]
      ["(assoc-in (update-in {:a 1, :b 2} [:a :z] (fnil inc' 0)) [:x :y] 3)" :throws "java.lang.ClassCastException"]
      ["(if (empty? (subvec [0 1 2 3 4 5] 2 3)) (let [x (long (count (sort (list 1 2)))) c (seq (into (sorted-set) [0 -1 7 7]))] (conj x c)) -1)" :value -1]
      ["(clojure.string/join \"-\" (flatten (list [0 -1 7 7] (list []))))" :value "0--1-7-7"]
      ["(not-every? even? (map vector (reductions min (filter (some-fn odd? pos?) [1 1 1])) (map (juxt inc identity) (map + [0 1 2 3 4] [1 2 3]))))" :throws "java.lang.IllegalArgumentException"]
      ["(get {:a 1, :x {:y 2}} :x -5)" :value {:y 2}]
      ["(empty? (nthnext (mapcat (fn [x] [x x]) [3 1 2]) 3))" :value false]
      ["(get {} :b)" :value nil]
      ["(clojure.set/select odd? (set (seq (into (sorted-set) (map vector (map + [1 2 3] [0 -1 7 7]) (partition 2 2 (list 1 2)))))))" :throws "clojure.lang.Compiler$CompilerException"]]))]
    (is (= [] found))))

(deftest g0002
  (let [found (mismatches (quote [
      ["(if (empty? (partition-by pos? (seq (into (sorted-set) (vals (into (sorted-map) (zipmap [:a :b :c :d] [0 1 2 3 4]))))))) (not-empty (map-indexed vector (mapcat (fn [x] [x x]) [1 2 3]))) (not-any? pos? [3 1 2]))" :value false]
      ["(not-every? #{1 2} (list 1 2))" :value false]
      ["(not-empty (map (juxt inc -) (split-with (fn [x] (< x 3)) (remove even? [5 4 4 2 9 0]))))" :throws "java.lang.ClassCastException"]
      ["(let [x 10 c [0 -1 7 7]] (cons x c))" :value (10 0 -1 7 7)]
      ["(let [x 10 c [3 1 2]] (cons x c))" :value (10 3 1 2)]
      ["(if (seq (partition-by pos? (partition 1 1 (sort compare [1 2 3])))) (empty? (partition 1 2 (take 3 (cycle (cons 1 [1 1 1]))))) (contains? (group-by even? (vals (into (sorted-map) (zipmap [:a :b :c :d] [0 1 2 3 4])))) :a))" :throws "java.lang.ClassCastException"]
      ["(every? even? [0 1 2 3 4])" :value false]
      ["(every? odd? [1 1 1])" :value true]
      ["(sort < (interpose 0 (reductions min (map-indexed vector [3 1 2]))))" :throws "java.lang.ClassCastException"]
      ["(clojure.set/select odd? (set (map (comp inc dec) (map-indexed vector (reductions +' [0 1 2 3 4])))))" :throws "clojure.lang.Compiler$CompilerException"]]))]
    (is (= [] found))))

(deftest g0003
  (let [found (mismatches (quote [
      ["(find (clojure.set/rename-keys (clojure.set/rename-keys (zipmap [:a :b :c] []) {:a :z}) {:a :z}) :a)" :throws "clojure.lang.Compiler$CompilerException"]
      ["(assoc-in (assoc-in (select-keys {} [:a]) [:x :y] 7) [:x :y] 2)" :value {:x {:y 2}}]
      ["(apply str (interpose \",\" [5 4 4 2 9 0]))" :value "5,4,4,2,9,0"]
      ["(let [x (bit-or (dec' (*' 2 10)) (bit-or 0 (rem 1 7))) c (keep-indexed (fn [i x] (when (even? i) x)) (vals (into (sorted-map) (zipmap [:a :b :c :d] (nthrest [0 1 2 3 4] 0)))))] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(clojure.string/join \"|\" (clojure.string/split \"x,y,z\" #\"b\"))" :value "x,y,z"]
      ["(find (update (clojure.set/rename-keys {:a 1, :b 2} {:a :z}) :a (fnil inc' 0)) :b)" :throws "clojure.lang.Compiler$CompilerException"]
      ["(let [x (quot (min-key identity (max -128 128) (reduce max 0 []) (bit-xor 255 1000)) 3) c (sort > [3 1 2])] (cons x c))" :value (0 3 2 1)]
      ["(assoc-in (assoc-in (frequencies [1 2 3]) [:x :y] (apply min 0 (keep-indexed (fn [i x] (when (even? i) x)) [1 1 1]))) [:x :y] -1)" :value {1 1, 2 1, 3 1, :x {:y -1}}]
      ["(boolean (seq (into (sorted-set) (partition-all 3 1 (partition-by pos? [1 2 3])))))" :throws "java.lang.ClassCastException"]
      ["(not-empty (flatten (list [0 1 2 3 4] (list (vals (into (sorted-map) (zipmap [:a :b :c :d] (keys (into (sorted-map) {:a 1, :x {:y 2}})))))))))" :value (0 1 2 3 4 :a :x)]]))]
    (is (= [] found))))

(deftest g0004
  (let [found (mismatches (quote [
      ["(str (clojure.string/last-index-of (clojure.string/replace (str (clojure.string/includes? (str (clojure.string/index-of \"abc\" \"a\")) \"\")) \"l\" \"\") \"a\"))" :value ""]
      ["(let [x (long (count [1 2 3])) c (flatten (list (mapcat (fn [x] [x x]) (mapcat (fn [x] [x x]) [5 4 4 2 9 0])) (list (flatten (list (map + (list 1 2) [0 1 2 3 4]) (list (list 1 2)))))))] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(split-at 3 (vals (into (sorted-map) (zipmap [:a :b :c :d] (map-indexed vector (flatten (list [3 1 2] (list [3 1 2]))))))))" :value [([0 3] [1 1] [2 2]) ([3 3])]]
      ["(contains? (reduce-kv (fn [m k v] (assoc m k [v])) {} (assoc-in (frequencies (list 1 2)) [:x :y] 10)) :b)" :value false]
      ["(str (bit-shift-left -3 5) \"-\" (clojure.string/replace (str -3 \"\" (apply str (interpose \",\" [3 1 2]))) \" \" \"X\"))" :value "-96--33,1,2"]
      ["(seq (into (sorted-set) [(max (apply max 0 (list 1 2)) -1) (reduce min 0 [])]))" :value (0 2)]
      ["(clojure.string/join \"|\" (clojure.string/split (subs \"abcdef\" 1 4) #\" \"))" :value "bcd"]
      ["(contains? (update-in (group-by pos? [5 4 4 2 9 0]) [:x :z] (fnil inc' 0)) :b)" :value false]
      ["(if (empty? (sort < [0 -1 7 7])) (let [x (bit-and (unsigned-bit-shift-right -1 42) (first (vec (cons 0 [1 1 1])))) c [0 1 2 3 4]] (conj x c)) (if (empty? [1 2 3]) (clojure.set/rename-keys (zipmap [:a :b :c] [3 1 2]) {:a :z}) (list 1 2)))" :throws "clojure.lang.Compiler$CompilerException"]
      ["(flatten (list (map (juxt inc -) [1 1 1]) (list (distinct (partition-all 3 1 [0 -1 7 7])))))" :value (2 -1 2 -1 2 -1 0 -1 7 -1 7 7 7 7 7)]]))]
    (is (= [] found))))

(deftest g0005
  (let [found (mismatches (quote [
      ["(list 1 2)" :value (1 2)]
      ["(not-any? even? (flatten (list (keep-indexed (fn [i x] (when (even? i) x)) (subvec [0 1 2 3 4 5] 2 6)) (list [5 4 4 2 9 0]))))" :value false]
      ["(not-empty (partition-by pos? [1 1 1]))" :value ((1 1 1))]
      ["(get (update {:a 1, :x {:y 2}} :a (fnil inc' 0)) :x)" :value {:y 2}]
      ["(clojure.string/join \",\" (vals (into (sorted-map) (zipmap [:a :b :c :d] (split-with 2 (map (comp inc identity) []))))))" :value "clojure.lang.LazySeq@1,clojure.lang.LazySeq@1"]
      ["(let [x (reduce max 0 (drop-while neg? (take 3 (cycle (cons 1 [1 1 1]))))) c (keys (into (sorted-map) (frequencies (filter (some-fn odd? pos?) []))))] (cons x c))" :value (1)]
      ["(take 0 (cycle (cons 1 (drop-while neg? (distinct (subvec [0 1 2 3 4 5] 0 3))))))" :value ()]
      ["(not-every? pos? [])" :value false]
      ["(every? odd? (mapcat (fn [x] [x x]) [5 4 4 2 9 0]))" :value false]
      ["(str (clojure.string/last-index-of \"a\" \"b\"))" :value ""]]))]
    (is (= [] found))))

(deftest g0006
  (let [found (mismatches (quote [
      ["(clojure.string/join \"|\" (clojure.string/split (clojure.string/join \"\" (map (juxt inc identity) [])) #\" \"))" :value ""]
      ["(nthnext (flatten (list (keys (into (sorted-map) (frequencies []))) (list (range 0 5 3)))) 1)" :value (0 3)]
      ["(flatten (list [5 4 4 2 9 0] (list (map vector (reductions max (range -2 7 1)) (map vector (mapcat (fn [x] [x x]) [1 1 1]) [1 1 1])))))" :value (5 4 4 2 9 0 -2 1 1 -1 1 1 0 1 1)]
      ["(not-any? odd? [0 -1 7 7])" :value false]
      ["(conj (clojure.set/difference (into #{} (map inc (reductions max [5 4 4 2 9 0]))) (clojure.set/select odd? (set [0 1 2 3 4]))) 9223372036854775807)" :throws "clojure.lang.Compiler$CompilerException"]
      ["(contains? (frequencies (sort < (flatten (list [0 1 2 3 4] (list (list 1 2)))))) :b)" :value false]
      ["(not-every? pos? (sort-by first (map vector (range -3 5 1) (range))))" :throws "java.lang.ClassCastException"]
      ["(partition-all 1 2 (subvec [0 1 2 3 4 5] 1 4))" :value ((1) (3))]
      ["(update-in (group-by odd? (filter (some-fn odd? pos?) (filter (every-pred odd? pos?) []))) [:a :z] (fnil inc' 0))" :value {:a {:z 1}}]
      ["(some #{1 2} (rest (flatten (list (subvec [0 1 2 3 4 5] 0 4) (list (list 1 2))))))" :value 1]]))]
    (is (= [] found))))

(deftest g0007
  (let [found (mismatches (quote [
      ["(conj #{} 7)" :value #{7}]
      ["(every? pos? (vals (into (sorted-map) (zipmap [:a :b :c :d] [1 1 1]))))" :value true]
      ["(some even? (keys (into (sorted-map) (assoc-in {:a 1, :b 2} [:x :y] (peek (vec (cons 0 [3 1 2])))))))" :throws "java.lang.IllegalArgumentException"]
      ["(str (long (count (keep-indexed (fn [i x] (when (even? i) x)) [1000 -1 -3]))) \"\" (str (clojure.string/index-of (apply str (interpose \",\" [5 4 4 2 9 0])) \"l\")))" :value "2"]
      ["(get (clojure.set/rename-keys (clojure.set/rename-keys (reduce-kv (fn [m k v] (assoc m k [v])) {} {:a 1}) {:a :z}) {:a :z}) :a)" :throws "clojure.lang.Compiler$CompilerException"]
      ["(empty? (take 1 (cycle (cons 1 [1 2 3]))))" :value false]
      ["(group-by even? (reductions min [3 1 2]))" :value {false [3 1 1]}]
      ["(get {:a 1, :x {:y 2}} :b)" :value nil]
      ["(get (assoc-in (zipmap [:a :b :c] [0 1 2 3 4]) [:x :y] 3) :a)" :value 0]
      ["(str 127 \"\" \"abc\")" :value "127abc"]]))]
    (is (= [] found))))

(deftest g0008
  (let [found (mismatches (quote [
      ["(conj (disj (set (reductions min [3 1 2])) 2) (max (-' 9223372036854775807 (long (count [0 1 2 3 4]))) (reduce +' 0 (list 1 2))))" :value #{1 9223372036854775802 3}]
      ["(reduce max 0 (map (juxt inc -) (keys (into (sorted-map) {}))))" :value 0]
      ["(boolean (drop (map + [-1 127] (map vector [3 1 2] [0 1 2 3 4])) 1))" :value true]
      ["(bit-shift-right 3 10)" :value 0]
      ["(into #{} (map inc (mapcat (fn [x] [x x]) (reductions +' (reductions min [5 4 4 2 9 0])))))" :value #{6 14 16 10 18}]
      ["(map max (sort-by first (map vector (map (comp inc -) (range 0 5 -1)) (range))) (rest (filter odd? (map-indexed vector [0 1 2 3 4]))))" :throws "java.lang.IllegalArgumentException"]
      ["(get (zipmap [:a :b :c] [1 2 3]) :a)" :value 1]
      ["(first (vec (cons 0 [0 -1 7 7])))" :value 0]
      ["(let [x 1000 c (take 2 (cycle (cons 1 (map (juxt inc identity) (flatten (list [3 1 2] (list [0 -1 7 7])))))))] (cons x c))" :value (1000 1 [4 3])]
      ["(let [x (rem (long (count [3 1 2])) 3) c [0 1 2 3 4]] (cons x c))" :value (0 0 1 2 3 4)]]))]
    (is (= [] found))))

(deftest g0009
  (let [found (mismatches (quote [
      ["(not-every? pos? (mapcat (fn [x] [x x]) (keys (into (sorted-map) (assoc-in {} [:x :y] 0)))))" :throws "java.lang.ClassCastException"]
      ["(clojure.set/select odd? (set (map (juxt inc dec) (filter (every-pred odd? pos?) (list 1 2)))))" :throws "clojure.lang.Compiler$CompilerException"]
      ["(subs \"abcdef\" 2 5)" :value "cde"]
      ["(seq (filter (every-pred odd? pos?) (vals (into (sorted-map) (zipmap [:a :b :c :d] [3])))))" :value (3)]
      ["(not-any? odd? (partition 1 2 (filter pos? [1 2 3])))" :throws "java.lang.IllegalArgumentException"]
      ["(map vector (nthnext (subvec [0 1 2 3 4 5] 0 5) 0) (take 4 (cycle (cons 1 (subvec [0 1 2 3 4 5] 2 5)))))" :value ([0 1] [1 2] [2 3] [3 4])]
      ["(clojure.set/intersection (clojure.set/intersection (set (range 0 6 3)) (into #{} (map inc (keep-indexed (fn [i x] (when (even? i) x)) [1 1 1])))) #{1 3 2})" :throws "clojure.lang.Compiler$CompilerException"]
      ["(clojure.string/join \"-\" (split-at (fn [x] (< x 3)) (filter (every-pred odd? pos?) (map vector [3 1 2] []))))" :throws "java.lang.ClassCastException"]
      ["(if (empty? (map (comp inc identity) [])) (get {:a 1, :b 2} :x) (empty? (sort-by first (map vector (remove odd? [1 2 3]) (range)))))" :value nil]
      ["(apply str (interpose \",\" [0 -1 7 7]))" :value "0,-1,7,7"]]))]
    (is (= [] found))))

(deftest g0010
  (let [found (mismatches (quote [
      ["(some odd? (drop-last (keys (into (sorted-map) {})) 3))" :throws "java.lang.IllegalArgumentException"]
      ["(split-with (fn [x] (< x 3)) (map vector (drop-last (map (juxt inc identity) [1 2 3]) 2) (subvec [0 1 2 3 4 5] 2 4)))" :throws "java.lang.IllegalArgumentException"]
      ["(reductions +' (partition 3 1 (partition-by identity (keep-indexed (fn [i x] (when (even? i) x)) [3 1 2]))))" :value (0)]
      ["(clojure.set/rename-keys (update {:a 1} :b (fnil inc' 0)) {:a :z})" :throws "clojure.lang.Compiler$CompilerException"]
      ["(some odd? (nthnext (keys (into (sorted-map) (clojure.set/rename-keys {} {:a :z}))) 1))" :throws "clojure.lang.Compiler$CompilerException"]
      ["(empty? (partition 3 2 (map min [3 1 2] (partition-by pos? [5 4 4 2 9 0]))))" :throws "java.lang.ClassCastException"]
      ["(seq (into (sorted-set) (vals (into (sorted-map) (zipmap [:a :b :c :d] [(apply min 0 [3 1 2]) 1 (bit-clear 10 59)])))))" :value (0 1 10)]
      ["(clojure.set/intersection #{} (clojure.set/select odd? (set (take-while pos? (map-indexed vector [])))))" :throws "clojure.lang.Compiler$CompilerException"]
      ["(get (assoc-in (update (merge-with min {:a 1} {:a 1, :x {:y 2}}) :a (fnil inc' 0)) [:x :y] (first (vec (cons 0 [])))) :x)" :value {:y 0}]
      ["(every? #{1 2} (vals (into (sorted-map) (zipmap [:a :b :c :d] [5 4 4 2 9 0]))))" :value false]]))]
    (is (= [] found))))

(deftest g0011
  (let [found (mismatches (quote [
      ["(- (first (vec (cons 0 (sort < (range -1 3 1))))))" :value 0]
      ["(not-any? even? (keys (into (sorted-map) (group-by pos? [1 1 1]))))" :throws "java.lang.IllegalArgumentException"]
      ["(if (seq (nthrest (subvec [0 1 2 3 4 5] 0 4) 1)) (contains? (select-keys (group-by pos? (list 1 2)) []) :x) (let [x 128 c [0 -1 7 7]] (conj x c)))" :value false]
      ["(boolean (mapcat (fn [x] [x x]) (vals (into (sorted-map) (zipmap [:a :b :c :d] (take 5 (cycle (cons 1 (list 1 2)))))))))" :value true]
      ["(clojure.set/select odd? (set [0 -1 7 7]))" :throws "clojure.lang.Compiler$CompilerException"]
      ["(partition-by pos? (mapcat (fn [x] [x x]) [1 2 3]))" :value ((1 1 2 2 3 3))]
      ["(keys (into (sorted-map) (reduce-kv (fn [m k v] (assoc m k [v])) {} (assoc-in (group-by odd? [1 1 1]) [:x :y] (-' 1 -1)))))" :throws "java.lang.ClassCastException"]
      ["(contains? {:a 1, :b 2} :a)" :value true]
      ["(contains? (assoc-in {:a 1, :x {:y 2}} [:x :y] (*' (*' 1 0) 1)) :a)" :value true]
      ["(every? even? (map vector (interpose 0 (partition 2 2 [3 1 2])) (sort < (range -2 6 2))))" :throws "java.lang.IllegalArgumentException"]]))]
    (is (= [] found))))

(deftest g0012
  (let [found (mismatches (quote [
      ["(quot 1000 2)" :value 500]
      ["(if (seq (seq (into (sorted-set) (filter (some-fn odd? pos?) (mapcat (fn [x] [x x]) [0 1 2 3 4]))))) (let [x (long (count (keep-indexed (fn [i x] (when (even? i) x)) [5 4 4 2 9 0]))) c (nthrest (keys (into (sorted-map) {:a 1})) 3)] (conj x c)) (- (get (update-in {:a 1, :b 2} [:a :z] (fnil inc' 0)) :a -5)))" :throws "java.lang.ClassCastException"]
      ["(clojure.string/replace \"abc\" \" \" \"\")" :value "abc"]
      ["(boolean [5 4 4 2 9 0])" :value true]
      ["(not-empty [5 4 4 2 9 0])" :value [5 4 4 2 9 0]]
      ["(if (seq []) {:a 1, :b 2} (boolean [0 -1 7 7]))" :value true]
      ["(every? even? (keep-indexed (fn [i x] (when (even? i) x)) (mapcat (fn [x] [x x]) (take 4 (cycle (cons 1 [1 2 3]))))))" :value false]
      ["(set [1 1 1])" :value #{1}]
      ["(subs \"abcdef\" 2 5)" :value "cde"]
      ["(let [x 127 c (subvec [0 1 2 3 4 5] 0 6)] (conj x c))" :throws "java.lang.ClassCastException"]]))]
    (is (= [] found))))

(deftest g0013
  (let [found (mismatches (quote [
      ["(boolean (map-indexed vector (split-at 0 [0 -1 7 7])))" :value true]
      ["(assoc-in (select-keys (group-by even? (take 6 (cycle (cons 1 (list 1 2))))) [:a]) [:x :y] (bit-xor (long (count (list 1 2))) (reduce min 0 (filter (every-pred odd? pos?) [0 -1 7 7]))))" :value {:x {:y 2}}]
      ["(let [x (bit-set 128 40) c (vals (into (sorted-map) (zipmap [:a :b :c :d] (map + (map (juxt inc identity) [1 1 1]) (list 1 2)))))] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(clojure.set/select odd? (set (rest (keep-indexed (fn [i x] (when (even? i) x)) (sort [3 1 2])))))" :throws "clojure.lang.Compiler$CompilerException"]
      ["(if (seq (take 3 (cycle (cons 1 (remove pos? (keep-indexed (fn [i x] (when (even? i) x)) (list 1 2))))))) (long (count (filter (every-pred odd? pos?) (vals (into (sorted-map) (zipmap [:a :b :c :d] [1 1 1])))))) (contains? {:a 1, :b 2} :x))" :value 3]
      ["(not-empty [(long (count (map (comp inc dec) [0 -1 7 7]))) 2])" :value [4 2]]
      ["(str (reduce min 0 (mapcat (fn [x] [x x]) (map-indexed vector []))) \":\" (clojure.string/upper-case (clojure.string/replace (clojure.string/join \"\" [3 1 2]) \"l\" \"--\")))" :value "0:312"]
      ["(pr-str (clojure.string/blank? (clojure.string/trimr (clojure.string/replace (subs \"hello world\" 0 3) \"b\" \"\"))))" :value "false"]
      ["(not-any? #{1 2} (list 1 2))" :value false]
      ["(clojure.string/capitalize (clojure.string/join \",\" (take 0 (cycle (cons 1 (sort-by first (map vector [0 1 2 3 4] (range))))))))" :value ""]]))]
