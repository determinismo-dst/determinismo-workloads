  (let [found (mismatches (quote [
      ["(some pos? [128 0 1])" :value true]
      ["(find (frequencies (sort-by first (map vector (map (juxt inc dec) (list 1 2)) (range)))) :a)" :value nil]
      ["(let [x 2 c (reductions min (map (comp inc -) []))] (cons x c))" :throws "clojure.lang.ArityException"]
      ["(merge-with +' (reduce-kv (fn [m k v] (assoc m k [v])) {} (group-by even? (keys (into (sorted-map) {:a 1, :x {:y 2}})))) (assoc-in (zipmap [:a :b :c] (list 1 2)) [:x :y] 7))" :throws "java.lang.IllegalArgumentException"]
      ["(find (merge-with max (update (select-keys {} [:a]) :b (fnil inc' 0)) {:a 1, :x {:y 2}}) :a)" :value [:a 1]]
      ["(let [x -1 c (sort-by first (map vector (vals (into (sorted-map) (zipmap [:a :b :c :d] []))) (range)))] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(clojure.string/replace \"a\" \"a\" \"\")" :value ""]
      ["(let [x (min (-' (long (count [0 1 2 3 4])) 255) 3) c (take 2 (cycle (cons 1 (sort-by first (map vector (flatten (list [3 1 2] (list [0 1 2 3 4]))) (range))))))] (cons x c))" :value (-250 1 [0 3])]
      ["(every? #{1 2} (remove even? (flatten (list (keep-indexed (fn [i x] (when (even? i) x)) [1 1 1]) (list (take 1 (cycle (cons 1 [0 1 2 3 4]))))))))" :value true]
      ["(not-any? even? (filter (every-pred odd? pos?) (flatten (list (reductions min [1 1 1]) (list (nthnext [3 1 2] 1))))))" :value true]]))]
    (is (= [] found))))

(deftest g0048
  (let [found (mismatches (quote [
      ["(conj (into #{} (map inc (split-with (fn [x] (< x 3)) (interpose 0 [1 1 1])))) 1000)" :throws "java.lang.ClassCastException"]
      ["(if (seq [0 -1 7 7]) {:a 1, :b 2} (str (clojure.string/starts-with? (str (clojure.string/starts-with? (subs \"hello world\" 0 3) \"b\")) \"ld\")))" :value {:a 1, :b 2}]
      ["(into #{} (map inc (partition 2 1 [5 4 4 2 9 0])))" :throws "java.lang.ClassCastException"]
      ["(if (seq (vals (into (sorted-map) (zipmap [:a :b :c :d] [])))) (apply str (interpose \",\" [3 1 2])) (zipmap [:a :b :c] (list 1 2)))" :value {:a 1, :b 2}]
      ["(boolean [])" :value true]
      ["(map vector (seq (into (sorted-set) [1 1 1])) (split-at (fn [x] (< x 3)) (reductions min (seq (into (sorted-set) [3 1 2])))))" :throws "java.lang.ClassCastException"]
      ["(pr-str (clojure.string/blank? (subs \"abcdef\" 1 5)))" :value "false"]
      ["(update (reduce-kv (fn [m k v] (assoc m k [v])) {} (merge-with max {} {:a 1, :x {:y 2}})) :b (fnil inc' 0))" :value {:a [1], :x [{:y 2}], :b 1}]
      ["(not-any? even? (flatten (list (keys (into (sorted-map) {})) (list (map min (filter (every-pred odd? pos?) [0 -1 7 7]) [3 1 2])))))" :throws "java.lang.IllegalArgumentException"]
      ["(let [x (rem 255 -2) c (interpose 0 (sort < (filter (some-fn odd? pos?) (list 1 2))))] (conj x c))" :throws "java.lang.ClassCastException"]]))]
    (is (= [] found))))

(deftest g0049
  (let [found (mismatches (quote [
      ["(set (partition-by odd? (list 1 2)))" :value #{(2) (1)}]
      ["(seq (seq (into (sorted-set) (nthnext [5 4 4 2 9 0] 1))))" :value (0 2 4 9)]
      ["(some even? [0 -1 7 7])" :value true]
      ["(pr-str (clojure.string/split-lines (apply str (interpose \",\" []))))" :value "[\"\"]"]
      ["(if (seq [1 2 3]) (let [x -128 c (map (comp inc identity) (partition 3 1 []))] (conj x c)) (every? pos? (map (comp inc dec) [0 -1 7 7])))" :throws "java.lang.ClassCastException"]
      ["(if (empty? [0 1 2 3 4]) (if (seq (range 2 7 -1)) [5 4 4 2 9 0] (disj (disj #{} 2) :a)) (mapcat (fn [x] [x x]) [0 -1 7 7]))" :value (0 0 -1 -1 7 7 7 7)]
      ["(reductions +' (split-at (fn [x] (< x 3)) (seq (into (sorted-set) []))))" :throws "java.lang.ClassCastException"]
      ["(let [x (dec' 3) c (partition-by identity (map max (map vector [1 2 3] [5 4 4 2 9 0]) [1 1 1]))] (cons x c))" :throws "java.lang.ClassCastException"]
      ["(find {:a 1, :b 2} :a)" :value [:a 1]]
      ["(let [x (max-key - (reduce +' 0 (filter (some-fn odd? pos?) [3 1 2])) -1 (bit-flip 2 41)) c (range 2 5 -1)] (cons x c))" :value (-1)]]))]
    (is (= [] found))))
