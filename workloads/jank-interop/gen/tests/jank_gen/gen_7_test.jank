;; SPDX-License-Identifier: MIT
;; Generated by workloads/jank-interop/gen/gen.clj, seed 7: each case's expected
;; outcome is Clojure 1.12's for a random form, so a mismatch on jank is a deviation.
(ns jank-gen.gen-7-test
  (:require [clojure.test :refer [deftest is]]
            [clojure.string]))

(defn- ev
  "The form's value, realized, or [:jank-gen/threw what] for any throw jank's handlers can
   see (an object, a native exception or a jank::error_ref): every form gets its own
   verdict. An object's message only: printing an ex-info makes jank crash as it exits
   (jankifier's S1). A thrown string is its own message: ex-message of one throws in jank
   (jankifier's LU62), which ended the test with no verdict (an overflowing inc throws one)."
  [s]
  (try (let [v (eval (read-string s))] (pr-str v) v)
       (catch cpp/jank.runtime.object_ref e [:jank-gen/threw (if (string? e) e (ex-message e))])
       (catch cpp/std.exception e [:jank-gen/threw (str (.what e))])
       (catch cpp/jank.error_ref e [:jank-gen/threw (str (.-message (cpp/* e)))])))

(defn- threw? [v] (and (vector? v) (= :jank-gen/threw (first v))))

(defn- mismatches
  "The cases jank answers differently from Clojure, as {:i index :jank outcome}: one
   assertion a test, so that its failure (the runner reports a test's first) names them all."
  [cases]
  (vec (remove nil? (map-indexed (fn [i [code kind v]]
                                   (let [got (ev code)
                                         same (try (if (= kind :throws) (threw? got) (= v got))
                                                   (catch cpp/jank.runtime.object_ref _ false))]
                                     (when-not same {:i i :jank got})))
                                 cases))))

(deftest g0000
  (let [found (mismatches (quote [
      ["(find (merge-with max (merge-with +' (zipmap [:a :b :c] [3 1 2]) (update {:a 1, :b 2} :b (fnil inc' 0))) {}) :a)" :value [:a 4]]
      ["(take-last (list 1 2) 2)" :throws "java.lang.IllegalArgumentException"]
      ["(let [x (apply min 0 (keep-indexed (fn [i x] (when (even? i) x)) (list 1 2))) c [0 -1 7 7]] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(let [x (+' -1 (last (vec (cons 0 (seq (into (sorted-set) [])))))) c (mapcat (fn [x] [x x]) [0 -1 7 7])] (cons x c))" :value (-1 0 0 -1 -1 7 7 7 7)]
      ["(clojure.string/lower-case \" t \")" :value " t "]
      ["(every? even? [1 2 3])" :value false]
      ["(seq [3 1 2])" :value (3 1 2)]
      ["(not-any? even? (map-indexed vector (remove neg? [3 1 2])))" :throws "java.lang.IllegalArgumentException"]
      ["(mod 255 1)" :value 0]
      ["(not-every? odd? [])" :value false]]))]
    (is (= [] found))))

(deftest g0001
  (let [found (mismatches (quote [
      ["(not-every? #{1 2} (seq (into (sorted-set) (flatten (list (flatten (list [0 1 2 3 4] (list [5 4 4 2 9 0]))) (list (dedupe (list 1 2))))))))" :value true]
      ["(clojure.string/replace \"a b\" \" \" \"--\")" :value "a--b"]
      ["(mapcat (fn [x] [x x]) (nthrest (range 2 5 3) 2))" :value ()]
      ["(flatten (list (take 3 (cycle (cons 1 (vals (into (sorted-map) (zipmap [:a :b :c :d] (partition-by identity [0 1 2 3 4]))))))) (list (split-at (fn [x] (< x 3)) (map-indexed vector (flatten (list [1 2 3] (list [1 1 1]))))))))" :throws "java.lang.ClassCastException"]
      ["(empty? (split-at 3 (sort > (list 1 2))))" :value false]
      ["(conj (conj (clojure.set/difference (clojure.set/union #{} #{1}) (set [0 -1 7 7])) (max -3 (get {:a 1, :b 2} :a -5))) 127)" :throws "clojure.lang.Compiler$CompilerException"]
      ["(clojure.string/join \"-\" (rest (split-with (fn [x] (< x 3)) (range -3 5 -1))))" :value "clojure.lang.LazySeq@1"]
      ["(seq (filter (every-pred odd? pos?) [1 1 1]))" :value (1 1 1)]
      ["(contains? {:a 1} :b)" :value false]
      ["(let [x (peek (vec (cons 0 [5 4 4 2 9 0]))) c (subvec [0 1 2 3 4 5] 0 3)] (conj x c))" :throws "java.lang.ClassCastException"]]))]
    (is (= [] found))))

(deftest g0002
  (let [found (mismatches (quote [
      ["(if (seq (reductions min (sort-by first (map vector (map (comp inc identity) [1 1 1]) (range))))) (zipmap [:a :b :c] (sort-by first (map vector (map (juxt inc identity) [1 2 3]) (range)))) (some pos? [5 4 4 2 9 0]))" :value {:a [[2 1] 0], :b [[3 2] 1], :c [[4 3] 2]}]
      ["(merge-with max (frequencies []) (group-by pos? [3 1 2]))" :value {true [3 1 2]}]
      ["(find (zipmap [:a :b :c] (take 3 (cycle (cons 1 (seq (into (sorted-set) [1 2 3])))))) :b)" :value [:b 1]]
      ["(contains? {:a 1} :b)" :value false]
      ["(every? pos? [0 -1 7 7])" :value false]
      ["(find (update {:a 1} :a (fnil inc' 0)) :x)" :value nil]
      ["(range -2 7 3)" :value (-2 1 4)]
      ["(abs 0)" :value 0]
      ["(boolean (filter (some-fn odd? pos?) (keys (into (sorted-map) (assoc-in {:a 1, :x {:y 2}} [:x :y] 128)))))" :value true]
      ["(if (empty? [3 1 2]) (into #{} (map inc (mapcat (fn [x] [x x]) (mapcat (fn [x] [x x]) [3 1 2])))) (if (seq (keys (into (sorted-map) {:a 1, :x {:y 2}}))) (contains? (reduce-kv (fn [m k v] (assoc m k [v])) {} {:a 1}) :x) (find (merge-with +' {:a 1, :b 2} {:a 1}) :b)))" :value false]]))]
    (is (= [] found))))

(deftest g0003
  (let [found (mismatches (quote [
      ["(empty? (map (juxt inc dec) (list 1 2)))" :value false]
      ["(let [x 0 c (filter (some-fn odd? pos?) (partition-by identity [1 1 1]))] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(frequencies [0 1 2 3 4])" :value {0 1, 1 1, 2 1, 3 1, 4 1}]
      ["(disj (disj (conj #{} (apply max 0 [1 2 3])) 2) 1)" :value #{3}]
      ["(mapcat (fn [x] [x x]) [0 -1 7 7])" :value (0 0 -1 -1 7 7 7 7)]
      ["(contains? (update-in (update (update {:a 1} :a (fnil inc' 0)) :a (fnil inc' 0)) [:a :z] (fnil inc' 0)) :a)" :throws "java.lang.ClassCastException"]
      ["(let [x (max-key identity 127 (long (count (mapcat (fn [x] [x x]) [0 1 2 3 4]))) (bit-or (min -1 127) (get {:a 1, :b 2} :b -5))) c (take 1 (cycle (cons 1 (reverse [0 1 2 3 4]))))] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(if (empty? (subvec [0 1 2 3 4 5] 1 4)) (let [x 1000 c [(max 2 10)]] (cons x c)) (apply min 0 (sort-by first (map vector [1 1 1] (range)))))" :throws "java.lang.ClassCastException"]
      ["(str (clojure.string/starts-with? \"a\\nb\" \"\"))" :value "true"]
      ["(clojure.set/select odd? (set [5 4 4 2 9 0]))" :throws "clojure.lang.Compiler$CompilerException"]]))]
    (is (= [] found))))

(deftest g0004
  (let [found (mismatches (quote [
      ["(contains? {:a 1, :x {:y 2}} :b)" :value false]
      ["(let [x (+' -128 1000) c (sort < [])] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(subvec [0 1 2 3 4 5] 2 5)" :value [2 3 4]]
      ["(let [x 10 c [0 -1 7 7]] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(if (empty? (map (comp inc identity) (keep-indexed (fn [i x] (when (even? i) x)) (interpose 0 [1 2 3])))) (let [x (reduce min 0 [0 -1 7 7]) c (map max (subvec [0 1 2 3 4 5] 1 3) (mapcat (fn [x] [x x]) [3 1 2]))] (cons x c)) (min (bit-set (dec' 9223372036854775807) 36) 7))" :value 7]
      ["(update (group-by even? [1 2 3]) :b (fnil inc' 0))" :value {false [1 3], true [2], :b 1}]
      ["(empty? (take 6 (cycle (cons 1 (seq (into (sorted-set) [3 1 2]))))))" :value false]
      ["(if (empty? (keep-indexed (fn [i x] (when (even? i) x)) [(*' -128 255) 9223372036854775807 (reduce min 0 (list 1 2))])) (frequencies (list 1 2)) -128)" :value -128]
      ["(if (empty? [5 4 4 2 9 0]) (find (select-keys {:a 1, :x {:y 2}} [:a :b]) :a) 3)" :value 3]
      ["(some #{1 2} [5 4 4 2 9 0])" :value 2]]))]
    (is (= [] found))))

(deftest g0005
  (let [found (mismatches (quote [
      ["(merge-with max (group-by odd? (range -3 3 3)) (select-keys (zipmap [:a :b :c] [1 1 1]) []))" :value {true [-3], false [0]}]
      ["(merge-with min (update (assoc-in (reduce-kv (fn [m k v] (assoc m k [v])) {} {}) [:x :y] (reduce +' 0 [1 1 1])) :a (fnil inc' 0)) {:a 1, :x {:y 2}})" :throws "java.lang.ClassCastException"]
      ["(map (juxt inc -) (range -1 4 1))" :value ([0 1] [1 0] [2 -1] [3 -2] [4 -3])]
      ["(reduce-kv (fn [m k v] (assoc m k [v])) {} (merge-with min (clojure.set/rename-keys (frequencies []) {:a :z}) (frequencies (map-indexed vector [1 1 1]))))" :throws "clojure.lang.Compiler$CompilerException"]
      ["(contains? (assoc-in {:a 1, :x {:y 2}} [:x :y] 1) :b)" :value false]
      ["(clojure.set/select odd? (set (map (comp inc -) [])))" :throws "clojure.lang.Compiler$CompilerException"]
      ["(if (seq (map max (take-last (range -2 5 3) 3) [])) (let [x (*' (bit-set 2 59) (inc' -3)) c (split-with (fn [x] (< x 3)) [1 2 3])] (conj x c)) 2)" :throws "java.lang.IllegalArgumentException"]
      ["(find (update {:a 1, :x {:y 2}} :b (fnil inc' 0)) :a)" :value [:a 1]]
      ["(find (clojure.set/rename-keys (zipmap [:a :b :c] (seq (into (sorted-set) [1 2 3]))) {:a :z}) :x)" :throws "clojure.lang.Compiler$CompilerException"]
      ["(let [x (bit-and (apply min 0 [0 1 2 3 4]) 7) c (partition 3 1 (sort compare (keys (into (sorted-map) {}))))] (cons x c))" :value (0)]]))]
    (is (= [] found))))

(deftest g0006
  (let [found (mismatches (quote [
      ["(if (empty? (range -2 6 3)) (find (update-in (zipmap [:a :b :c] [1 2 3]) [:x :z] (fnil inc' 0)) :a) (if (empty? (reductions min [1 1 1])) (if (seq (mapcat (fn [x] [x x]) [])) (if (seq [0 1 2 3 4]) #{1 3 2} #{1}) (if (seq (list 1 2)) (if (seq [3 1 2]) (not-empty [1 1 1]) (contains? {} :x)) (if (seq [0 -1 7 7]) (list 1 2) (find {:a 1, :b 2} :a)))) (if (seq (filter (every-pred odd? pos?) [])) 127 (not-empty [5 4 4 2 9 0]))))" :value [5 4 4 2 9 0]]
      ["(long (count (reductions +' [5 4 4 2 9 0])))" :value 6]
      ["(if (empty? (seq (into (sorted-set) (subvec [0 1 2 3 4 5] 2 4)))) (boolean (map (juxt inc dec) (dedupe (list 1 2)))) #{:b :a})" :value #{:b :a}]
      ["(clojure.string/replace \"hello world\" \"a\" \"--\")" :value "hello world"]
      ["(let [x (long (count [1 2 3])) c (filter (every-pred odd? pos?) (range 0 3 1))] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(if (seq (map min [3 1 2] (split-at (fn [x] (< x 3)) [0 -1 7 7]))) \"hello world\" (into #{} (map inc (map (comp inc -) (sort-by first (map vector [5 4 4 2 9 0] (range)))))))" :throws "java.lang.ClassCastException"]
      ["(let [x 0 c [0 -1 7 7]] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(max (max-key - 3 127 (apply min 0 (mapcat (fn [x] [x x]) [5 4 4 2 9 0]))) 9223372036854775807)" :value 9223372036854775807]
      ["(boolean (drop-while odd? (interpose 0 (sort-by first (map vector [] (range))))))" :value true]
      ["(get (group-by odd? (map-indexed vector (drop-while even? [1 1 1]))) :x -5)" :throws "java.lang.IllegalArgumentException"]]))]
    (is (= [] found))))

(deftest g0007
  (let [found (mismatches (quote [
      ["(let [x (unsigned-bit-shift-right (bit-flip 255 26) 39) c [5 4 4 2 9 0]] (cons x c))" :value (0 5 4 4 2 9 0)]
      ["(let [x (apply +' 0 (map (juxt inc identity) (seq (into (sorted-set) [3 1 2])))) c (range -2 3 1)] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(+' (rem 255 2) (first (vec (cons 0 (partition-by odd? [])))))" :value 1]
      ["(let [x (min (bit-xor (get {} :b -5) (get {:a 1} :a -5)) (reduce min 0 (remove even? [5 4 4 2 9 0]))) c (keep-indexed (fn [i x] (when (even? i) x)) (drop-last (reductions min [0 1 2 3 4]) 1))] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(seq (filter (every-pred odd? pos?) (keep-indexed (fn [i x] (when (even? i) x)) (map-indexed vector [0 -1 7 7]))))" :throws "java.lang.IllegalArgumentException"]
      ["(every? even? (partition-by pos? [0 -1 7 7]))" :throws "java.lang.IllegalArgumentException"]
      ["(seq (range -3 4 1))" :value (-3 -2 -1 0 1 2 3)]
      ["(not-any? even? [3 1 2])" :value false]
      ["(sort-by first (map vector (rest (butlast (map-indexed vector (list 1 2)))) (range)))" :value ()]
      ["(some odd? (mapcat (fn [x] [x x]) (split-at 0 (reductions max [5 4 4 2 9 0]))))" :throws "java.lang.IllegalArgumentException"]]))]
    (is (= [] found))))

(deftest g0008
  (let [found (mismatches (quote [
      ["(if (seq []) (if (empty? [1 1 1]) (flatten (list [7 2] (list [5 4 4 2 9 0]))) (interpose 0 (take 4 (cycle (cons 1 []))))) (let [x (get {:a 1} :b -5) c (partition-by pos? (dedupe [1 2 3]))] (conj x c)))" :throws "java.lang.ClassCastException"]
      ["(find (update (update (update {:a 1, :x {:y 2}} :a (fnil inc' 0)) :a (fnil inc' 0)) :b (fnil inc' 0)) :b)" :value [:b 1]]
      ["(clojure.string/replace (pr-str (clojure.string/split-lines \"a\")) \"b\" \"--\")" :value "[\"a\"]"]
      ["(let [x (get (zipmap [:a :b :c] (list 1 2)) :b -5) c (seq (into (sorted-set) (partition-by odd? [])))] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(subvec [0 1 2 3 4 5] 2 5)" :value [2 3 4]]
      ["(if (empty? (subvec [0 1 2 3 4 5] 0 5)) (clojure.string/join \"|\" (clojure.string/split (str (clojure.string/last-index-of (str 10 \":\" \"hello world\") \"l\")) #\",\")) \"a b\")" :value "a b"]
      ["(get {:a 1, :x {:y 2}} :b)" :value nil]
      ["(find (reduce-kv (fn [m k v] (assoc m k [v])) {} {:a 1}) :a)" :value [:a [1]]]
      ["(if (seq [3 1 2]) (if (empty? (drop [1 1 1] 1)) (subs \"abcdef\" 2 3) (if (empty? [1 1 1]) (if (empty? [1 2 3]) [5 4 4 2 9 0] {:a 1, :x {:y 2}}) #{1})) (keys (into (sorted-map) {})))" :throws "java.lang.IllegalArgumentException"]
      ["(disj (clojure.set/select odd? (set (take 2 (cycle (cons 1 (partition-by pos? [5 4 4 2 9 0])))))) 1)" :throws "clojure.lang.Compiler$CompilerException"]]))]
    (is (= [] found))))

(deftest g0009
  (let [found (mismatches (quote [
      ["(clojure.string/join \"|\" (clojure.string/split (pr-str (clojure.string/split-lines (subs \"abcdef\" 2 3))) #\" \"))" :value "[\"c\"]"]
      ["(let [x (min (reduce min 0 (vals (into (sorted-map) (zipmap [:a :b :c :d] [5 4 4 2 9 0])))) (max (bit-shift-left 1000 54) 9223372036854775807)) c (rest (vals (into (sorted-map) (zipmap [:a :b :c :d] (interpose 0 [1 1 1])))))] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(seq [3 1 2])" :value (3 1 2)]
      ["(apply str (interpose \",\" (take-while odd? (drop (sort compare [0 1 2 3 4]) 2))))" :throws "java.lang.IllegalArgumentException"]
      ["(subs \"hello world\" 2 3)" :value "l"]
      ["(let [x (min 1 (peek (vec (cons 0 [128 127 10])))) c (keys (into (sorted-map) {:a 1, :x {:y 2}}))] (cons x c))" :value (1 :a :x)]
      ["(seq [1 1 1])" :value (1 1 1)]
      ["(if (seq (keys (into (sorted-map) (update-in (reduce-kv (fn [m k v] (assoc m k [v])) {} {}) [:x :z] (fnil inc' 0))))) (let [x (quot -1 2) c (partition-by odd? (sort-by first (map vector [] (range))))] (conj x c)) (let [x (apply +' 0 (distinct [0 1 2 3 4])) c (map (juxt inc identity) (map (juxt inc dec) [5 4 4 2 9 0]))] (cons x c)))" :throws "java.lang.ClassCastException"]
      ["(if (empty? [5 4 4 2 9 0]) {:a 1, :x {:y 2}} (let [x (- (bit-and-not 0 128)) c [1 2 3]] (conj x c)))" :throws "java.lang.ClassCastException"]
      ["(clojure.set/select odd? (set (map-indexed vector (sort-by first (map vector (map-indexed vector [1 1 1]) (range))))))" :throws "clojure.lang.Compiler$CompilerException"]]))]
    (is (= [] found))))

(deftest g0010
  (let [found (mismatches (quote [
      ["(let [x 10 c []] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(find (select-keys {:a 1, :x {:y 2}} []) :b)" :value nil]
      ["(zipmap [:a :b :c] (list 1 2))" :value {:a 1, :b 2}]
      ["(empty? (range 0 8 2))" :value false]
      ["(subs \"hello world\" 2 3)" :value "l"]
      ["(group-by even? [5 4 4 2 9 0])" :value {false [5 9], true [4 4 2 0]}]
      ["(clojure.set/intersection (set [3 1 2]) #{1})" :throws "clojure.lang.Compiler$CompilerException"]
      ["(empty? [])" :value true]
      ["(let [x (inc' (long (count [1 2 3]))) c (nthrest [3 1 2] 0)] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(update {:a 1, :b 2} :b (fnil inc' 0))" :value {:a 1, :b 3}]]))]
    (is (= [] found))))

(deftest g0011
  (let [found (mismatches (quote [
      ["(clojure.set/difference (clojure.set/select odd? (set (keep-indexed (fn [i x] (when (even? i) x)) [1 1 1]))) #{1 3 2})" :throws "clojure.lang.Compiler$CompilerException"]
      ["(clojure.set/intersection (clojure.set/difference (conj (clojure.set/difference #{1 3 2} #{}) (inc' 9223372036854775807)) (set (subvec [0 1 2 3 4 5] 2 3))) #{})" :throws "clojure.lang.Compiler$CompilerException"]
      ["(into #{} (map inc (list 1 2)))" :value #{3 2}]
      ["(clojure.set/rename-keys (assoc-in (update {:a 1} :a (fnil inc' 0)) [:x :y] 255) {:a :z})" :throws "clojure.lang.Compiler$CompilerException"]
      ["(boolean (partition-all 3 2 (vals (into (sorted-map) (zipmap [:a :b :c :d] [])))))" :value true]
      ["(last (vec (cons 0 (list 1 2))))" :value 2]
      ["(let [x 9223372036854775807 c (range -1 7 2)] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(conj (set []) (last (vec (cons 0 (seq (into (sorted-set) [1 2 3]))))))" :value #{3}]
      ["(some pos? (subvec [0 1 2 3 4 5] 1 4))" :value true]
      ["(get (select-keys {} [:a]) :x -5)" :value -5]]))]
    (is (= [] found))))

(deftest g0012
  (let [found (mismatches (quote [
      ["(subs \"abcdef\" 1 5)" :value "bcde"]
      ["(zipmap [:a :b :c] (filter (some-fn odd? pos?) [1 1 1]))" :value {:a 1, :b 1, :c 1}]
      ["(interpose 0 (vals (into (sorted-map) (zipmap [:a :b :c :d] (flatten (list [0 1 2 3 4] (list [0 1 2 3 4])))))))" :value (0 0 1 0 2 0 3)]
      ["(contains? (frequencies (reductions +' (map-indexed vector (list 1 2)))) :a)" :throws "java.lang.ClassCastException"]
      ["(not-any? #{1 2} (keys (into (sorted-map) {})))" :value true]
      ["(str (clojure.string/ends-with? (subs \"abcdef\" 2 4) \"b\"))" :value "false"]
      ["(contains? (select-keys {:a 1, :b 2} [:a]) :a)" :value true]
      ["(find (frequencies [1 2 3]) :x)" :value nil]
      ["(let [x (bit-clear (max -128 (reduce +' 0 [1 2 3])) 2) c (mapcat (fn [x] [x x]) (sort compare (sort compare [1 1 1])))] (cons x c))" :value (2 1 1 1 1 1 1)]
      ["(some odd? (keys (into (sorted-map) {:a 1, :x {:y 2}})))" :throws "java.lang.IllegalArgumentException"]]))]
    (is (= [] found))))

(deftest g0013
  (let [found (mismatches (quote [
      ["(boolean (filter (every-pred odd? pos?) [1 2 3]))" :value true]
      ["(some even? [1 2 3])" :value true]
      ["(find (frequencies (map-indexed vector [])) :b)" :value nil]
      ["(not-any? odd? (subvec [0 1 2 3 4 5] 1 3))" :value false]
      ["(drop-while even? (take-last (map + [0 -1 7 7] (filter (some-fn odd? pos?) [1 1 1])) 2))" :throws "java.lang.IllegalArgumentException"]
      ["(seq (mapcat (fn [x] [x x]) [1 2 3]))" :value (1 1 2 2 3 3)]
      ["(clojure.set/rename-keys (frequencies (vals (into (sorted-map) (zipmap [:a :b :c :d] (sort [0 1 2 3 4]))))) {:a :z})" :throws "clojure.lang.Compiler$CompilerException"]
      ["(frequencies [])" :value {}]
      ["(keep-indexed (fn [i x] (when (even? i) x)) (sort (seq (into (sorted-set) [-3]))))" :value (-3)]
      ["(if (seq (filter (some-fn odd? pos?) (take 4 (cycle (cons 1 (keys (into (sorted-map) {:a 1, :x {:y 2}}))))))) (sort-by first (map vector [0 -1 7 7] (range))) (get (clojure.set/rename-keys (select-keys {:a 1, :b 2} []) {:a :z}) :b))" :throws "clojure.lang.Compiler$CompilerException"]]))]
    (is (= [] found))))

(deftest g0014
  (let [found (mismatches (quote [
      ["(let [x (*' (get {:a 1, :x {:y 2}} :a -5) (last (vec (cons 0 (list 1 2))))) c [1 2 3]] (cons x c))" :value (2 1 2 3)]
      ["(if (empty? (take 5 (cycle (cons 1 (range -2 4 -1))))) (not-every? #{1 2} (seq (into (sorted-set) (seq (into (sorted-set) [1 1 1]))))) (frequencies (drop-last [5 4 4 2 9 0] 3)))" :throws "java.lang.IllegalArgumentException"]
      ["(some pos? (reductions min [-3 10]))" :value nil]
      ["(empty? (keys (into (sorted-map) (clojure.set/rename-keys (update-in {:a 1, :b 2} [:x :z] (fnil inc' 0)) {:a :z}))))" :throws "clojure.lang.Compiler$CompilerException"]
