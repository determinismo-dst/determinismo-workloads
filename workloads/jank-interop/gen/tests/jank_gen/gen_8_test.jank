;; SPDX-License-Identifier: MIT
;; Generated by workloads/jank-interop/gen/gen.clj, seed 8: each case's expected
;; outcome is Clojure 1.12's for a random form, so a mismatch on jank is a deviation.
(ns jank-gen.gen-8-test
  (:require [clojure.test :refer [deftest is]]
            [clojure.string]))

(defn- ev
  "The form's value, realized, or [:jank-gen/threw what] for any throw jank's handlers can
   see (an object, a native exception or a jank::error_ref): every form gets its own
   verdict. An object's message only: printing an ex-info makes jank crash as it exits
   (jankifier's S1). A thrown string is its own message: ex-message of one throws in jank
   (jankifier's LU62), which ended the test with no verdict (an overflowing inc throws one)."
  [s]
  (try (let [v (eval (read-string s))] (pr-str v) v)
       (catch cpp/jank.runtime.object_ref e [:jank-gen/threw (if (string? e) e (ex-message e))])
       (catch cpp/std.exception e [:jank-gen/threw (str (.what e))])
       (catch cpp/jank.error_ref e [:jank-gen/threw (str (.-message (cpp/* e)))])))

(defn- threw? [v] (and (vector? v) (= :jank-gen/threw (first v))))

(defn- mismatches
  "The cases jank answers differently from Clojure, as {:i index :jank outcome}: one
   assertion a test, so that its failure (the runner reports a test's first) names them all."
  [cases]
  (vec (remove nil? (map-indexed (fn [i [code kind v]]
                                   (let [got (ev code)
                                         same (try (if (= kind :throws) (threw? got) (= v got))
                                                   (catch cpp/jank.runtime.object_ref _ false))]
                                     (when-not same {:i i :jank got})))
                                 cases))))

(deftest g0000
  (let [found (mismatches (quote [
      ["(clojure.string/upper-case \"a\\nb\")" :value "A\nB"]
      ["(zipmap [:a :b :c] (partition-by odd? [5 4 4 2 9 0]))" :value {:a (5), :b (4 4 2), :c (9)}]
      ["(empty? [0 1 2 3 4])" :value false]
      ["(take 5 (cycle (cons 1 [(reduce min 0 (vals (into (sorted-map) (zipmap [:a :b :c :d] [1 2 3])))) (rem (apply min 0 [1 1 1]) 2)])))" :value (1 0 0 1 0)]
      ["(some odd? [1 2 3])" :value true]
      ["(every? even? [0 -1 7 7])" :value false]
      ["(reduce-kv (fn [m k v] (assoc m k [v])) {} (select-keys (group-by even? [1 2 3]) []))" :value {}]
      ["(get (merge-with min (update {:a 1, :b 2} :a (fnil inc' 0)) {:a 1, :x {:y 2}}) :b)" :value 2]
      ["(not-empty [5 4 4 2 9 0])" :value [5 4 4 2 9 0]]
      ["(bit-and-not (bit-set (peek (vec (cons 0 (split-with (fn [x] (< x 3)) [3 1 2])))) 52) -128)" :throws "java.lang.IllegalArgumentException"]]))]
    (is (= [] found))))

(deftest g0001
  (let [found (mismatches (quote [
      ["(if (empty? [0 (mod (reduce min 0 []) 7)]) (clojure.set/rename-keys (update (zipmap [:a :b :c] [0 1 2 3 4]) :a (fnil inc' 0)) {:a :z}) #{:b :a})" :throws "clojure.lang.Compiler$CompilerException"]
      ["(empty? (partition 3 1 (subvec [0 1 2 3 4 5] 2 4)))" :value true]
      ["(disj (set (split-with (fn [x] (< x 3)) (partition-by identity [0 1 2 3 4]))) :a)" :throws "java.lang.ClassCastException"]
      ["(reduce-kv (fn [m k v] (assoc m k [v])) {} (update (reduce-kv (fn [m k v] (assoc m k [v])) {} (update {:a 1, :b 2} :a (fnil inc' 0))) :b (fnil inc' 0)))" :throws "java.lang.ClassCastException"]
      ["(not-every? odd? [])" :value false]
      ["(get {:a 1, :x {:y 2}} :b)" :value nil]
      ["(boolean (map-indexed vector (map vector [0 1 2 3 4] (partition 3 1 [0 1 2 3 4]))))" :value true]
      ["(if (seq (mapcat (fn [x] [x x]) (range 1 5 -1))) (some even? [0 1 2 3 4]) (clojure.string/join \",\" (range -3 7 3)))" :value "-3,0,3,6"]
      ["(if (seq [5 4 4 2 9 0]) (list 1 2) (if (seq [0 -1 7 7]) (bit-and (get {:a 1, :b 2} :b -5) -1) (zipmap [:a :b :c] [1 1 1])))" :value (1 2)]
      ["(not-empty [])" :value nil]]))]
    (is (= [] found))))

(deftest g0002
  (let [found (mismatches (quote [
      ["(not-any? pos? [3 1 2])" :value false]
      ["(not-empty (partition-by odd? (split-with (fn [x] (< x 3)) [])))" :throws "java.lang.IllegalArgumentException"]
      ["(not-any? even? (reductions min (reductions max [1 1 1])))" :value true]
      ["(every? pos? (split-at 3 [0 1 2 3 4]))" :throws "java.lang.ClassCastException"]
      ["(find (assoc-in {:a 1, :b 2} [:x :y] (unsigned-bit-shift-right (rem -1 2) 56)) :x)" :value [:x {:y 255}]]
      ["(disj #{1 3 2} 2)" :value #{1 3}]
      ["(find (clojure.set/rename-keys (select-keys {:a 1, :b 2} []) {:a :z}) :b)" :throws "clojure.lang.Compiler$CompilerException"]
      ["(boolean [0 -1 7 7])" :value true]
      ["(range 1 6 -1)" :value ()]
      ["(empty? (mapcat (fn [x] [x x]) (partition 3 2 (filter (every-pred odd? pos?) []))))" :value true]]))]
    (is (= [] found))))

(deftest g0003
  (let [found (mismatches (quote [
      ["(every? odd? (keep-indexed (fn [i x] (when (even? i) x)) (range 1 5 3)))" :value true]
      ["(clojure.string/join \"\" (nthnext (take (vals (into (sorted-map) (zipmap [:a :b :c :d] (list 1 2)))) 2) 2))" :throws "java.lang.ClassCastException"]
      ["(some pos? (take 0 (cycle (cons 1 (reductions max [3 1 2])))))" :value nil]
      ["(get (reduce-kv (fn [m k v] (assoc m k [v])) {} (reduce-kv (fn [m k v] (assoc m k [v])) {} (frequencies [1 1 1]))) :b)" :value nil]
      ["(if (seq (sort compare (mapcat (fn [x] [x x]) (subvec [0 1 2 3 4 5] 1 6)))) (not-every? odd? [0 1 2 3 4]) (get (zipmap [:a :b :c] [1 1 1]) :x))" :value true]
      ["(not-every? pos? (mapcat (fn [x] [x x]) (vals (into (sorted-map) (zipmap [:a :b :c :d] (partition-by identity [0 1 2 3 4]))))))" :throws "java.lang.ClassCastException"]
      ["(assoc-in (select-keys (zipmap [:a :b :c] (sort-by first (map vector [] (range)))) []) [:x :y] (bit-xor 10 (reduce min 0 (list 1 2))))" :value {:x {:y 10}}]
      ["(map max (split-with (fn [x] (< x 3)) (keys (into (sorted-map) (reduce-kv (fn [m k v] (assoc m k [v])) {} {})))) (map min [3 1 2] [0 -1 7 7]))" :throws "java.lang.ClassCastException"]
      ["(seq [3 1 2])" :value (3 1 2)]
      ["(into #{} (map inc (flatten (list [0 1 2 3 4] (list (keys (into (sorted-map) (group-by odd? [1 2 3]))))))))" :throws "java.lang.ClassCastException"]]))]
    (is (= [] found))))

(deftest g0004
  (let [found (mismatches (quote [
      ["(clojure.set/select odd? (set (vals (into (sorted-map) (zipmap [:a :b :c :d] [3 1 2])))))" :throws "clojure.lang.Compiler$CompilerException"]
      ["(contains? (update-in (update {:a 1, :x {:y 2}} :b (fnil inc' 0)) [:a :z] (fnil inc' 0)) :b)" :throws "java.lang.ClassCastException"]
      ["(if (seq (partition-by pos? (partition-all 2 2 (reductions min [1 1 1])))) (some even? (flatten (list [] (list (map + (list 1 2) [0 1 2 3 4]))))) (not-empty (partition-all 1 1 (list 1 2))))" :throws "java.lang.ClassCastException"]
      ["(every? even? (partition-by pos? [5 4 4 2 9 0]))" :throws "java.lang.IllegalArgumentException"]
      ["(not-empty [5 4 4 2 9 0])" :value [5 4 4 2 9 0]]
      ["(not-any? #{1 2} (list 1 2))" :value false]
      ["(empty? (filter (every-pred odd? pos?) [1 2 3]))" :value false]
      ["(let [x (inc' (unsigned-bit-shift-right 7 39)) c (map + (keys (into (sorted-map) (frequencies []))) [0 -1 7 7])] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(some pos? [0])" :value nil]
      ["(every? even? [1 2 3])" :value false]]))]
    (is (= [] found))))

(deftest g0005
  (let [found (mismatches (quote [
      ["(not-every? pos? [(apply min 0 (map-indexed vector [5 4 4 2 9 0])) (dec' 3) -128])" :throws "java.lang.ClassCastException"]
      ["(str (clojure.string/includes? (str (clojure.string/last-index-of \"x,y,z\" \"b\")) \"\"))" :value "true"]
      ["(every? pos? [3 1 2])" :value true]
      ["(vals (into (sorted-map) (zipmap [:a :b :c :d] [5 4 4 2 9 0])))" :value (5 4 4 2)]
      ["(let [x 255 c (seq (into (sorted-set) (keys (into (sorted-map) (clojure.set/rename-keys {} {:a :z})))))] (cons x c))" :throws "clojure.lang.Compiler$CompilerException"]
      ["(merge-with min (update-in {:a 1, :x {:y 2}} [:x :z] (fnil inc' 0)) (update (reduce-kv (fn [m k v] (assoc m k [v])) {} (update-in {:a 1} [:x :z] (fnil inc' 0))) :b (fnil inc' 0)))" :throws "java.lang.ClassCastException"]
      ["(contains? {:a 1} :a)" :value true]
      ["(not-any? #{1 2} [1 1 1])" :value false]
      ["(map-indexed vector (take-last (list 1 2) 2))" :throws "java.lang.IllegalArgumentException"]
      ["(let [x (min-key identity -3 (bit-shift-right (first (vec (cons 0 [1 1 1]))) 16) (max-key abs 2 -1 (bit-xor 1 3))) c (partition-by odd? [1 1 1])] (cons x c))" :value (-3 (1 1 1))]]))]
    (is (= [] found))))

(deftest g0006
  (let [found (mismatches (quote [
      ["(into #{} (map inc (keep-indexed (fn [i x] (when (even? i) x)) [0 1 2 3 4])))" :value #{1 3 5}]
      ["(apply str (interpose \",\" [3 1 2]))" :value "3,1,2"]
      ["(not-any? #{1 2} (take-while neg? (partition-by identity [3 1 2])))" :throws "java.lang.ClassCastException"]
      ["(not-any? #{1 2} (map-indexed vector (list 1 2)))" :value true]
      ["(not-any? even? (map min (map (juxt inc dec) [1 2 3]) [3 1 2]))" :throws "java.lang.ClassCastException"]
      ["(clojure.set/select odd? (set (mapcat (fn [x] [x x]) [3 7])))" :throws "clojure.lang.Compiler$CompilerException"]
      ["(let [x 1 c (keep-indexed (fn [i x] (when (even? i) x)) (sort-by first (map vector [1 1 1] (range))))] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(if (empty? [(apply +' 0 (map-indexed vector [3 1 2])) (get {} :b -5) (bit-set (max 7 2) 30)]) (let [x 3 c (dedupe (map (comp inc -) []))] (conj x c)) (merge-with max {:a 1, :x {:y 2}} {:a 1}))" :throws "java.lang.ClassCastException"]
      ["(max 0 (bit-or 127 (min (last (vec (cons 0 [1 1 1]))) (bit-or 7 7))))" :value 127]
      ["(not-every? #{1 2} (sort-by first (map vector (split-with (fn [x] (< x 3)) [1 1 1]) (range))))" :throws "java.lang.ClassCastException"]]))]
    (is (= [] found))))

(deftest g0007
  (let [found (mismatches (quote [
      ["(let [x (bit-xor 128 (inc' (second (vec (cons 0 []))))) c [3 1 2]] (cons x c))" :throws "java.lang.NullPointerException"]
      ["(not-every? pos? (sort > (take 4 (cycle (cons 1 (split-at (fn [x] (< x 3)) []))))))" :throws "java.lang.ClassCastException"]
      ["(not-empty (vals (into (sorted-map) (zipmap [:a :b :c :d] (take-while pos? [5 4 4 2 9 0])))))" :value (5 4 4 2)]
      ["(if (seq (map-indexed vector (partition-by pos? (interpose 0 [5 4 4 2 9 0])))) (some even? (sort > (split-with 0 (list 1 2)))) (str -128 \"\" (clojure.string/join \"|\" (clojure.string/split (clojure.string/replace \"x,y,z\" \"a\" \"\") #\"b\"))))" :throws "java.lang.ClassCastException"]
      ["(get (group-by even? (interpose 0 (list 1 2))) :a)" :value nil]
      ["(if (seq [1 1 1]) -1 [1 2 3])" :value -1]
      ["(update (group-by even? (butlast [])) :a (fnil inc' 0))" :value {:a 1}]
      ["(subvec [0 1 2 3 4 5] 0 6)" :value [0 1 2 3 4 5]]
      ["(some even? [3 1 2])" :value true]
      ["(some #{1 2} (partition-by odd? (flatten (list (sort > [3 1 2]) (list (split-at 2 (list 1 2)))))))" :value nil]]))]
    (is (= [] found))))

(deftest g0008
  (let [found (mismatches (quote [
      ["(disj (into #{} (map inc (map (juxt inc dec) (seq (into (sorted-set) [1 2 3]))))) 2)" :throws "java.lang.ClassCastException"]
      ["(contains? (update-in (clojure.set/rename-keys (assoc-in {:a 1, :b 2} [:x :y] 0) {:a :z}) [:x :z] (fnil inc' 0)) :b)" :throws "clojure.lang.Compiler$CompilerException"]
      ["(seq [])" :value nil]
      ["(let [x 255 c (flatten (list (map max (map-indexed vector [3 1 2]) (take 6 (cycle (cons 1 [3 1 2])))) (list [5 4 4 2 9 0])))] (cons x c))" :throws "java.lang.ClassCastException"]
      ["(disj #{1 3 2} 2)" :value #{1 3}]
      ["(set (split-with (fn [x] (< x 3)) (nthrest (map (juxt inc -) []) 1)))" :value #{()}]
      ["(range 1 3 2)" :value (1)]
      ["(str (clojure.string/ends-with? (clojure.string/join \"|\" (clojure.string/split (apply str (interpose \",\" [])) #\" \")) \"b\"))" :value "false"]
      ["(str (clojure.string/ends-with? \"\" \"ld\"))" :value "false"]
      ["(clojure.set/select odd? (set (keep-indexed (fn [i x] (when (even? i) x)) (subvec [0 1 2 3 4 5] 0 3))))" :throws "clojure.lang.Compiler$CompilerException"]]))]
    (is (= [] found))))

(deftest g0009
  (let [found (mismatches (quote [
      ["(min-key - 255 (reduce max 0 (vals (into (sorted-map) (zipmap [:a :b :c :d] (flatten (list [] (list [0 1 2 3 4]))))))) (long (count [])))" :value 255]
      ["(not-empty (rest (take 5 (cycle (cons 1 (flatten (list (list 1 2) (list [3 1 2]))))))))" :value (1 2 3 1)]
      ["(let [x 0 c []] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(sort > [0 -1 7 7])" :value (7 7 0 -1)]
      ["(boolean (rest (map (comp inc dec) (take 1 (cycle (cons 1 []))))))" :value true]
      ["(let [x (second (vec (cons 0 (take 1 (cycle (cons 1 [])))))) c (list 1 2)] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(some even? [5 4 4 2 9 0])" :value true]
      ["(contains? (reduce-kv (fn [m k v] (assoc m k [v])) {} (update-in (select-keys {:a 1} [:a]) [:x :z] (fnil inc' 0))) :b)" :value false]
      ["(into #{} (map inc (partition-all 2 2 [1 1 1])))" :throws "java.lang.ClassCastException"]
      ["(str (clojure.string/index-of \"hello world\" \" \"))" :value "5"]]))]
    (is (= [] found))))

(deftest g0010
  (let [found (mismatches (quote [
      ["(contains? (select-keys (update {:a 1, :b 2} :b (fnil inc' 0)) []) :x)" :value false]
      ["(-' (apply max 0 [1 2 3]) (rem 0 1))" :value 3]
      ["(let [x 3 c (keep-indexed (fn [i x] (when (even? i) x)) (filter (every-pred odd? pos?) [7 10]))] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(get (reduce-kv (fn [m k v] (assoc m k [v])) {} (reduce-kv (fn [m k v] (assoc m k [v])) {} {})) :a)" :value nil]
      ["(some odd? (range 1 3 3))" :value true]
      ["(bit-clear (-' 0 (reduce +' 0 [1 1 1])) 12)" :value -4099]
      ["(merge-with max (group-by even? (range 1 3 2)) (update (clojure.set/rename-keys {} {:a :z}) :a (fnil inc' 0)))" :throws "clojure.lang.Compiler$CompilerException"]
      ["(set (subvec [0 1 2 3 4 5] 2 3))" :value #{2}]
      ["(get (reduce-kv (fn [m k v] (assoc m k [v])) {} (clojure.set/rename-keys (update {:a 1, :b 2} :a (fnil inc' 0)) {:a :z})) :a)" :throws "clojure.lang.Compiler$CompilerException"]
      ["(contains? (select-keys {:a 1, :x {:y 2}} [:a :b]) :a)" :value true]]))]
    (is (= [] found))))

(deftest g0011
  (let [found (mismatches (quote [
      ["(contains? (zipmap [:a :b :c] (map-indexed vector (mapcat (fn [x] [x x]) [0 1 2 3 4]))) :b)" :value true]
      ["(get {:a 1, :b 2} :b)" :value 2]
      ["(not-every? even? (seq (into (sorted-set) (sort-by first (map vector (flatten (list [] (list []))) (range))))))" :value false]
      ["(str (clojure.string/starts-with? (apply str (interpose \",\" (flatten (list (vals (into (sorted-map) (zipmap [:a :b :c :d] [1 1 1]))) (list [3 1 2]))))) \"\"))" :value "true"]
      ["(min-key - (*' (bit-clear (max-key abs 7 255 9223372036854775807) 1) -3) (dec' 2) (second (vec (cons 0 (subvec [0 1 2 3 4 5] 2 3)))))" :value 2]
      ["(every? pos? (mapcat (fn [x] [x x]) (sort [0 1 2 3 4])))" :value false]
      ["(every? #{1 2} [3 1 2])" :value false]
      ["(empty? (split-with 1 (interpose 0 (mapcat (fn [x] [x x]) [5 4 4 2 9 0]))))" :value false]
      ["(subvec [0 1 2 3 4 5] 2 4)" :value [2 3]]
      ["(frequencies (keep-indexed (fn [i x] (when (even? i) x)) [1 1 1]))" :value {1 2}]]))]
    (is (= [] found))))

(deftest g0012
  (let [found (mismatches (quote [
      ["(map-indexed vector (map max (range -1 6 -1) (keys (into (sorted-map) {}))))" :value ()]
      ["(frequencies (sort > (range 1 6 1)))" :value {5 1, 4 1, 3 1, 2 1, 1 1}]
      ["(apply str (interpose \",\" (take-while pos? (vals (into (sorted-map) (zipmap [:a :b :c :d] (partition-by identity [3 1 2])))))))" :throws "java.lang.ClassCastException"]
      ["(every? #{1 2} (filter (some-fn odd? pos?) (reductions +' (map (comp inc identity) [5 4 4 2 9 0]))))" :value false]
      ["(apply str (interpose \",\" (seq (into (sorted-set) (interpose 0 [1 2 3])))))" :value "0,1,2,3"]
      ["(seq (range -2 4 -1))" :value nil]
      ["(seq (reductions min (interpose 0 (reductions +' []))))" :value (0)]
      ["(empty? [1 2 3])" :value false]
      ["(get {} :x)" :value nil]
      ["(not-any? even? (subvec [0 1 2 3 4 5] 0 5))" :value false]]))]
    (is (= [] found))))

(deftest g0013
  (let [found (mismatches (quote [
      ["(clojure.string/join \"|\" (clojure.string/split (subs \"abcdef\" 2 3) #\" \"))" :value "c"]
      ["(empty? (take-last (partition 3 1 [1 1 1]) 1))" :throws "java.lang.IllegalArgumentException"]
      ["(find {:a 1} :a)" :value [:a 1]]
      ["(mod (get (zipmap [:a :b :c] (reductions max [])) :a -5) 2)" :throws "clojure.lang.ArityException"]
      ["(apply str (interpose \",\" (filter (some-fn odd? pos?) (drop-last [0 -1 7 7] 0))))" :throws "java.lang.IllegalArgumentException"]
      ["(find (group-by pos? (reductions min [5 4 4 2 9 0])) :b)" :value nil]
      ["(contains? {:a 1, :x {:y 2}} :x)" :value true]
      ["(get (update-in {:a 1, :x {:y 2}} [:x :z] (fnil inc' 0)) :b)" :value nil]
      ["(get (select-keys {:a 1, :x {:y 2}} [:a]) :x)" :value nil]
      ["(let [x (inc' -3) c (range -1 3 -1)] (conj x c))" :throws "java.lang.ClassCastException"]]))]
    (is (= [] found))))

(deftest g0014
  (let [found (mismatches (quote [
      ["(sort [5 4 4 2 9 0])" :value (0 2 4 4 5 9)]
      ["(seq (list 1 2))" :value (1 2)]
      ["(clojure.set/select odd? (set (take 2 (cycle (cons 1 [0 1 2 3 4])))))" :throws "clojure.lang.Compiler$CompilerException"]
      ["(disj #{} :a)" :value #{}]
      ["(set [0 1 2 3 4])" :value #{0 1 4 3 2}]
      ["(get {} :b)" :value nil]
      ["(frequencies [])" :value {}]
      ["(update-in {:a 1, :x {:y 2}} [:a :z] (fnil inc' 0))" :throws "java.lang.ClassCastException"]
      ["(seq [5 4 4 2 9 0])" :value (5 4 4 2 9 0)]
      ["(partition-by identity [5 4 4 2 9 0])" :value ((5) (4 4) (2) (9) (0))]]))]
    (is (= [] found))))

(deftest g0015
  (let [found (mismatches (quote [
      ["(assoc-in (clojure.set/rename-keys {} {:a :z}) [:x :y] (reduce min 0 (filter pos? (map (comp inc identity) []))))" :throws "clojure.lang.Compiler$CompilerException"]
      ["(if (empty? (interpose 0 (sort-by first (map vector [10 10 10] (range))))) (not-any? odd? [1 2 3]) (find {:a 1, :b 2} :b))" :value [:b 2]]
      ["(clojure.string/join \",\" (partition-by pos? [3 1 2]))" :value "(3 1 2)"]
      ["(find (reduce-kv (fn [m k v] (assoc m k [v])) {} (merge-with +' (group-by odd? [0 -1 7 7]) (zipmap [:a :b :c] []))) :a)" :value nil]
      ["(disj (clojure.set/difference (set (distinct [3 1 2])) (into #{} (map inc (seq (into (sorted-set) [0 -1 7 7]))))) 2)" :throws "clojure.lang.Compiler$CompilerException"]
      ["(not-empty (keys (into (sorted-map) {})))" :value nil]
      ["(if (seq (remove neg? [3 1 2])) (update {:a 1, :b 2} :b (fnil inc' 0)) (if (empty? (split-at 3 [1 2 3])) (let [x (bit-set -3 0) c (mapcat (fn [x] [x x]) [0 1 2 3 4])] (conj x c)) (empty? (partition-by pos? [0 -1 7 7]))))" :value {:a 1, :b 3}]
      ["(group-by even? [5 4 4 2 9 0])" :value {false [5 9], true [4 4 2 0]}]
      ["(str (clojure.string/last-index-of (str 1 \"\" (str (clojure.string/last-index-of \"x,y,z\" \"a\"))) \"b\"))" :value ""]
      ["(if (empty? (map (comp inc identity) (interpose 0 (reductions max [3 1 2])))) (partition-all 3 2 (butlast (list 1 2))) (take 0 (cycle (cons 1 [-3]))))" :value ()]]))]
    (is (= [] found))))

(deftest g0016
  (let [found (mismatches (quote [
      ["(clojure.string/upper-case (subs \"hello world\" 1 3))" :value "EL"]
