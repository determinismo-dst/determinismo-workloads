      ["(str (bit-and-not (bit-flip 127 43) (min-key - (get {:a 1, :x {:y 2}} :a -5) (mod 9223372036854775807 7) (apply max 0 [5 4 4 2 9 0]))) \"-\" \"a\")" :value "8796093022326-a"]
      ["(some pos? [])" :value nil]
      ["(bit-shift-left -128 55)" :value -4611686018427387904]
      ["(seq [5 4 4 2 9 0])" :value (5 4 4 2 9 0)]
      ["(clojure.string/capitalize \"a\")" :value "A"]
      ["(if (seq (map (juxt inc identity) (keep-indexed (fn [i x] (when (even? i) x)) (rest [5 4 4 2 9 0])))) #{:b :a} (str (clojure.string/last-index-of \"a b\" \" \")))" :value #{:b :a}]
      ["(contains? (merge-with min (frequencies (flatten (list [] (list (list 1 2))))) (reduce-kv (fn [m k v] (assoc m k [v])) {} {})) :b)" :value false]]))]
    (is (= [] found))))

(deftest g0049
  (let [found (mismatches (quote [
      ["(if (seq (subvec [0 1 2 3 4 5] 2 4)) (merge-with +' (clojure.set/rename-keys (select-keys {:a 1, :x {:y 2}} [:a]) {:a :z}) (frequencies (partition 1 1 [1 1 1]))) (every? #{1 2} (mapcat (fn [x] [x x]) [0 -1 7 7])))" :throws "clojure.lang.Compiler$CompilerException"]
      ["(disj #{} :a)" :value #{}]
      ["(set (filter (some-fn odd? pos?) []))" :value #{}]
      ["(set (interpose 0 []))" :value #{}]
      ["(find (clojure.set/rename-keys (clojure.set/rename-keys {:a 1, :x {:y 2}} {:a :z}) {:a :z}) :x)" :throws "clojure.lang.Compiler$CompilerException"]
      ["(seq (range 1 6 -1))" :value nil]
      ["(boolean (drop (vals (into (sorted-map) (zipmap [:a :b :c :d] (drop-while even? [])))) 2))" :value true]
      ["(str (clojure.string/starts-with? (str (clojure.string/index-of (subs \"abcdef\" 0 5) \" \")) \"a\"))" :value "false"]
      ["(let [x (long (count (mapcat (fn [x] [x x]) [10 1000]))) c (split-with (fn [x] (< x 3)) [5 4 4 2 9 0])] (cons x c))" :value (4 () (5 4 4 2 9 0))]
      ["(let [x (get (merge-with max {:a 1} (frequencies (list 1 2))) :x -5) c (split-at 2 [0 1 2 3 4])] (cons x c))" :value (-5 (0 1) (2 3 4))]]))]
    (is (= [] found))))
