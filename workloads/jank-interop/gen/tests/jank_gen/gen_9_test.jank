(deftest g0008
  (let [found (mismatches (quote [
      ["(clojure.set/difference #{} (into #{} (map inc (list 1 2))))" :throws "clojure.lang.Compiler$CompilerException"]
      ["(if (seq (partition-by pos? [1 1 1])) (let [x (max (second (vec (cons 0 [1 1 1]))) (unsigned-bit-shift-right 0 57)) c (flatten (list [3 1 2] (list [])))] (cons x c)) (reduce-kv (fn [m k v] (assoc m k [v])) {} (zipmap [:a :b :c] (partition-by odd? []))))" :value (1 3 1 2)]
      ["(contains? (update (clojure.set/rename-keys (clojure.set/rename-keys {:a 1, :x {:y 2}} {:a :z}) {:a :z}) :a (fnil inc' 0)) :a)" :throws "clojure.lang.Compiler$CompilerException"]
      ["(conj #{1 3 2} (bit-and-not 1000 (last (vec (cons 0 (map-indexed vector [0 -1 7 7]))))))" :throws "java.lang.IllegalArgumentException"]
      ["(if (empty? (partition 2 2 (keep-indexed (fn [i x] (when (even? i) x)) (sort > [3 1 2])))) (zipmap [:a :b :c] (range -3 7 1)) (if (seq (filter even? (drop-while even? [5 4 4 2 9 0]))) (if (empty? (partition-by pos? (list 1 2))) (seq [0 1 2 3 4]) (if (seq [1 2 3]) (every? pos? [5 4 4 2 9 0]) (seq [1 2 3]))) (seq (filter (some-fn odd? pos?) [3 1 2]))))" :value false]
      ["(list 1 2)" :value (1 2)]
      ["(some pos? (map min [0 1 2 3 4] [0 -1 7 7]))" :value true]
      ["(if (seq [1 2 3]) (min-key identity (min-key identity 3 (reduce min 0 [0 1 2 3 4]) (second (vec (cons 0 [1 1 1])))) (get {:a 1, :x {:y 2}} :a -5) 0) \"a\\nb\")" :value 0]
      ["(bit-shift-right 2 28)" :value 0]
      ["(not-every? #{1 2} (nthrest [1 2 3] 0))" :value true]]))]
    (is (= [] found))))

(deftest g0009
  (let [found (mismatches (quote [
      ["(pr-str (clojure.string/split-lines \"a\\nb\"))" :value "[\"a\" \"b\"]"]
      ["(find {} :x)" :value nil]
      ["(let [x (get {:a 1, :b 2} :a -5) c (partition-by pos? (list 1 2))] (cons x c))" :value (1 (1 2))]
      ["(frequencies (flatten (list [0 -1 7 7] (list [1 2 3]))))" :value {0 1, -1 1, 7 2, 1 1, 2 1, 3 1}]
      ["(clojure.set/rename-keys {:a 1, :x {:y 2}} {:a :z})" :throws "clojure.lang.Compiler$CompilerException"]
      ["(clojure.set/select odd? (set [1 1 1]))" :throws "clojure.lang.Compiler$CompilerException"]
      ["(clojure.set/select odd? (set []))" :throws "clojure.lang.Compiler$CompilerException"]
      ["(if (empty? (partition-all 2 1 (seq (into (sorted-set) (keep-indexed (fn [i x] (when (even? i) x)) (list 1 2)))))) (not-empty (keep-indexed (fn [i x] (when (even? i) x)) (distinct [5 4 4 2 9 0]))) (clojure.string/replace \"a b\" \"a\" \"\"))" :value " b"]
      ["(select-keys (assoc-in {:a 1, :x {:y 2}} [:x :y] -128) [:a :b])" :value {:a 1}]
      ["(boolean (split-at (fn [x] (< x 3)) (subvec [0 1 2 3 4 5] 2 5)))" :value true]]))]
    (is (= [] found))))

(deftest g0010
  (let [found (mismatches (quote [
      ["(let [x (long (count (list 1 2))) c [1 2 3]] (cons x c))" :value (2 1 2 3)]
      ["(into #{} (map inc (seq (into (sorted-set) (reverse (filter (every-pred odd? pos?) [0 -1 7 7]))))))" :value #{8}]
      ["(str (clojure.string/last-index-of \"hello world\" \" \"))" :value "5"]
      ["(get (merge-with min {:a 1} {:a 1, :b 2}) :x)" :value nil]
      ["(group-by odd? (mapcat (fn [x] [x x]) (take-last (mapcat (fn [x] [x x]) [0 -1 7 7]) 1)))" :throws "java.lang.IllegalArgumentException"]
      ["(let [x 7 c (map-indexed vector (interpose 0 (map max [0 1 2 3 4] [0 -1 7 7])))] (cons x c))" :value (7 [0 0] [1 0] [2 1] [3 0] [4 7] [5 0] [6 7])]
      ["(let [x 9223372036854775807 c (partition-all 3 1 [5 4 4 2 9 0])] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(find (merge-with +' (frequencies (reductions max [0 1 2 3 4])) {:a 1, :x {:y 2}}) :b)" :value nil]
      ["(some odd? (split-at (fn [x] (< x 3)) [0 -1 7 7]))" :throws "java.lang.ClassCastException"]
      ["(contains? (clojure.set/rename-keys (assoc-in (zipmap [:a :b :c] [5 4 4 2 9 0]) [:x :y] (max -1 127)) {:a :z}) :x)" :throws "clojure.lang.Compiler$CompilerException"]]))]
    (is (= [] found))))

(deftest g0011
  (let [found (mismatches (quote [
      ["(max (last (vec (cons 0 (butlast [5 4 4 2 9 0])))) 0)" :value 9]
      ["(let [x 1 c (partition-all 1 2 [1 2 3])] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(let [x (reduce max 0 [3 1 2]) c (map-indexed vector (map-indexed vector (map-indexed vector [3 1 2])))] (cons x c))" :value (3 [0 [0 [0 3]]] [1 [1 [1 1]]] [2 [2 [2 2]]])]
      ["(empty? (subvec [0 1 2 3 4 5] 1 3))" :value false]
      ["(contains? (zipmap [:a :b :c] [3 1 2]) :x)" :value false]
      ["(long (count [0 -1 7 7]))" :value 4]
      ["(if (empty? (sort compare (reductions +' (split-at (fn [x] (< x 3)) (list 1 2))))) (let [x (*' (get {:a 1, :b 2} :b -5) (bit-or -128 255)) c (split-with (fn [x] (< x 3)) [0 -1 7 7])] (conj x c)) #{1})" :throws "java.lang.ClassCastException"]
      ["(boolean (seq (into (sorted-set) (sort > (mapcat (fn [x] [x x]) [1 1 1])))))" :value true]
      ["(not-empty (take-last [] 3))" :throws "java.lang.IllegalArgumentException"]
      ["(clojure.string/join \"\" (partition 3 1 (range 2 8 -1)))" :value ""]]))]
    (is (= [] found))))

(deftest g0012
  (let [found (mismatches (quote [
      ["(let [x (apply max 0 (rest (map + [3 1 2] [3 1 2]))) c (subvec [0 1 2 3 4 5] 0 5)] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(let [x 0 c (interpose 0 [])] (cons x c))" :value (0)]
      ["(let [x 1000 c (seq (into (sorted-set) (take [1 1 1] 2)))] (cons x c))" :throws "java.lang.ClassCastException"]
      ["(contains? {:a 1} :b)" :value false]
      ["(if (empty? [0 1 2 3 4]) [9223372036854775807 (reduce min 0 (map-indexed vector []))] (some odd? [1 2 3]))" :value true]
      ["(some odd? (range -2 4 -1))" :value nil]
      ["(set [0 -1 7 7])" :value #{0 7 -1}]
      ["(apply max 0 (list 1 2))" :value 2]
      ["(not-empty [1 1 1])" :value [1 1 1]]
      ["(update {:a 1} :a (fnil inc' 0))" :value {:a 2}]]))]
    (is (= [] found))))

(deftest g0013
  (let [found (mismatches (quote [
      ["(frequencies [1 1 1])" :value {1 3}]
      ["(into #{} (map inc (filter (some-fn odd? pos?) (sort > (remove neg? [0 1 2 3 4])))))" :value #{4 3 2 5}]
      ["(split-at 1 (rest [0 1 2 3 4]))" :value [(1) (2 3 4)]]
      ["(long (count [0 -1 7 7]))" :value 4]
      ["(let [x (bit-xor 127 (get {:a 1} :a -5)) c [0 -1 7 7]] (cons x c))" :value (126 0 -1 7 7)]
      ["(not-empty (keys (into (sorted-map) {:a 1, :b 2})))" :value (:a :b)]
