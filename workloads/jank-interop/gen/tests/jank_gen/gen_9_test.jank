      ["(str 128 \"-\" (subs \"abcdef\" 1 4))" :value "128-bcd"]
      ["(update-in (select-keys (zipmap [:a :b :c] (remove pos? [3 1 2])) []) [:x :z] (fnil inc' 0))" :value {:x {:z 1}}]
      ["(clojure.string/join \"|\" (clojure.string/split (apply str (interpose \",\" (vals (into (sorted-map) (zipmap [:a :b :c :d] (nthnext [3 1 2] 0)))))) #\",\"))" :value "3|1|2"]]))]
    (is (= [] found))))

(deftest g0014
  (let [found (mismatches (quote [
      ["(if (empty? (partition 1 1 (partition-by pos? [1 1 1]))) #{1} (if (seq (interpose 0 (vals (into (sorted-map) (zipmap [:a :b :c :d] [3 1 2]))))) {} (reduce-kv (fn [m k v] (assoc m k [v])) {} (reduce-kv (fn [m k v] (assoc m k [v])) {} {:a 1, :b 2}))))" :value {}]
      ["(frequencies (keys (into (sorted-map) (clojure.set/rename-keys {:a 1, :b 2} {:a :z}))))" :throws "clojure.lang.Compiler$CompilerException"]
      ["(if (seq [0 1 2 3 4]) (update-in (merge-with min (update-in {} [:x :z] (fnil inc' 0)) {}) [:a :z] (fnil inc' 0)) (seq (reverse (map-indexed vector (list 1 2)))))" :value {:x {:z 1}, :a {:z 1}}]
      ["(let [x 1 c (split-with (fn [x] (< x 3)) (partition-all 3 2 [1 2 3]))] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(let [x -128 c (split-at (fn [x] (< x 3)) (split-with 0 (split-at (fn [x] (< x 3)) (list 1 2))))] (cons x c))" :throws "java.lang.ClassCastException"]
      ["(if (seq [0 -1 7 7]) (clojure.string/capitalize \"Ab-C\") (sort > [0 -1 7 7]))" :value "Ab-c"]
      ["(get (update-in {:a 1} [:a :z] (fnil inc' 0)) :x -5)" :throws "java.lang.ClassCastException"]
      ["(apply str (interpose \",\" (take-while odd? (subvec [0 1 2 3 4 5] 1 3))))" :value "1"]
      ["(set [])" :value #{}]
      ["(str (clojure.string/index-of (clojure.string/lower-case (pr-str (clojure.string/split-lines (clojure.string/join \"|\" (clojure.string/split \"a\\nb\" #\"b\"))))) \"b\"))" :value ""]]))]
    (is (= [] found))))

(deftest g0015
