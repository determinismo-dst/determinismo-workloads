      ["(set (list 1 2))" :value #{1 2}]
      ["(not-every? #{1 2} (keep-indexed (fn [i x] (when (even? i) x)) (drop (keys (into (sorted-map) {})) 0)))" :throws "java.lang.IllegalArgumentException"]
      ["(let [x (get (merge-with max (zipmap [:a :b :c] [0 1 2 3 4]) {:a 1, :x {:y 2}}) :a -5) c (seq (into (sorted-set) (keep-indexed (fn [i x] (when (even? i) x)) (split-with (fn [x] (< x 3)) [1 2 3]))))] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(reductions min [3 1 2])" :value (3 1 1)]
      ["(not-every? pos? [(abs (*' 2 0)) (reduce min 0 (take 0 (cycle (cons 1 [0 1 2 3 4])))) 10])" :value true]
      ["(clojure.string/join \"|\" (clojure.string/split (str (clojure.string/starts-with? (pr-str (clojure.string/blank? (str (clojure.string/last-index-of \" t \" \" \")))) \"\")) #\"b\"))" :value "true"]
      ["(apply min 0 [])" :value 0]]))]
