      ["(boolean (vals (into (sorted-map) (zipmap [:a :b :c :d] (subvec [0 1 2 3 4 5] 0 5)))))" :value true]
      ["(every? #{1 2} (map (comp inc dec) (take 1 (cycle (cons 1 [0 1 2 3 4])))))" :value true]
      ["(seq [0 1 2 3 4])" :value (0 1 2 3 4)]
      ["(disj (disj (clojure.set/select odd? (set (sort compare [0 -1 7 7]))) 2) 2)" :throws "clojure.lang.Compiler$CompilerException"]
      ["(find (assoc-in (frequencies [5 4 4 2 9 0]) [:x :y] (bit-xor (min-key abs -1 128 1000) (reduce +' 0 [3 1 2]))) :a)" :value nil]
      ["(long (count (sort compare [5 4 4 2 9 0])))" :value 6]
      ["(clojure.string/join \"|\" (clojure.string/split (clojure.string/replace (clojure.string/join \",\" [0 -1 7 7]) \"l\" \"\") #\"b\"))" :value "0,-1,7,7"]
      ["(let [x 3 c (map vector [1 2 3] (sort < [3 1 2]))] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(let [x -128 c [0 -1 7 7]] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(conj (clojure.set/select odd? (set [])) 127)" :throws "clojure.lang.Compiler$CompilerException"]]))]
    (is (= [] found))))

(deftest g0004
  (let [found (mismatches (quote [
      ["(bit-and-not (max-key - (*' 2 -128) (apply +' 0 []) (reduce min 0 [])) (mod 10 2))" :value -256]
      ["(if (seq (seq (into (sorted-set) (sort [0 1 2 3 4])))) (contains? (group-by pos? (seq (into (sorted-set) [0 1 2 3 4]))) :b) (if (empty? (interpose 0 (sort > []))) (disj (conj #{} 1) 1) (abs 1)))" :value false]
      ["(let [x -128 c (split-at (fn [x] (< x 3)) (remove neg? (map + [0 1 2 3 4] [5 4 4 2 9 0])))] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(empty? (range -1 5 -1))" :value true]
      ["(subs \"hello world\" 1 5)" :value "ello"]
      ["(not-any? odd? [1 2 3])" :value false]
      ["(boolean (partition-by identity [5 4 4 2 9 0]))" :value true]
      ["(long (count (interpose 0 [5 4 4 2 9 0])))" :value 11]
      ["(not-empty (list 1 2))" :value (1 2)]
      ["(select-keys (merge-with min (assoc-in {:a 1} [:x :y] 3) {}) [:a])" :value {:a 1}]]))]
    (is (= [] found))))

(deftest g0005
  (let [found (mismatches (quote [
      ["(max-key abs 7 (second (vec (cons 0 (mapcat (fn [x] [x x]) [0 1 2 3 4])))) 128)" :value 128]
      ["(set (partition-by identity [1 2 3]))" :value #{(3) (2) (1)}]
      ["(if (seq (butlast (flatten (list [3 1 2] (list (reductions min [0 -1 7 7])))))) (every? odd? (sort compare [0 1 2 3 4])) (let [x (bit-xor (peek (vec (cons 0 [1 1 1]))) 3) c (take-last (partition-by identity (list 1 2)) 0)] (conj x c)))" :value false]
      ["(clojure.string/replace \"hello world\" \" \" \"X\")" :value "helloXworld"]
      ["(if (seq (take 6 (cycle (cons 1 (subvec [0 1 2 3 4 5] 2 4))))) \"Ab-C\" (get (group-by odd? [3 1 2]) :b))" :value "Ab-C"]
      ["(let [x 127 c (reductions min (map (comp inc dec) (keep-indexed (fn [i x] (when (even? i) x)) (list 1 2))))] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(reductions max [])" :throws "clojure.lang.ArityException"]
      ["(some even? [0 -1 7 7])" :value true]
      ["(merge-with min (select-keys {:a 1, :x {:y 2}} [:a :b]) (reduce-kv (fn [m k v] (assoc m k [v])) {} (clojure.set/rename-keys (frequencies [1 2 3]) {:a :z})))" :throws "clojure.lang.Compiler$CompilerException"]
      ["(drop-last (take 6 (cycle (cons 1 (map (comp inc identity) [5 4 4 2 9 0])))) 3)" :throws "java.lang.IllegalArgumentException"]]))]
    (is (= [] found))))

(deftest g0006
  (let [found (mismatches (quote [
      ["(get (clojure.set/rename-keys {} {:a :z}) :b)" :throws "clojure.lang.Compiler$CompilerException"]
      ["(every? odd? [5 4 4 2 9 0])" :value false]
      ["(not-any? odd? (map (juxt inc -) [1 2 3]))" :throws "java.lang.IllegalArgumentException"]
      ["(if (seq [1 1 1]) #{1} (if (seq (subvec [0 1 2 3 4 5] 2 3)) (take 4 (cycle (cons 1 [0 -1 7 7]))) (let [x (apply +' 0 [1 1 1]) c [3 1 2]] (conj x c))))" :value #{1}]
      ["(clojure.string/triml \"a\\nb\")" :value "a\nb"]
      ["(not-every? pos? (filter odd? (reductions max (mapcat (fn [x] [x x]) [3 1 2]))))" :value false]
      ["(every? odd? [])" :value true]
      ["(clojure.set/intersection (clojure.set/difference (clojure.set/select odd? (set (filter (every-pred odd? pos?) [1 1 1]))) (clojure.set/select odd? (set (split-with 2 [0 -1 7 7])))) (set (keep-indexed (fn [i x] (when (even? i) x)) [1 2 3])))" :throws "clojure.lang.Compiler$CompilerException"]
      ["(str (clojure.string/last-index-of \"a b\" \"a\"))" :value "0"]
      ["(str (clojure.string/ends-with? (str (clojure.string/index-of \"hello world\" \"b\")) \"\"))" :value "true"]]))]
    (is (= [] found))))

