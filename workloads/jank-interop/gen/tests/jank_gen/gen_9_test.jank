;; SPDX-License-Identifier: MIT
;; Generated by workloads/jank-interop/gen/gen.clj, seed 9: each case's expected
;; outcome is Clojure 1.12's for a random form, so a mismatch on jank is a deviation.
(ns jank-gen.gen-9-test
  (:require [clojure.test :refer [deftest is]]
            [clojure.string]))

(defn- ev
  "The form's value, realized, or [:jank-gen/threw what] for any throw jank's handlers can
   see (an object, a native exception or a jank::error_ref): every form gets its own
   verdict. An object's message only: printing an ex-info makes jank crash as it exits
   (jankifier's S1). A thrown string is its own message: ex-message of one throws in jank
   (jankifier's LU62), which ended the test with no verdict (an overflowing inc throws one)."
  [s]
  (try (let [v (eval (read-string s))] (pr-str v) v)
       (catch cpp/jank.runtime.object_ref e [:jank-gen/threw (if (string? e) e (ex-message e))])
       (catch cpp/std.exception e [:jank-gen/threw (str (.what e))])
       (catch cpp/jank.error_ref e [:jank-gen/threw (str (.-message (cpp/* e)))])))

(defn- threw? [v] (and (vector? v) (= :jank-gen/threw (first v))))

(defn- mismatches
  "The cases jank answers differently from Clojure, as {:i index :jank outcome}: one
   assertion a test, so that its failure (the runner reports a test's first) names them all."
  [cases]
  (vec (remove nil? (map-indexed (fn [i [code kind v]]
                                   (let [got (ev code)
                                         same (try (if (= kind :throws) (threw? got) (= v got))
                                                   (catch cpp/jank.runtime.object_ref _ false))]
                                     (when-not same {:i i :jank got})))
                                 cases))))

(deftest g0000
  (let [found (mismatches (quote [
      ["(let [x 10 c (map (comp inc -) [3 1 2])] (cons x c))" :value (10 -2 0 -1)]
      ["(if (seq []) (let [x (get {:a 1} :a -5) c (mapcat (fn [x] [x x]) (sort-by first (map vector [] (range))))] (conj x c)) (max 255 0))" :value 255]
      ["(distinct (range -2 3 3))" :value (-2 1)]
      ["(contains? (reduce-kv (fn [m k v] (assoc m k [v])) {} (assoc-in (zipmap [:a :b :c] [1 1 1]) [:x :y] 9223372036854775807)) :a)" :value true]
      ["(get {} :b)" :value nil]
      ["(if (empty? [5 4 4 2 9 0]) (get (zipmap [:a :b :c] [3 1 2]) :b) #{:b :a})" :value #{:b :a}]
      ["(seq (vals (into (sorted-map) (zipmap [:a :b :c :d] (sort (keep-indexed (fn [i x] (when (even? i) x)) (list 1 2)))))))" :value (1)]
      ["(some #{1 2} [5 4 4 2 9 0])" :value 2]
      ["(into #{} (map inc (take 0 (cycle (cons 1 [])))))" :value #{}]
      ["(not-any? pos? [0 1 2 3 4])" :value false]]))]
    (is (= [] found))))

(deftest g0001
  (let [found (mismatches (quote [
      ["(find {:a 1} :x)" :value nil]
      ["(empty? (split-with 3 [0 1 2 3 4]))" :value false]
      ["(clojure.set/union (disj #{} :a) (disj #{} 1))" :throws "clojure.lang.Compiler$CompilerException"]
      ["(contains? {:a 1} :a)" :value true]
      ["(let [x 1 c (nthrest (list 1 2) 3)] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(let [x 127 c (seq (into (sorted-set) []))] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(flatten (list [5 4 4 2 9 0] (list [(apply max 0 (list 1 2)) (max-key abs (second (vec (cons 0 (list 1 2)))) (bit-or 128 1000) (apply min 0 [0 -1 7 7]))])))" :value (5 4 4 2 9 0 2 1000)]
      ["(bit-or (peek (vec (cons 0 (flatten (list [] (list (take-while neg? [1 1 1]))))))) (get (select-keys (clojure.set/rename-keys {:a 1, :b 2} {:a :z}) []) :b -5))" :throws "clojure.lang.Compiler$CompilerException"]
      ["(some #{1 2} [])" :value nil]
      ["(empty? [3 1 2])" :value false]]))]
    (is (= [] found))))

(deftest g0002
  (let [found (mismatches (quote [
      ["(str (clojure.string/last-index-of (clojure.string/lower-case (clojure.string/join \"-\" [1 2 3])) \" \"))" :value ""]
      ["(clojure.string/join \"|\" (clojure.string/split (clojure.string/join \"|\" (clojure.string/split (clojure.string/join \"\" (take 0 (cycle (cons 1 (list 1 2))))) #\"b\")) #\"b\"))" :value ""]
      ["(let [x (bit-or 1 (last (vec (cons 0 (reverse (list 1 2)))))) c (reductions min (filter neg? []))] (conj x c))" :throws "java.lang.ClassCastException"]
      ["(long (count (partition-by odd? (partition-by identity [1 2 3]))))" :throws "java.lang.IllegalArgumentException"]
      ["(bit-flip 1000 35)" :value 34359739368]
      ["(reduce min 0 (flatten (list [5 4 4 2 9 0] (list (map (juxt inc identity) (partition-all 2 2 [0 -1 7 7]))))))" :throws "java.lang.ClassCastException"]
      ["(if (empty? (sort-by first (map vector (keep-indexed (fn [i x] (when (even? i) x)) (vals (into (sorted-map) (zipmap [:a :b :c :d] (list 1 2))))) (range)))) (long (count (map vector [0 -1 7 7] (map-indexed vector [1 1 1])))) (bit-set (apply +' 0 (map-indexed vector [0 -1 7 7])) 18))" :throws "java.lang.ClassCastException"]
      ["(if (empty? (range 0 8 2)) (bit-and (apply +' 0 [0 -1 7 7]) (get (assoc-in {:a 1, :b 2} [:x :y] 0) :b -5)) (some #{1 2} (map (juxt inc identity) (subvec [0 1 2 3 4 5] 2 6))))" :value nil]
      ["(not-every? pos? [1 1 1])" :value false]
      ["(set (range -1 8 1))" :value #{0 7 1 4 -1 6 3 2 5}]]))]
    (is (= [] found))))

(deftest g0003
