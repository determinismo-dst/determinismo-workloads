      ["(set? (if (neg? :x) (inc 255) (if (odd? (let [x 255] (* x 2))) (name :a) (frequencies []))))" :throws "java.lang.ClassCastException"]
      ["(if (neg? :x) (inc 255) (if (odd? (let [x 255] (* x 2))) (name :a) (frequencies [])))" :throws "java.lang.ClassCastException"]
      ["(neg? :x)" :throws "java.lang.ClassCastException"]
      ["(inc 255)" :value 256]
      ["(if (odd? (let [x 255] (* x 2))) (name :a) (frequencies []))" :value {}]
      ["(odd? (let [x 255] (* x 2)))" :value false]
      ["(let [x 255] (* x 2))" :value 510]
      ["(name :a)" :value "a"]
      ["(frequencies [])" :value {}]
      ["(pos? (clojure.string/join \"-\" [3 1 2]))" :throws "java.lang.ClassCastException"]
      ["(clojure.string/join \"-\" [3 1 2])" :value "3-1-2"]
