      ["(mapv keyword? (sort-by identity (take 0 (list 1 2))))" :value []]
      ["(sort-by identity (take 0 (list 1 2)))" :value ()]
      ["(take 0 (list 1 2))" :value ()]
      ["(list 1 2)" :value (1 2)]]))]
    (is (= [] found))))

