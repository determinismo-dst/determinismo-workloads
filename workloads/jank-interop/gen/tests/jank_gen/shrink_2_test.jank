;; SPDX-License-Identifier: MIT
;; Generated by workloads/jank-interop/gen/gen.clj from seed 2's failures: each
;; suspect form's subforms, so the smallest one jank answers wrongly is its minimal case.
(ns jank-gen.shrink-2-test
  (:require [clojure.test :refer [deftest is]]
            [clojure.string]))

(defn- ev
  "The form's value, realized, or [:jank-gen/threw what] for any throw jank's handlers can
   see (an object, a native exception or a jank::error_ref): every form gets its own
   verdict. An object's message only: printing an ex-info makes jank crash as it exits
   (jankifier's S1). A thrown string is its own message: ex-message of one throws in jank
   (jankifier's LU62), which ended the test with no verdict (an overflowing inc throws one)."
  [s]
  (try (let [v (eval (read-string s))] (pr-str v) v)
       (catch cpp/jank.runtime.object_ref e [:jank-gen/threw (if (string? e) e (ex-message e))])
       (catch cpp/std.exception e [:jank-gen/threw (str (.what e))])
       (catch cpp/jank.error_ref e [:jank-gen/threw (str (.-message (cpp/* e)))])))

(defn- threw? [v] (and (vector? v) (= :jank-gen/threw (first v))))

(defn- mismatches
  "The cases jank answers differently from Clojure, as {:i index :jank outcome}: one
   assertion a test, so that its failure (the runner reports a test's first) names them all."
  [cases]
  (vec (remove nil? (map-indexed (fn [i [code kind v]]
                                   (let [got (ev code)
                                         same (try (if (= kind :throws) (threw? got) (= v got))
                                                   (catch cpp/jank.runtime.object_ref _ false))]
                                     (when-not same {:i i :jank got})))
                                 cases))))

(deftest s0000-5
  (let [found (mismatches (quote [
      ["(clojure.string/replace (clojure.string/trim (subs \"é-è\" 2)) \" \" \"X\")" :value "è"]
      ["(clojure.string/trim (subs \"é-è\" 2))" :value "è"]
      ["(subs \"é-è\" 2)" :value "è"]]))]
    (is (= [] found))))

(deftest s0003-4
  (let [found (mismatches (quote [
      ["(group-by even? [-3 -3 (* (- -9223372036854775808 1) (- -128 -128))])" :throws "java.lang.ArithmeticException"]
      ["[-3 -3 (* (- -9223372036854775808 1) (- -128 -128))]" :throws "java.lang.ArithmeticException"]
      ["(* (- -9223372036854775808 1) (- -128 -128))" :throws "java.lang.ArithmeticException"]
      ["(- -9223372036854775808 1)" :throws "java.lang.ArithmeticException"]
      ["(- -128 -128)" :value 0]]))]
    (is (= [] found))))

(deftest s0018-8
  (let [found (mismatches (quote [
