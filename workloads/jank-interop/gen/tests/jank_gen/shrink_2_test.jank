(deftest s0042-3
  (let [found (mismatches (quote [
      ["(if (set? (every? odd? (partition-all 3 []))) (nil? (if (coll? (if (some? (if (map? (every? even? [0 1 2 3 4])) -128 (into #{} [0 -1 7 7]))) (let [x 0] (* x 1)) -0.0)) (compare 10 -9223372036854775808) (coll? false))) (let [x 10] (* x (nth (vector 3 (reduce + 0 [0 -1 7 7])) 1))))" :value 130]
      ["(set? (every? odd? (partition-all 3 [])))" :value false]
      ["(every? odd? (partition-all 3 []))" :value true]
      ["(partition-all 3 [])" :value ()]
      ["(nil? (if (coll? (if (some? (if (map? (every? even? [0 1 2 3 4])) -128 (into #{} [0 -1 7 7]))) (let [x 0] (* x 1)) -0.0)) (compare 10 -9223372036854775808) (coll? false)))" :value false]
      ["(if (coll? (if (some? (if (map? (every? even? [0 1 2 3 4])) -128 (into #{} [0 -1 7 7]))) (let [x 0] (* x 1)) -0.0)) (compare 10 -9223372036854775808) (coll? false))" :value false]
      ["(coll? (if (some? (if (map? (every? even? [0 1 2 3 4])) -128 (into #{} [0 -1 7 7]))) (let [x 0] (* x 1)) -0.0))" :value false]
      ["(if (some? (if (map? (every? even? [0 1 2 3 4])) -128 (into #{} [0 -1 7 7]))) (let [x 0] (* x 1)) -0.0)" :value 0]
      ["(some? (if (map? (every? even? [0 1 2 3 4])) -128 (into #{} [0 -1 7 7])))" :value true]
      ["(if (map? (every? even? [0 1 2 3 4])) -128 (into #{} [0 -1 7 7]))" :value #{0 7 -1}]
      ["(map? (every? even? [0 1 2 3 4]))" :value false]
      ["(every? even? [0 1 2 3 4])" :value false]
      ["(into #{} [0 -1 7 7])" :value #{0 7 -1}]
      ["(let [x 0] (* x 1))" :value 0]
      ["(compare 10 -9223372036854775808)" :value 1]
      ["(coll? false)" :value false]
      ["(let [x 10] (* x (nth (vector 3 (reduce + 0 [0 -1 7 7])) 1)))" :value 130]
      ["(nth (vector 3 (reduce + 0 [0 -1 7 7])) 1)" :value 13]
      ["(vector 3 (reduce + 0 [0 -1 7 7]))" :value [3 13]]
      ["(reduce + 0 [0 -1 7 7])" :value 13]]))]
    (is (= [] found))))

