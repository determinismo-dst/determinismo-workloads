      ["(vector (* (first (vector (first (vector 3)))) -9223372036854775808))" :throws "java.lang.ArithmeticException"]
      ["(* (first (vector (first (vector 3)))) -9223372036854775808)" :throws "java.lang.ArithmeticException"]
      ["(first (vector (first (vector 3))))" :value 3]
      ["(vector (first (vector 3)))" :value [3]]
      ["(first (vector 3))" :value 3]
      ["(vector 3)" :value [3]]]))]
    (is (= [] found))))

