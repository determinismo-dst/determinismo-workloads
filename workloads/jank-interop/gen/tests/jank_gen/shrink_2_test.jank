      ["(seq? (mapv (fn [x] (* x 2)) []))" :value false]
      ["(mapv (fn [x] (* x 2)) [])" :value []]
      ["(- 255 255)" :value 0]
      ["(assoc (select-keys (frequencies [1 1 1]) [:a]) :k/v (count (into [] [1 1 1])))" :value {:k/v 3}]
      ["(select-keys (frequencies [1 1 1]) [:a])" :value {}]
      ["(frequencies [1 1 1])" :value {1 3}]
      ["(count (into [] [1 1 1]))" :value 3]
      ["(into [] [1 1 1])" :value [1 1 1]]]))]
    (is (= [] found))))

