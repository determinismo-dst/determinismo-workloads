      ["(reduce + 0 (list 1 2))" :value 3]
      ["(list 1 2)" :value (1 2)]
      ["(compare (subs \"hello\" 0) (subs \"😀\" 0 2))" :value -55253]
      ["(subs \"hello\" 0)" :value "hello"]
      ["(subs \"😀\" 0 2)" :value "😀"]]))]
    (is (= [] found))))

