      ["(compare (str (str (get \"a😀b\" 2) (clojure.string/capitalize \"日本語\")) :b) (clojure.string/lower-case (clojure.string/replace \"a b\" \"a\" \"\")))" :value 56800]
      ["(str (str (get \"a😀b\" 2) (clojure.string/capitalize \"日本語\")) :b)" :value "?日本語:b"]
      ["(str (get \"a😀b\" 2) (clojure.string/capitalize \"日本語\"))" :value "?日本語"]
      ["(get \"a😀b\" 2)" :value \?]
      ["(clojure.string/capitalize \"日本語\")" :value "日本語"]
      ["(clojure.string/lower-case (clojure.string/replace \"a b\" \"a\" \"\"))" :value " b"]
      ["(clojure.string/replace \"a b\" \"a\" \"\")" :value " b"]]))]
    (is (= [] found))))

