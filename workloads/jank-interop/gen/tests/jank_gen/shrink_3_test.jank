      ["(max 9223372036854775807 (compare (subs \"hello\" 0) (subs \"ü\" 0 2)))" :throws "java.lang.StringIndexOutOfBoundsException"]
      ["(compare (subs \"hello\" 0) (subs \"ü\" 0 2))" :throws "java.lang.StringIndexOutOfBoundsException"]
      ["(subs \"hello\" 0)" :value "hello"]
      ["(subs \"ü\" 0 2)" :throws "java.lang.StringIndexOutOfBoundsException"]
      ["(dec (count (str (get \"日本語\" 2) (clojure.string/capitalize \"é\"))))" :value 2]
      ["(count (str (get \"日本語\" 2) (clojure.string/capitalize \"é\")))" :value 3]
      ["(str (get \"日本語\" 2) (clojure.string/capitalize \"é\"))" :value "語É"]
