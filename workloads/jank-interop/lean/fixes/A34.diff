+
+namespace jank::runtime
+{
+  object_ref to_exception_object(error_ref const e)
+  {
+    auto const ret{ make_box<obj::exception_info>(e) };
+    if(ret->message.empty())
+    {
+      ret->message = e->message;
+    }
+    if(!ret->cause.is_some() && e->cause)
+    {
+      ret->cause = expect_object<obj::exception_info>(to_exception_object(e->cause.as_ref()));
+    }
+    return ret.erase();
+  }
+
+  object_ref to_exception_object(std::exception const &e)
+  {
+    return make_box<obj::exception_info>(jtl::immutable_string{ e.what() }, jank_nil).erase();
+  }
+}
