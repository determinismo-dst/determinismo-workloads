+  /* Long/valueOf's grammar, which parse-long documents: [+-]?[0-9]+, nothing else. */
+  static bool is_long_text(std::string_view const s)
+  {
+    usize i{};
+    if(i < s.size() && (s[i] == '+' || s[i] == '-'))
+    {
+      ++i;
+    }
+    if(i == s.size())
+    {
+      return false;
+    }
+    for(; i < s.size(); ++i)
+    {
+      if(s[i] < '0' || s[i] > '9')
+      {
+        return false;
+      }
+    }
+    return true;
+  }
