+  /* Double/valueOf's grammar (java.lang.Double#valueOf): trimmed of characters <= ' ', an
+   * optional sign, then NaN, Infinity, a decimal (digits, an optional fraction, an optional
+   * exponent) or a hex float with a binary exponent, then an optional f/F/d/D. Returns the
+   * text strtod should read, or none. */
+  static jtl::option<std::string> java_double_text(std::string_view s)
+  {
+    while(!s.empty() && static_cast<unsigned char>(s.front()) <= ' ')
+    {
+      s.remove_prefix(1);
+    }
+    while(!s.empty() && static_cast<unsigned char>(s.back()) <= ' ')
+    {
+      s.remove_suffix(1);
+    }
+    usize i{};
+    std::string sign;
+    if(i < s.size() && (s[i] == '+' || s[i] == '-'))
+    {
+      sign = s[i];
+      ++i;
+    }
+    auto const rest{ s.substr(i) };
+    if(rest == "NaN" || rest == "Infinity")
+    {
+      return sign + (rest == "NaN" ? "nan" : "inf");
+    }
+    auto body{ rest };
+    if(!body.empty()
+       && (body.back() == 'f' || body.back() == 'F' || body.back() == 'd' || body.back() == 'D'))
+    {
+      body.remove_suffix(1);
+    }
+    auto const digits_at = [&](usize j, bool const hex) {
+      usize n{};
+      while(j + n < body.size()
+            && (hex ? std::isxdigit(static_cast<unsigned char>(body[j + n]))
+                    : std::isdigit(static_cast<unsigned char>(body[j + n]))))
+      {
+        ++n;
+      }
+      return n;
+    };
+    bool const hex{ body.size() >= 2 && body[0] == '0' && (body[1] == 'x' || body[1] == 'X') };
+    usize j{ hex ? 2u : 0u };
+    auto const int_digits{ digits_at(j, hex) };
+    j += int_digits;
+    usize frac_digits{};
+    if(j < body.size() && body[j] == '.')
+    {
+      ++j;
+      frac_digits = digits_at(j, hex);
+      j += frac_digits;
+    }
+    if(int_digits + frac_digits == 0)
+    {
+      return jtl::none;
+    }
+    bool const has_exponent{ j < body.size()
+                             && (hex ? (body[j] == 'p' || body[j] == 'P')
+                                     : (body[j] == 'e' || body[j] == 'E')) };
+    if(hex && !has_exponent)
+    {
+      return jtl::none;
+    }
+    if(has_exponent)
+    {
+      ++j;
+      if(j < body.size() && (body[j] == '+' || body[j] == '-'))
+      {
+        ++j;
+      }
+      auto const exp_digits{ digits_at(j, false) };
+      if(exp_digits == 0)
+      {
+        return jtl::none;
+      }
+      j += exp_digits;
+    }
+    if(j != body.size())
+    {
+      return jtl::none;
+    }
+    return sign + std::string{ body };
+  }
