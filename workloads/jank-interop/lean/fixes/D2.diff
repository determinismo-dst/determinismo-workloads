+  namespace detail
+  {
+    template <typename T>
+    concept integral_operand = (std::is_integral_v<T> && !jtl::is_same<T, bool>);
+
+    template <typename T>
+    concept exact_integer_operand = (integral_operand<T> || jtl::is_same<T, native_big_integer>);
+
+    /* Clojure's `/` on integers (Numbers.divide): the exact quotient, a ratio unless it
+     * divides; a long from two longs (LongOps.divide), a BigInt when a BigInt takes part
+     * (BigIntOps.divide); dividing by zero throws. Other operand types keep their `/`. */
+    template <typename L, typename R>
+    [[gnu::always_inline]]
+    inline auto checked_div(L const &l, R const &r)
+    {
+      if constexpr(exact_integer_operand<L> && exact_integer_operand<R>)
+      {
+        if(r == 0)
+        {
+          throw make_box("Divide by zero").erase();
+        }
+        native_big_integer const n{ l }, d{ r };
+        obj::ratio_data const data{ n, d };
+        if(data.denominator != 1)
+        {
+          return make_box<obj::ratio>(data).erase();
+        }
+        if constexpr(integral_operand<L> && integral_operand<R>)
+        {
+          /* LongOps.divide hands Long/MIN_VALUE to BigIntOps. */
+          native_big_integer const min{ std::numeric_limits<i64>::min() };
+          if(n != min && d != min)
+          {
+            return make_box(static_cast<i64>(data.numerator)).erase();
+          }
+        }
+        return make_box<obj::big_integer>(data.numerator).erase();
+      }
+      else
+      {
+        return l / r;
+      }
+    }
+  }
