+  static object_ref negate_number(object_ref const o, bool const promote)
+  {
+    return visit_number_like(
+      [promote](auto const typed_o) -> object_ref {
+        using T = typename jtl::decay_t<decltype(typed_o)>::value_type;
+
+        if constexpr(jtl::is_same<T, obj::integer>)
+        {
+          if(typed_o->data == std::numeric_limits<i64>::min())
+          {
+            if(promote)
+            {
+              return make_box<obj::big_integer>(native_big_integer{ -native_big_integer{ typed_o->data } });
+            }
+            throw make_box("integer overflow").erase();
+          }
+          return make_box(-typed_o->data);
+        }
+        else if constexpr(jtl::is_same<T, obj::small_integer>)
+        {
+          return make_box(-static_cast<i64>(typed_o->data));
+        }
+        else if constexpr(jtl::is_any_same<T, obj::real, obj::small_real>)
+        {
+          /* A NaN keeps its bits: a negative quiet NaN is not a boxable real (oref.hpp
+           * max_real, D9), and Clojure prints both NaNs alike. */
+          if(std::isnan(typed_o->data))
+          {
+            return typed_o;
+          }
+          return make_box(-typed_o->data);
+        }
+        else if constexpr(jtl::is_same<T, obj::ratio>)
+        {
+          return make_box(
+            obj::ratio_data{ native_big_integer{ -typed_o->data.numerator },
+                             typed_o->data.denominator });
+        }
+        else if constexpr(jtl::is_same<T, obj::big_integer>)
+        {
+          return make_box(native_big_integer{ -typed_o->data });
+        }
+        else
+        {
+          /* big_decimal: its own negation keeps the value's digits (and, with a math
+           * context, rounds as BigDecimal.negate(mc) does). */
+          return make_box(native_big_decimal{ -typed_o->data });
+        }
+      },
+      o);
+  }
+
+  object_ref negate(object_ref const o)
+  {
+    return negate_number(o, false);
+  }
+
+  object_ref promoting_negate(object_ref const o)
+  {
+    return negate_number(o, true);
