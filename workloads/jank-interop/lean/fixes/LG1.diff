+    /* Clojure compares and divides numbers as longs and doubles. A native operand is widened
+     * before C++'s usual arithmetic conversions see it: otherwise an unsigned `usize` from
+     * `count` meets a negative number as a huge unsigned one (`(< -1 (count [1]))` is false,
+     * `(max (count [1]) -1)` is -1). A `usize` that wrapped below zero reads as the negative
+     * long it stands for, as boxing it does (convert<T>::into_object). */
+    template <typename T>
+    requires primitive_number<T>
+    [[gnu::always_inline, gnu::flatten, gnu::hot]]
+    auto widen(T const t)
+    {
+      if constexpr(std::is_integral_v<T>)
+      {
+        return static_cast<i64>(t);
+      }
+      else
+      {
+        return static_cast<f64>(t);
+      }
+    }
+
+    /* Clojure's min and max of two primitive numbers: they are compared as numbers, and the
+     * result is the chosen operand itself, so a long next to a double stays a long. */
+    template <typename L, typename R>
+    [[gnu::always_inline, gnu::flatten, gnu::hot]]
+    auto primitive_min(L const l, R const r)
+    {
+      auto const wl{ widen(l) };
+      auto const wr{ widen(r) };
+      if constexpr(std::is_same_v<decltype(wl), decltype(wr)>)
+      {
+        return std::min(wl, wr);
+      }
+      else
+      {
+        if constexpr(std::is_floating_point_v<decltype(wl)>)
+        {
+          if(std::isnan(wl))
+          {
+            return make_box(wl).erase();
+          }
+        }
+        return wl < wr ? make_box(wl).erase() : make_box(wr).erase();
+      }
+    }
+
+    template <typename L, typename R>
+    [[gnu::always_inline, gnu::flatten, gnu::hot]]
+    auto primitive_max(L const l, R const r)
+    {
+      auto const wl{ widen(l) };
+      auto const wr{ widen(r) };
+      if constexpr(std::is_same_v<decltype(wl), decltype(wr)>)
+      {
+        return std::max(wl, wr);
+      }
+      else
+      {
+        if constexpr(std::is_floating_point_v<decltype(wl)>)
+        {
+          if(std::isnan(wl))
+          {
+            return make_box(wl).erase();
+          }
+        }
+        return wr < wl ? make_box(wl).erase() : make_box(wr).erase();
+      }
+    }
 
