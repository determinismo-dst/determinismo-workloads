+  namespace detail
+  {
+    /* Fixed-width integers take part in Clojure's long arithmetic; bool doesn't. */
+    template <typename T>
+    concept checked_integer = (std::is_integral_v<T> && !jtl::is_same<T, bool>);
+
+    /* Clojure's `+ - *` on longs: the exact result in i64, or an "integer overflow" error
+     * (Numbers.add/minus/multiply, Math.addExact etc.). Two `int`s (literals, small integers)
+     * are combined in i64 as well, since both are Clojure longs. Other operand types keep
+     * their own operators; the operands are taken by reference so that an expression
+     * template (boost) refers to the same objects as the inline expression did. */
+    template <typename L, typename R>
+    [[gnu::always_inline]]
+    inline auto checked_add(L const &l, R const &r)
+    {
+      if constexpr(checked_integer<L> && checked_integer<R>)
+      {
+        i64 res{};
+        if(__builtin_add_overflow(l, r, &res))
+        {
+          throw make_box("integer overflow").erase();
+        }
+        return res;
+      }
+      else
+      {
+        return l + r;
+      }
+    }
+
+    template <typename L, typename R>
+    [[gnu::always_inline]]
+    inline auto checked_sub(L const &l, R const &r)
+    {
+      if constexpr(checked_integer<L> && checked_integer<R>)
+      {
+        i64 res{};
+        if(__builtin_sub_overflow(l, r, &res))
+        {
+          throw make_box("integer overflow").erase();
+        }
+        return res;
+      }
+      else
+      {
+        return l - r;
+      }
+    }
+
+    template <typename L, typename R>
+    [[gnu::always_inline]]
+    inline auto checked_mul(L const &l, R const &r)
+    {
+      if constexpr(checked_integer<L> && checked_integer<R>)
+      {
+        i64 res{};
+        if(__builtin_mul_overflow(l, r, &res))
+        {
+          throw make_box("integer overflow").erase();
+        }
+        return res;
+      }
+      else
+      {
+        return l * r;
+      }
+    }
+  }
