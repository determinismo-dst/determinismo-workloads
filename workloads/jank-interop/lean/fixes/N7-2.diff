+  namespace detail
+  {
+    /* Numbers.divide throws "Divide by zero" for a zero divisor; boost's cpp_dec_float gives inf
+     * or nan instead. So a division with a BigDecimal operand and an exact zero divisor (an
+     * integer, a BigInt or a BigDecimal) throws. A double operand keeps its IEEE result, as
+     * Clojure divides those as doubles. */
+    template <typename L, typename R>
+    [[gnu::always_inline]]
+    inline void check_decimal_divisor(L const &, R const &r)
+    {
+      using LT = std::decay_t<L>;
+      using RT = std::decay_t<R>;
+      constexpr bool has_decimal{ std::is_same_v<LT, native_big_decimal>
+                                  || std::is_same_v<RT, native_big_decimal> };
+      constexpr bool exact_divisor{ std::is_integral_v<RT>
+                                    || std::is_same_v<RT, native_big_integer>
+                                    || std::is_same_v<RT, native_big_decimal> };
+      if constexpr(has_decimal && exact_divisor && !std::is_floating_point_v<LT>)
+      {
+        if(r == 0)
+        {
+          throw make_box("Divide by zero").erase();
+        }
+      }
+    }
+  }
