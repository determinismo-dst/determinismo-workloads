+(defn- take-line
+  "Java's readLine on a session's input: [line in'] with the line's terminator (\\n, \\r or \\r\\n)
+  dropped; at an end of input the rest of the text, or nil when there is none (the end is used up);
+  nil when no line is complete and the input has not ended."
+  [in]
+  (let [text (or (:text in) "")
+        n    (index-of text "\n")
+        r    (index-of text "\r")
+        i    (if (and n r) (min n r) (or n r))]
+    (cond
+      i
+      (let [crlf? (and (= i r) (= (inc i) n))
+            end   (if crlf? (+ i 2) (inc i))]
+        [(subs text 0 i)
+         (assoc in
+                :text (subs text end)
+                :skip-lf (and (= i r) (not crlf?) (= end (count text))))])
