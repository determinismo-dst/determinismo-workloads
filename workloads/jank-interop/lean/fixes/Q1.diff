+;; Each session's *in*, as nREPL's session middleware keeps it (session.clj session-in, add-stdin):
+;; the text its stdin ops sent that is not read yet, :eof once the client ends the input (an empty
+;; stdin), and :skip-lf after a line ended by a \r at the end of the text (so that a \n sent next
+;; completes that \r\n). jank keeps no other session state, so an entry is made on first use.
+(def ^:private session-inputs (atom {}))
+
+(defn- add-input [in text]
+  (let [in (or in {})]
+    (if (empty? text)
+      (assoc in :eof true)
+      (let [text (if (and (:skip-lf in) (starts-with? text "\n")) (subs text 1) text)]
+        (assoc in :text (str (:text in) text) :skip-lf false)))))
