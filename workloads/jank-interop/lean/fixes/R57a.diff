+      if(ka == na)
+      {
+        if(i == a.size())
+        {
+          break;
+        }
+        na = next_utf16_units(a, i, ua);
+        ka = 0;
+      }
+      if(kb == nb)
+      {
+        if(j == b.size())
+        {
+          break;
+        }
+        nb = next_utf16_units(b, j, ub);
+        kb = 0;
+      }
+      if(ua[ka] != ub[kb])
+      {
+        return static_cast<i64>(ua[ka]) - static_cast<i64>(ub[kb]);
+      }
+      ++ka;
+      ++kb;
+    }
+
+    auto rest(static_cast<i64>(na - ka) - static_cast<i64>(nb - kb));
+    while(i < a.size())
+    {
