+  /* The UTF-16 code units of the character at byte i (1 or 2), advancing i past it. A byte that
+   * does not start a complete character stands for itself as 0xDC00 + byte, a lone low surrogate no
+   * valid text decodes to, so only equal bytes compare equal. */
+  static usize next_utf16_units(jtl::immutable_string const &d, usize &i, char16_t (&units)[2])
+  {
+    auto const b0(static_cast<u8>(d[i]));
+    usize n{ b0 < 0x80               ? 1u
+             : (b0 & 0xE0) == 0xC0 ? 2u
+             : (b0 & 0xF0) == 0xE0 ? 3u
+             : (b0 & 0xF8) == 0xF0 ? 4u
+                                   : 0u };
+    if(n > d.size() - i)
+    {
+      n = 0;
+    }
+    for(usize k{ 1 }; k < n; ++k)
+    {
+      if((static_cast<u8>(d[i + k]) & 0xC0) != 0x80)
+      {
+        n = 0;
+        break;
+      }
+    }
+    if(n == 0)
+    {
+      ++i;
+      units[0] = static_cast<char16_t>(0xDC00 + b0);
+      return 1;
+    }
+
+    char32_t cp{ n == 1 ? b0 : static_cast<char32_t>(b0 & (0x7Fu >> n)) };
+    for(usize k{ 1 }; k < n; ++k)
+    {
+      cp = (cp << 6) | (static_cast<u8>(d[i + k]) & 0x3Fu);
+    }
+    i += n;
+    if(cp < 0x10000)
+    {
+      units[0] = static_cast<char16_t>(cp);
+      return 1;
+    }
+    cp -= 0x10000;
+    units[0] = static_cast<char16_t>(0xD800 + (cp >> 10));
+    units[1] = static_cast<char16_t>(0xDC00 + (cp & 0x3FF));
+    return 2;
+  }
