+
+    native_big_decimal divide(native_big_decimal const &l,
+                              native_big_decimal const &r,
+                              math_context const &mc)
+    {
+      if(r.is_zero())
+      {
+        throw_arithmetic_error("Divide by zero");
+      }
+      return mc.precision == 0 ? exact_quotient(l, r) : context_divide(l, r, mc);
+    }
+
+    native_big_decimal divide_to_integral_value(native_big_decimal const &l,
+                                                native_big_decimal const &r,
+                                                math_context const &mc)
+    {
+      if(r.is_zero())
+      {
+        throw_arithmetic_error("Divide by zero");
+      }
+      i64 const preferred{ static_cast<i64>(l.scale) - r.scale };
+      if(compare_magnitude(l, r) < 0)
+      {
+        return make(big{}, saturate(preferred));
+      }
+      if(mc.precision == 0)
+      {
+        /* The integer part t of the exact quotient, at max(preferred, -trailingZeros(t)). */
+        i64 const shift{ static_cast<i64>(r.scale) - l.scale };
+        big const n{ shift >= 0 ? big{ l.unscaled * pow10_value(shift) } : l.unscaled };
+        big const d{ shift >= 0 ? r.unscaled : big{ r.unscaled * pow10_value(-shift) } };
+        big const t{ n / d };
+        i64 const scale{ std::max(preferred, -trailing_zeros(t)) };
+        return make(scale >= 0 ? big{ t * pow10_value(scale) } : big{ t / pow10_value(-scale) },
+                    scale);
+      }
+      native_big_decimal result{ context_divide(l, r, { mc.precision, rounding_mode::down }) };
+      if(result.scale < 0)
+      {
+        auto const product{ exact_multiply(result, r) };
+        if(compare_magnitude(exact_add(l, exact_negate(product)), r) >= 0)
+        {
+          throw_arithmetic_error("Division impossible");
+        }
+      }
+      else if(result.scale > 0)
+      {
+        result = set_scale_down_to_zero(result);
+      }
+      i64 const precision_diff{ static_cast<i64>(mc.precision) - result.precision() };
+      if(preferred > result.scale && precision_diff > 0)
+      {
+        i64 const add{ std::min(precision_diff, preferred - result.scale) };
+        return make(result.unscaled * pow10_value(add), static_cast<i64>(result.scale) + add);
+      }
+      return strip_to_scale(result.unscaled, result.scale, preferred);
+    }
+
+    native_big_decimal remainder(native_big_decimal const &l,
+                                 native_big_decimal const &r,
+                                 math_context const &mc)
+    {
+      auto const q{ divide_to_integral_value(l, r, mc) };
+      return exact_add(l, exact_negate(exact_multiply(q, r)));
+    }
