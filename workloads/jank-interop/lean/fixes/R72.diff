+      if(l.is_zero())
+      {
+        return make(big{}, saturate(preferred));
+      }
+      /* l / r = (a / b) * 10^-preferred; a / b reduced to n / d terminates exactly when d has no
+       * prime factor but 2 and 5, and then n / d = q * 10^-k with k = max(twos, fives). Such a q
+       * has no trailing zero when k > 0, so the scale preferred + k is Java's: the preferred scale
+       * raised to the exact quotient's least scale. */
+      big const a{ big_abs(l.unscaled) };
+      big const b{ big_abs(r.unscaled) };
+      big const g{ boost::multiprecision::gcd(a, b) };
+      big n{ a / g };
+      big d{ b / g };
+      i64 twos{};
+      i64 fives{};
+      while((d & 1) == 0)
+      {
+        d >>= 1;
+        ++twos;
+      }
+      big q, rem;
+      while(true)
+      {
+        boost::multiprecision::divide_qr(d, big{ 5 }, q, rem);
+        if(rem != 0)
+        {
+          break;
+        }
+        d = q;
+        ++fives;
+      }
+      if(d != 1)
+      {
+        throw_arithmetic_error(
+          "Non-terminating decimal expansion; no exact representable decimal result.");
+      }
+      i64 const k{ std::max(twos, fives) };
+      n *= boost::multiprecision::pow(big{ 2 }, static_cast<unsigned>(k - twos))
+        * boost::multiprecision::pow(big{ 5 }, static_cast<unsigned>(k - fives));
+      if(l.sign() != r.sign())
+      {
+        n = -n;
+      }
+      return make(n, preferred + k);
+    }
+
+    /* BigDecimal.divide(divisor, mc) with a precision. */
+    native_big_decimal context_divide(native_big_decimal const &l,
+                                      native_big_decimal const &r,
+                                      math_context const &mc)
+    {
+      i64 const preferred{ static_cast<i64>(l.scale) - r.scale };
+      if(l.is_zero())
+      {
+        return make(big{}, saturate(preferred));
+      }
+      bool const negative{ l.sign() != r.sign() };
+      big const a{ big_abs(l.unscaled) };
+      big const b{ big_abs(r.unscaled) };
+      i64 const p{ mc.precision };
+      big const low{ pow10(static_cast<u64>(p - 1)) };
+      big const high{ pow10(static_cast<u64>(p)) };
+      /* |l / r| * 10^(preferred + t) = a * 10^t / b: find t giving p digits before the point. */
+      i64 t{ p - digit_count(a) + digit_count(b) };
+      big n, d, q;
+      while(true)
+      {
+        n = t >= 0 ? big{ a * pow10_value(t) } : a;
+        d = t >= 0 ? b : big{ b * pow10_value(-t) };
+        q = n / d;
+        if(q >= high)
+        {
+          --t;
+        }
+        else if(q < low)
+        {
+          ++t;
+        }
+        else
+        {
+          break;
+        }
+      }
+      bool const exact{ q * d == n };
+      big u{ round_quotient(n, d, mc.mode, negative) };
+      i64 scale{ preferred + t };
+      if(u == high)
+      {
+        u = low;
+        --scale;
+      }
+      if(negative)
+      {
+        u = -u;
+      }
+      if(exact)
+      {
+        /* The exact quotient in at most p digits: the scale closest to the preferred one. */
+        return strip_to_scale(u, scale, preferred);
+      }
+      return make(u, scale);
+    }
+
+    native_big_decimal set_scale_down_to_zero(native_big_decimal const &x)
+    {
+      /* setScale(0, RoundingMode.DOWN) of a scale > 0. */
+      return make(big{ x.unscaled / pow10_value(x.scale) }, 0);
+    }
+  }
