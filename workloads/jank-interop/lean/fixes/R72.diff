+  /* new BigDecimal(String): [+-]? (digits [. digits?] | . digits) ([eE] [+-]? digits)?; the
+   * value is the digits as an integer, at scale (fraction digits - exponent). */
+  native_big_decimal::native_big_decimal(char const * const s)
+  {
+    std::string_view const text{ s };
+    auto const invalid = [&]() {
+      std::string const message{ "Invalid BigDecimal: \"" + std::string{ text } + "\"" };
+      throw_arithmetic_error(message.c_str());
+    };
+    usize i{};
+    bool negative{};
+    if(i < text.size() && (text[i] == '+' || text[i] == '-'))
+    {
+      negative = text[i] == '-';
+      ++i;
+    }
+    std::string digits;
+    i64 fraction{};
+    bool point{};
+    for(; i < text.size(); ++i)
+    {
+      char const c{ text[i] };
+      if(c >= '0' && c <= '9')
+      {
+        digits.push_back(c);
+        fraction += point ? 1 : 0;
+      }
+      else if(c == '.' && !point)
+      {
+        point = true;
+      }
+      else
+      {
+        break;
+      }
+    }
+    if(digits.empty())
+    {
+      invalid();
+    }
+    i64 exponent{};
+    if(i < text.size() && (text[i] == 'e' || text[i] == 'E'))
+    {
+      ++i;
+      bool exponent_negative{};
+      if(i < text.size() && (text[i] == '+' || text[i] == '-'))
+      {
+        exponent_negative = text[i] == '-';
+        ++i;
+      }
+      usize exponent_digits{};
+      for(; i < text.size() && text[i] >= '0' && text[i] <= '9'; ++i, ++exponent_digits)
+      {
+        exponent = exponent * 10 + (text[i] - '0');
+        if(exponent > std::numeric_limits<i32>::max() + 1ll)
+        {
+          invalid();
+        }
+      }
+      if(exponent_digits == 0)
+      {
+        invalid();
+      }
+      exponent = exponent_negative ? -exponent : exponent;
+    }
+    if(i != text.size())
+    {
+      invalid();
+    }
+    auto const first{ digits.find_first_not_of('0') };
+    unscaled = first == std::string::npos ? big{} : big{ digits.substr(first) };
+    if(negative)
+    {
+      unscaled = -unscaled;
+    }
+    i64 const new_scale{ fraction - exponent };
+    if(new_scale > std::numeric_limits<i32>::max() || new_scale < std::numeric_limits<i32>::min())
+    {
+      invalid();
+    }
+    scale = static_cast<i32>(new_scale);
+  }
