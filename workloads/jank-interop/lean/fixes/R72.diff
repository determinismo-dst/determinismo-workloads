+    native_big_decimal value_of(f64 const d)
+    {
+      if(!std::isfinite(d))
+      {
+        throw_arithmetic_error("Infinite or NaN");
+      }
+      if(d == 0.0)
+      {
+        /* Double.toString: "0.0". */
+        return make(big{}, 1);
+      }
+      /* The shortest digits D1...Dn and exponent E of Double.toString, then its layout: plain
+       * "I.F" for 1e-3 <= |d| < 1e7 (scale max(n - 1 - E, 1)), else "D.FFFE<E>" with at least
+       * one fraction digit (scale max(n - 1, 1) - E). */
+      std::array<char, 64> buf{};
+      auto const res{
+        std::to_chars(buf.data(), buf.data() + buf.size(), std::fabs(d), std::chars_format::scientific)
+      };
+      std::string_view const text{ buf.data(), static_cast<usize>(res.ptr - buf.data()) };
+      auto const e_pos{ text.find('e') };
+      std::string digits;
+      for(usize i{}; i < e_pos; ++i)
+      {
+        if(text[i] != '.')
+        {
+          digits.push_back(text[i]);
+        }
+      }
+      i64 const exponent{ std::stoll(std::string{ text.substr(e_pos + 1) }) };
+      i64 const n{ static_cast<i64>(digits.size()) };
+      f64 const magnitude{ std::fabs(d) };
+      i64 scale{};
+      if(magnitude >= 1e-3 && magnitude < 1e7)
+      {
+        scale = std::max<i64>(n - 1 - exponent, 1);
+      }
+      else
+      {
+        scale = std::max<i64>(n - 1, 1) - exponent;
+      }
+      /* The digits at that scale: D * 10^(scale - (n - 1 - E)), which is >= 0. */
+      big u{ big{ digits } * pow10_value(scale - (n - 1 - exponent)) };
+      return make(d < 0 ? big{ -u } : u, scale);
+    }
+
+    u32 hasheq(native_big_decimal const &x)
+    {
+      if(x.is_zero())
+      {
+        return 0;
+      }
+      /* stripTrailingZeros().hashCode() = 31 * BigInteger.hashCode(unscaled) + scale. */
+      big u{ x.unscaled };
+      i64 scale{ x.scale };
+      big q, r;
+      while(true)
+      {
+        boost::multiprecision::divide_qr(u, big{ 10 }, q, r);
+        if(r != 0)
+        {
+          break;
+        }
+        u = q;
+        --scale;
+      }
+      /* BigInteger.hashCode: the magnitude's 32-bit words, most significant first, h = 31h + w,
+       * then times the signum, in int (u32) arithmetic. */
+      big magnitude{ big_abs(u) };
+      std::vector<u32> words;
+      while(magnitude != 0)
+      {
+        words.push_back(static_cast<u32>(
+          big{ magnitude & big{ 0xFFFFFFFFu } }.template convert_to<unsigned long long>()));
+        magnitude >>= 32;
+      }
+      u32 h{};
+      for(auto it{ words.rbegin() }; it != words.rend(); ++it)
+      {
+        h = 31u * h + *it;
+      }
+      if(u < 0)
+      {
+        h = 0u - h;
+      }
+      return 31u * h + static_cast<u32>(static_cast<i32>(scale));
+    }
+  }
