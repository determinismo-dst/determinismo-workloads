+  /* BigDecimal.toString: plain when scale >= 0 and the adjusted exponent >= -6, else scientific
+   * with one digit before the point and E+n / E-n. */
+  std::string native_big_decimal::str() const
+  {
+    std::string const coefficient{ big_abs(unscaled).str() };
+    std::string ret{ unscaled < 0 ? "-" : "" };
+    i64 const length{ static_cast<i64>(coefficient.size()) };
+    i64 const adjusted{ -static_cast<i64>(scale) + (length - 1) };
+    if(scale == 0)
+    {
+      return ret + coefficient;
+    }
+    if(scale > 0 && adjusted >= -6)
+    {
+      i64 const point{ length - scale };
+      if(point > 0)
+      {
+        ret += coefficient.substr(0, static_cast<usize>(point));
+        ret += '.';
+        ret += coefficient.substr(static_cast<usize>(point));
+      }
+      else
+      {
+        ret += "0.";
+        ret.append(static_cast<usize>(-point), '0');
+        ret += coefficient;
+      }
+      return ret;
+    }
+    ret += coefficient[0];
+    if(length > 1)
+    {
+      ret += '.';
+      ret += coefficient.substr(1);
+    }
+    ret += 'E';
+    if(adjusted > 0)
+    {
+      ret += '+';
+    }
+    ret += std::to_string(adjusted);
+    return ret;
+  }
+
+  f64 native_big_decimal::to_double() const
+  {
+    if(is_zero())
+    {
+      return 0.0;
+    }
+    /* strtod rounds the exact decimal text once, as doubleValue does. */
+    auto const text{ unscaled.str() + "e" + std::to_string(-static_cast<i64>(scale)) };
+    return std::strtod(text.c_str(), nullptr);
+  }
+
+  native_big_integer native_big_decimal::to_big_integer() const
+  {
+    if(scale <= 0)
+    {
+      return unscaled * pow10_value(-static_cast<i64>(scale));
+    }
+    return unscaled / pow10_value(scale);
+  }
