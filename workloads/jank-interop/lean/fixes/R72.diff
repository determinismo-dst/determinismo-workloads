+    native_big_decimal round(native_big_decimal const &x, math_context const &mc)
+    {
+      if(mc.precision == 0)
+      {
+        return x;
+      }
+      i64 const p{ mc.precision };
+      i64 const digits{ x.precision() };
+      if(digits <= p)
+      {
+        return x;
+      }
+      i64 const drop{ digits - p };
+      big u{ round_quotient(big_abs(x.unscaled),
+                            pow10_value(drop),
+                            mc.mode,
+                            x.sign() < 0) };
+      i64 scale{ static_cast<i64>(x.scale) - drop };
+      if(u == pow10(static_cast<u64>(p)))
+      {
+        u = pow10(static_cast<u64>(p - 1));
+        --scale;
+      }
+      return make(x.sign() < 0 ? big{ -u } : u, scale);
+    }
+
+    native_big_decimal add(native_big_decimal const &l,
+                           native_big_decimal const &r,
+                           math_context const &mc)
