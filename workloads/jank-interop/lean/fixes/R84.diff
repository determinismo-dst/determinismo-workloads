+  /* Appends a replacement string's expansion for one match, by the rules of Java's
+   * Matcher.appendReplacement, which clojure.string/replace follows: `\x` is a literal x, and
+   * `$n` is group n, taking further digits while the number names a group. An unmatched group
+   * expands to nothing. */
+  static void append_replacement(jtl::string_builder &buff,
+                                 std::smatch const &match_results,
+                                 jtl::immutable_string const &replacement)
+  {
+    auto const size(replacement.size());
+    auto const group_count(match_results.size() - 1);
+    usize i{};
+    while(i < size)
+    {
+      auto const c(replacement[i]);
+      if(c == '\\')
+      {
+        ++i;
+        if(i == size)
+        {
+          throw std::runtime_error{ "character to be escaped is missing" };
+        }
+        buff(replacement[i]);
+        ++i;
+      }
+      else if(c == '$')
+      {
+        ++i;
+        if(i == size)
+        {
+          throw std::runtime_error{ "Illegal group reference: group index is missing" };
+        }
+        if(replacement[i] < '0' || replacement[i] > '9')
+        {
+          throw std::runtime_error{ "Illegal group reference" };
+        }
+        auto group(static_cast<usize>(replacement[i] - '0'));
+        ++i;
+        while(i < size && replacement[i] >= '0' && replacement[i] <= '9')
+        {
+          auto const next_group((group * 10) + static_cast<usize>(replacement[i] - '0'));
+          if(group_count < next_group)
+          {
+            break;
+          }
+          group = next_group;
+          ++i;
+        }
+        if(group_count < group)
+        {
+          throw std::runtime_error{ util::format("No group {}", group) };
+        }
+        if(match_results[group].matched)
+        {
+          buff(match_results[group].str());
+        }
+      }
+      else
+      {
+        buff(c);
+        ++i;
+      }
+    }
   }
 
