   i64 keyword::compare(object const &o) const
   {
+    /* A keyword compares only with a keyword; Clojure throws a ClassCastException otherwise.
+     * Thrown as an object, so a program's catch sees it. */
+    if(o.type != object_type::keyword)
+    {
+      throw make_box(util::format("Objects of type `{}` are not comparable to `keyword`.",
+                                  object_type_str(o.type)))
+        .erase();
+    }
     return compare(*expect_object<keyword>(runtime::detail::untagged(&o)));
   }
 
