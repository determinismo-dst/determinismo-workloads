+  /* An arithmetic result on ratios (Numbers.divide(BigInteger, BigInteger), RatioOps): a
+   * BigInt when it is integral, never a long. ratio::create stays as the reader's (4/2 is 2). */
+  static object_ref arith_result(native_big_integer const &numerator,
+                                 native_big_integer const &denominator)
+  {
+    ratio_data const data{ numerator, denominator };
+    if(data.denominator == 1)
+    {
+      return make_box<big_integer>(data.numerator);
+    }
+    return make_box<ratio>(data);
+  }
