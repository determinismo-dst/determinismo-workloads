+    if(numerator == 0)
+    {
+      return 0.0;
+    }
+    native_big_integer const n{ numerator < 0 ? native_big_integer{ -numerator } : numerator };
+    native_big_integer const ten{ 10 };
+    native_big_integer const low{ boost::multiprecision::pow(ten, 15u) };
+    native_big_integer const high{ boost::multiprecision::pow(ten, 16u) };
