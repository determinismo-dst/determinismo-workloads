+    native_big_integer q, r, den;
+    while(true)
+    {
+      native_big_integer num{ n };
+      den = denominator;
+      if(k >= 0)
+      {
+        num *= boost::multiprecision::pow(ten, static_cast<unsigned>(k));
+      }
+      else
+      {
+        den *= boost::multiprecision::pow(ten, static_cast<unsigned>(-k));
+      }
+      q = num / den;
+      r = num % den;
+      if(q >= high)
+      {
+        --k;
+      }
+      else if(q < low)
+      {
+        ++k;
+      }
+      else
+      {
+        break;
+      }
+    }
+    native_big_integer const twice{ r * 2 };
+    if(twice > den || (twice == den && q % 2 == 1))
+    {
+      ++q;
+    }
+    if(q == high)
+    {
+      q = low;
+      --k;
+    }
+    std::string text{ numerator < 0 ? "-" : "" };
+    text += q.str();
+    text += 'e';
+    text += std::to_string(-k);
