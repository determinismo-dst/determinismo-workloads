-  static native_big_decimal to_native_big_decimal(ratio const &r)
+  /* Numbers.toBigDecimal of a ratio, which BigDecimalOps applies whenever a ratio meets a
+   * BigDecimal: numerator.divide(denominator) with no MathContext, so the exact decimal, or an
+   * ArithmeticException when the expansion doesn't terminate (the reduced denominator has a
+   * prime factor other than 2 and 5): (< 2.5M 7/3) and (+ 1/3 1M) throw, (+ 1/2 1M) is 1.5M. */
+  static native_big_decimal to_exact_native_big_decimal(ratio_data const &r)
   {
-    return to_native_big_decimal(r.data);
+    native_big_integer rest{ r.denominator };
+    i64 twos{}, fives{};
+    while(rest % 2 == 0)
+    {
+      rest /= 2;
+      ++twos;
+    }
+    while(rest % 5 == 0)
+    {
+      rest /= 5;
+      ++fives;
+    }
+    if(rest != 1)
+    {
+      throw make_box("Non-terminating decimal expansion; no exact representable decimal result.")
+        .erase();
+    }
+    /* n / (2^a 5^b) = n 2^(k-a) 5^(k-b) / 10^k with k = max(a, b). */
+    auto const k{ std::max(twos, fives) };
+    native_big_integer digits{ r.numerator };
+    for(auto i{ twos }; i < k; ++i)
+    {
+      digits *= 2;
+    }
+    for(auto i{ fives }; i < k; ++i)
+    {
+      digits *= 5;
+    }
+    auto const text{ digits.str() + "e-" + std::to_string(k) };
+    return native_big_decimal(text.c_str());
   }
 
