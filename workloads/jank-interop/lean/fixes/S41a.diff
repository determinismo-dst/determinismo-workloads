+/* Clojure's RT.map and RT.set (createWithCheck) throw when a map or set expression's keys
+ * collide at run time; literal duplicates are already read errors. */
+[[noreturn]]
+static void _jank_throw_duplicate_key(jank::runtime::object_ref const key)
+{
+  throw jank::runtime::make_box(jank::util::format("Duplicate key: {}", key.to_code_string()))
+    .erase();
+}
 
