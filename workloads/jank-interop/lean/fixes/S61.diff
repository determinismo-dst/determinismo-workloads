 namespace jank::runtime::obj::detail
@@ -181,6 +182,24 @@ namespace jank::runtime::obj::detail
 
     if(head.get_type() != object_type::persistent_vector)
     {
+      /* Clojure's APersistentMap.cons also takes a seq of entries (an empty one included),
+       * and assocs each in turn. jank's map entries are two-element vectors. */
+      if(is_seqable(head))
+      {
+        object_ref acc{ ret };
+        for(auto const e : make_sequence_range(head))
+        {
+          if(e.get_type() != object_type::persistent_vector
+             || expect_object<obj::persistent_vector>(e)->count() != 2)
+          {
+            throw std::runtime_error{ util::format("invalid map entry: '{}'", e.to_code_string()) };
+          }
+          auto const entry(expect_object<obj::persistent_vector>(e));
+          acc = runtime::assoc(acc, entry->data[0], entry->data[1]);
+        }
+        return acc;
+      }
+
       throw std::runtime_error{ util::format("invalid map entry: '{}'",
                                              runtime::object_type_str(head.get_type())) };
     }
