 namespace jank::runtime
 {
+  static bool is_do_form(object_ref const o)
+  {
+    if(!o.has_behavior(object_behavior::sequence_like))
+    {
+      return false;
+    }
+    auto const head{ runtime::first(o) };
+    if(head.get_type() != object_type::symbol)
+    {
+      return false;
+    }
+    auto const sym{ expect_object<obj::symbol>(head) };
+    return sym->ns.empty() && sym->name == "do";
+  }
+
+  /* As Clojure's Compiler.eval: a top-level (do ...) is evaluated form by form, so each form
+   * sees the macros, vars, aliases and namespace that the forms before it made. */
+  static object_ref
+  eval_top_level(object_ref const form, analyze::expression_position const position)
+  {
+    if(is_do_form(form))
+    {
+      object_ref ret{};
+      for(auto const e : make_sequence_range(runtime::rest(form)))
+      {
+        ret = eval_top_level(e, position);
+      }
+      return ret;
+    }
+
+    analyze::processor an_prc;
+    auto const expr(analyze::pass::optimize(an_prc.analyze(form, position).expect_ok()));
+    return evaluate::eval(expr);
+  }
