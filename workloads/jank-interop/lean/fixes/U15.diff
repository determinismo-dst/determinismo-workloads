+    auto const bindings{ __rt_ctx->get_thread_bindings() };
+    auto ret{ obj::persistent_hash_map::empty() };
+    for(auto const &e : bindings->data)
+    {
+      auto const val(e.second.get_type() == object_type::var_thread_binding
