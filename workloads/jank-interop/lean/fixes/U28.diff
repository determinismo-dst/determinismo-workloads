+
+  iterator_ref iterator::with_meta(object_ref const m) const
+  {
+    auto const meta(behavior::detail::validate_meta(m));
+    auto const ret(make_box<iterator>(fn, current));
+    /* Share the realized next, as Clojure's Iterate.withMeta does, so fn isn't called again. */
+    ret->cached_next.store(cached_next.load());
+    ret->meta = meta;
+    return ret;
+  }
+
+  object_ref iterator::get_meta() const
+  {
+    return meta.get();
+  }
+
+  void iterator::set_meta(object_ref const o)
+  {
+    auto const new_meta(behavior::detail::validate_meta(o));
+    meta.set(new_meta);
+  }
