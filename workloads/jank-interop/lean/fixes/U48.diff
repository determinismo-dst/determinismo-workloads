+(defn- resource-path->module
+  "Clojure's load takes resource paths: \"/a/b_c\" is the module a.b-c, and a path
+   without a leading slash is relative to the current namespace's directory."
+  [path]
+  (let [->module (fn [s]
+                   (apply str (map (fn [c]
+                                     (case c
+                                       \/ \.
+                                       \_ \-
+                                       c))
+                                   s)))]
+    (if (= \/ (first path))
+      (symbol (->module (subs path 1)))
+      (let [dir (->> (str (ns-name *ns*))
+                     reverse
+                     (drop-while #(not= \. %))
+                     rest
+                     reverse
+                     (apply str))
+            m (->module path)]
+        (symbol (if (= "" dir)
+                  m
+                  (str dir "." m)))))))
+
