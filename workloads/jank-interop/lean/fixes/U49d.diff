@@ -6988,12 +6988,12 @@
   "Resolves namespace-qualified sym per 'resolve'. If initial resolve
 fails, attempts to require sym's namespace and retries."
   [sym]
-  ;; (if (qualified-symbol? sym)
-  ;;   (or (resolve sym)
-  ;;       (do (-> sym namespace symbol serialized-require)
-  ;;           (resolve sym)))
-  ;;   (throw (IllegalArgumentException. (str "Not a qualified symbol: " sym))))
-  (throw (ex-info "TODO: port requiring-resolve"  {})))
+  ;; serialized-require is unported; jank's require takes its own loader lock.
+  (if (qualified-symbol? sym)
+    (or (resolve sym)
+        (do (-> sym namespace symbol require)
+            (resolve sym)))
+    (throw (ex-info (str "Not a qualified symbol: " sym) {}))))
 
