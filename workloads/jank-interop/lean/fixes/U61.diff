+;; Clojure's EqualityPartition and Diff protocols, extended to nil, Set, List, Map and
+;; Object, as one dispatch on jank's predicates (sequential? stands for java.util.List).
 (defn- equality-partition [o]
-  :atom)
+  (cond
+    (nil? o) :atom
+    (set? o) :set
+    (map? o) :map
+    (sequential? o) :sequential
+    :else :atom))
+
+(defn- diff-set
+  [a b]
+  [(not-empty (set/difference a b))
+   (not-empty (set/difference b a))
+   (not-empty (set/intersection a b))])
 
 (defn- diff-similar [lhs rhs]
