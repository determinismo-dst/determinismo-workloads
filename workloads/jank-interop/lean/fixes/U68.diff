+        if constexpr(behavior::map_like<T>)
+        {
+          throw std::runtime_error{ util::format("Objects of type `{}` cannot be shuffled.",
+                                                 object_type_str(typed_coll.get_type())) };
+        }
+        if(typed_coll.get_type() == object_type::persistent_string
+           || typed_coll.get_type() == object_type::array)
         {
           throw std::runtime_error{ util::format("Objects of type `{}` cannot be shuffled.",
                                                  object_type_str(typed_coll.get_type())) };
