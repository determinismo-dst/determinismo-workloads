+    /* The digits and the exponent of a decimal in scientific notation ("-1.50e+02"), as
+     * cpp_dec_float's str(0, scientific) prints every stored digit: text = digits * 10^exponent. */
+    std::pair<std::string, i64> scientific_decimal(std::string_view const text)
+    {
+      auto const e{ text.find_first_of("eE") };
+      std::string digits{ !text.empty() && text[0] == '-' ? "-" : "" };
+      for(usize i{}; i < std::min(e, text.size()); ++i)
+      {
+        if(text[i] >= '0' && text[i] <= '9')
+        {
+          digits += text[i];
+        }
+      }
+      auto const fraction_start{ text.find('.') };
+      i64 fraction_digits{};
+      if(fraction_start != std::string_view::npos && fraction_start < e)
+      {
+        fraction_digits = static_cast<i64>(std::min(e, text.size()) - fraction_start - 1);
+      }
+      i64 const exponent{ e == std::string_view::npos ? 0 : std::stoll(std::string{ text.substr(e + 1) }) };
+      return { digits, exponent - fraction_digits };
