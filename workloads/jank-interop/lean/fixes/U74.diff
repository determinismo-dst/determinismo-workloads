+    /* digits * 10^exponent as a reduced fraction (Numbers.rationalize: a BigInt when whole). */
+    std::pair<native_big_integer, native_big_integer> decimal_fraction(std::string const &digits,
+                                                                       i64 const exponent)
+    {
+      native_big_integer n{ digits };
+      native_big_integer d{ 1 };
+      native_big_integer const ten{ 10 };
