+    /* Clojure's min and max (Numbers.min/max): a NaN operand is the result, the first one
+     * first; otherwise min is `lt(x, y) ? x : y` and max is `gt(x, y) ? x : y`, so on a tie
+     * both give the second operand ((max 1 1.0) is 1.0, (min 1.0 1) is 1). */
     template <typename T>
+    [[gnu::always_inline]]
+    constexpr bool nan_operand(T const &t)
+    {
+      if constexpr(std::is_floating_point_v<T>)
+      {
+        return std::isnan(t);
+      }
+      else
+      {
+        return false;
+      }
+    }
+
+    /* Math.min and Math.max, which Clojure calls for two primitives of one type: for doubles
+     * a NaN operand is the result and -0.0 is below 0.0 (std::min and std::max return their
+     * first operand in both cases). */
+    template <typename C>
+    [[gnu::always_inline]]
+    C java_min(C const a, C const b)
+    {
+      if constexpr(std::is_floating_point_v<C>)
+      {
+        if(std::isnan(a))
+        {
+          return a;
+        }
+        if(a == 0 && b == 0 && std::signbit(b))
+        {
+          return b;
+        }
+        return a <= b ? a : b;
+      }
+      else
+      {
+        return std::min(a, b);
+      }
+    }
+
+    template <typename C>
+    [[gnu::always_inline]]
+    C java_max(C const a, C const b)
+    {
+      if constexpr(std::is_floating_point_v<C>)
+      {
+        if(std::isnan(a))
+        {
+          return a;
+        }
+        if(a == 0 && b == 0 && std::signbit(a))
+        {
+          return b;
+        }
+        return a >= b ? a : b;
+      }
+      else
+      {
+        return std::max(a, b);
+      }
+    }
