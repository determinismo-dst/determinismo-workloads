 namespace jank::runtime::obj
 {
+  /* RT.longCast(double): NaN is 0; a value outside [Long.MIN_VALUE, Long.MAX_VALUE], compared as
+   * doubles, is an error ("Value out of range for long"); 2^63 itself (Long.MAX_VALUE as a
+   * double) saturates, as Java's (long) cast does. */
+  static i64 long_cast(f64 const data, object const &o)
+  {
+    constexpr f64 two_63{ 9223372036854775808.0 };
+    if(std::isnan(data))
+    {
+      return 0;
+    }
+    if(data < -two_63 || data > two_63)
+    {
+      throw make_box(util::format("Value out of range for long: {}", o.to_string())).erase();
+    }
+    if(data >= two_63)
+    {
+      return std::numeric_limits<i64>::max();
+    }
+    return static_cast<i64>(data);
+  }
+
