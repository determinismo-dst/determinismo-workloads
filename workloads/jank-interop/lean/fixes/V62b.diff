+   * to f. Plain for 10^-3 <= |f| < 10^7, else d.ddd...E<n>, always with a digit after the point. */
+  static std::string float_text(f32 const f)
+  {
+    if(std::isnan(f))
+    {
+      return "NaN";
+    }
+    if(std::isinf(f))
+    {
+      return f < 0 ? "-Infinity" : "Infinity";
+    }
+    if(f == 0.0f)
+    {
+      return std::signbit(f) ? "-0.0" : "0.0";
+    }
+
+    std::string digits;
+    int exponent{};
+    auto const parse([&](char const * const begin, char const * const end) {
+      std::string_view const text{ begin, static_cast<size_t>(end - begin) };
+      auto const e{ text.find('e') };
+      digits.clear();
+      for(char const c : text.substr(0, e))
+      {
+        if(c >= '0' && c <= '9')
+        {
+          digits += c;
+        }
+      }
+      exponent = std::atoi(std::string{ text.substr(e + 1) }.c_str());
+    });
+
+    char shortest[32];
+    auto const r1{
+      std::to_chars(shortest, shortest + sizeof(shortest), f, std::chars_format::scientific)
+    };
+    parse(shortest, r1.ptr);
+    if(digits.size() == 1)
+    {
+      char two[32];
+      auto const r2{ std::to_chars(two, two + sizeof(two), f, std::chars_format::scientific, 1) };
+      std::string const two_text{ two, r2.ptr };
+      if(std::strtof(two_text.c_str(), nullptr) == f)
+      {
+        parse(two, r2.ptr);
+      }
+    }
+    while(digits.size() > 1 && digits.back() == '0')
+    {
+      digits.pop_back();
+    }
