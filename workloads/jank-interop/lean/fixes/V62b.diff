+      {
+        for(int i{}; i <= exponent; ++i)
+        {
+          out += i < n ? digits[static_cast<size_t>(i)] : '0';
+        }
+        out += '.';
+        if(n > exponent + 1)
+        {
+          out += digits.substr(static_cast<size_t>(exponent + 1));
+        }
+        else
+        {
+          out += '0';
+        }
+      }
+      else
