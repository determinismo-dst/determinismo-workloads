+  bool regex_find(std::regex const &re,
+                  std::string const &s,
+                  regex_position &from,
+                  std::string &scratch,
+                  std::smatch &m,
+                  regex_position &start,
+                  regex_position &end)
+  {
+    if(s.size() < from.byte)
+    {
+      return false;
+    }
