+  native_big_decimal operator-(native_big_decimal const &l, native_big_decimal const &r)
+  {
+    auto const mc{ current_math_context() };
+    /* R72f: at precision 0, add(l, negate(r)) of two compact values is their aligned i64
+     * difference when it fits. */
