+      if(!std::regex_search(s.cbegin() + static_cast<std::ptrdiff_t>(from.byte),
+                            s.cend(),
+                            m,
+                            re,
+                            from.byte == 0 ? std::regex_constants::match_default
+                                           : std::regex_constants::match_prev_avail))
+      {
+        from = { s.size() + 1, false };
+        return false;
+      }
+      start = { static_cast<usize>(m[0].first - s.cbegin()), false };
+      end = { static_cast<usize>(m[0].second - s.cbegin()), false };
+    }
+    else
+    {
+      /* Java searches from between the two surrogates of the character at from.byte: search a copy
+       * where that character is its two halves, from between them. */
+      auto const cp(pair_at(s, from.byte));
+      scratch.clear();
+      append_surrogate(scratch, high_surrogate(cp));
+      append_surrogate(scratch, low_surrogate(cp));
+      scratch.append(s, from.byte + 4);
+      if(!std::regex_search(scratch.cbegin() + 3,
+                            scratch.cend(),
+                            m,
+                            re,
+                            std::regex_constants::match_prev_avail))
+      {
+        from = { s.size() + 1, false };
+        return false;
+      }
+      auto const map([&](usize const pos, bool const is_start) -> regex_position {
+        /* 3 is the middle; past the low half's 3 bytes, the copy is s from from.byte + 4. A byte
+         * pattern ending inside the low half's bytes ends after the character. */
+        if(pos < 6 && (is_start || pos == 3))
+        {
+          return { from.byte, true };
+        }
+        return { from.byte + 4 + (pos < 6 ? 0 : pos - 6), false };
+      });
+      start = map(static_cast<usize>(m[0].first - scratch.cbegin()), true);
+      end = map(static_cast<usize>(m[0].second - scratch.cbegin()), false);
+    }
+
+    from = end == start ? next_unit(s, end) : end;
+    return true;
+  }
+
+  std::string regex_slice(std::string const &s, regex_position const a, regex_position const b)
+  {
+    std::string out;
+    auto i(a.byte);
+    if(a.inside)
+    {
+      if(b == a)
+      {
+        return out;
+      }
+      append_surrogate(out, low_surrogate(pair_at(s, i)));
+      i += 4;
+    }
+    if(i < b.byte)
+    {
+      out.append(s, i, b.byte - i);
+    }
+    if(b.inside && !(a.inside && a.byte == b.byte))
+    {
+      append_surrogate(out, high_surrogate(pair_at(s, b.byte)));
+    }
+    return out;
+  }
 }
