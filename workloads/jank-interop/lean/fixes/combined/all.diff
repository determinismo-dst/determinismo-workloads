+  namespace decimal
+  {
+    native_big_decimal round(native_big_decimal const &x, math_context const &mc)
+    {
+      if(mc.precision == 0)
+      {
+        return x;
+      }
+      i64 const p{ mc.precision };
+      i64 const digits{ x.precision() };
+      if(digits <= p)
+      {
+        return x;
+      }
+      i64 const drop{ digits - p };
+      big u{ round_quotient(big_abs(x.unscaled),
+                            pow10_value(drop),
+                            mc.mode,
+                            x.sign() < 0) };
+      i64 scale{ static_cast<i64>(x.scale) - drop };
+      if(u == pow10(static_cast<u64>(p)))
+      {
+        u = pow10(static_cast<u64>(p - 1));
+        --scale;
+      }
+      return make(x.sign() < 0 ? big{ -u } : u, scale);
+    }
+
+    native_big_decimal add(native_big_decimal const &l,
+                           native_big_decimal const &r,
+                           math_context const &mc)
+    {
+      /* round returns its argument unchanged at precision 0: skip its copy. */
+      if(mc.precision == 0)
+      {
+        return exact_add(l, r);
+      }
+      return round(exact_add(l, r), mc);
+    }
+
+    native_big_decimal multiply(native_big_decimal const &l,
+                                native_big_decimal const &r,
+                                math_context const &mc)
+    {
+      if(mc.precision == 0)
+      {
+        return exact_multiply(l, r);
+      }
+      return round(exact_multiply(l, r), mc);
+    }
+
+    native_big_decimal divide(native_big_decimal const &l,
+                              native_big_decimal const &r,
+                              math_context const &mc)
+    {
+      if(r.is_zero())
+      {
+        throw_arithmetic_error("Divide by zero");
+      }
+      return mc.precision == 0 ? exact_quotient(l, r) : context_divide(l, r, mc);
+    }
+
+    native_big_decimal divide_to_integral_value(native_big_decimal const &l,
+                                                native_big_decimal const &r,
+                                                math_context const &mc)
+    {
+      if(r.is_zero())
+      {
+        throw_arithmetic_error("Divide by zero");
+      }
+      i64 const preferred{ static_cast<i64>(l.scale) - r.scale };
+      if(compare_magnitude(l, r) < 0)
+      {
+        return make(big{}, saturate(preferred));
+      }
+      if(mc.precision == 0)
+      {
+        /* The integer part t of the exact quotient, at max(preferred, -trailingZeros(t)). */
+        i64 const shift{ static_cast<i64>(r.scale) - l.scale };
+        big const n{ shift >= 0 ? big{ l.unscaled * pow10_value(shift) } : l.unscaled };
+        big const d{ shift >= 0 ? r.unscaled : big{ r.unscaled * pow10_value(-shift) } };
+        big const t{ n / d };
+        i64 const scale{ std::max(preferred, -trailing_zeros(t)) };
+        return make(scale >= 0 ? big{ t * pow10_value(scale) } : big{ t / pow10_value(-scale) },
+                    scale);
+      }
+      native_big_decimal result{ context_divide(l, r, { mc.precision, rounding_mode::down }) };
+      if(result.scale < 0)
+      {
+        auto const product{ exact_multiply(result, r) };
+        if(compare_magnitude(exact_add(l, exact_negate(product)), r) >= 0)
+        {
+          throw_arithmetic_error("Division impossible");
+        }
+      }
+      else if(result.scale > 0)
+      {
+        result = set_scale_down_to_zero(result);
+      }
+      i64 const precision_diff{ static_cast<i64>(mc.precision) - result.precision() };
+      if(preferred > result.scale && precision_diff > 0)
+      {
+        i64 const add{ std::min(precision_diff, preferred - result.scale) };
+        return make(result.unscaled * pow10_value(add), static_cast<i64>(result.scale) + add);
+      }
+      return strip_to_scale(result.unscaled, result.scale, preferred);
+    }
+
+    native_big_decimal remainder(native_big_decimal const &l,
+                                 native_big_decimal const &r,
+                                 math_context const &mc)
+    {
+      auto const q{ divide_to_integral_value(l, r, mc) };
+      return exact_add(l, exact_negate(exact_multiply(q, r)));
+    }
+
+    native_big_decimal negate(native_big_decimal const &x, math_context const &mc)
+    {
+      if(mc.precision == 0)
+      {
+        return exact_negate(x);
+      }
+      return round(exact_negate(x), mc);
+    }
+
+    native_big_decimal abs(native_big_decimal const &x, math_context const &mc)
+    {
+      return round(x.sign() < 0 ? exact_negate(x) : x, mc);
+    }
+
+    native_big_decimal value_of(f64 const d)
+    {
+      if(!std::isfinite(d))
+      {
+        throw_arithmetic_error("Infinite or NaN");
+      }
+      if(d == 0.0)
+      {
+        /* Double.toString: "0.0". */
+        return make(big{}, 1);
+      }
+      /* The shortest digits D1...Dn and exponent E of Double.toString, then its layout: plain
+       * "I.F" for 1e-3 <= |d| < 1e7 (scale max(n - 1 - E, 1)), else "D.FFFE<E>" with at least
+       * one fraction digit (scale max(n - 1, 1) - E). */
+      std::array<char, 64> buf{};
+      auto const res{
+        std::to_chars(buf.data(), buf.data() + buf.size(), std::fabs(d), std::chars_format::scientific)
+      };
+      std::string_view const text{ buf.data(), static_cast<usize>(res.ptr - buf.data()) };
+      auto const e_pos{ text.find('e') };
+      std::string digits;
+      for(usize i{}; i < e_pos; ++i)
+      {
+        if(text[i] != '.')
+        {
+          digits.push_back(text[i]);
+        }
+      }
+      i64 const exponent{ std::stoll(std::string{ text.substr(e_pos + 1) }) };
+      i64 const n{ static_cast<i64>(digits.size()) };
+      f64 const magnitude{ std::fabs(d) };
+      i64 scale{};
+      if(magnitude >= 1e-3 && magnitude < 1e7)
+      {
+        scale = std::max<i64>(n - 1 - exponent, 1);
+      }
+      else
+      {
+        scale = std::max<i64>(n - 1, 1) - exponent;
+      }
+      /* The digits at that scale: D * 10^(scale - (n - 1 - E)), which is >= 0. */
+      big u{ big{ digits } * pow10_value(scale - (n - 1 - exponent)) };
+      return make(d < 0 ? big{ -u } : u, scale);
+    }
+
+    u32 hasheq(native_big_decimal const &x)
+    {
+      if(x.is_zero())
+      {
+        return 0;
+      }
+      /* stripTrailingZeros().hashCode() = 31 * BigInteger.hashCode(unscaled) + scale. */
+      i64 scale{ x.scale };
+      /* BigInteger.hashCode: the magnitude's 32-bit words, most significant first, h = 31h + w,
+       * then times the signum, in int (u32) arithmetic. */
+      auto const word_hash([](u64 const magnitude, u32 h, bool const top) {
+        u32 const hi{ static_cast<u32>(magnitude >> 32) };
+        if(!(top && hi == 0))
+        {
+          h = 31u * h + hi;
+        }
+        return 31u * h + static_cast<u32>(magnitude);
+      });
+      i64 c;
+      if(compact(x.unscaled, c))
+      {
+        /* R72f: the compact value stripped and hashed in an i64. */
+        while(c % 10 == 0)
+        {
+          c /= 10;
+          --scale;
+        }
+        u32 h{ word_hash(c < 0 ? 0ull - static_cast<u64>(c) : static_cast<u64>(c), 0u, true) };
+        if(c < 0)
+        {
+          h = 0u - h;
+        }
+        return 31u * h + static_cast<u32>(static_cast<i32>(scale));
+      }
+      big u{ big_abs(x.unscaled) };
+      while(boost::multiprecision::integer_modulus(u, 10u) == 0)
+      {
+        u /= 10u;
+        --scale;
+      }
+      auto const &b{ u.backend() };
+      u32 h{};
+      for(usize i{ b.size() }; i-- > 0;)
+      {
+        h = word_hash(b.limbs()[i], h, i + 1 == b.size());
+      }
+      if(x.unscaled < 0)
+      {
+        h = 0u - h;
+      }
+      return 31u * h + static_cast<u32>(static_cast<i32>(scale));
+    }
+  }
