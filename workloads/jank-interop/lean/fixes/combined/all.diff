+  /* One UTF-16 unit past `at`: past the whole character there (a byte that starts none counts
+   * alone), or into the middle of a four-byte one. Past the end, the position is beyond it. */
+  static regex_position next_unit(std::string const &s, regex_position const at)
+  {
+    if(at.inside)
+    {
+      return { at.byte + 4, false };
+    }
+    if(s.size() <= at.byte)
+    {
+      return { s.size() + 1, false };
+    }
+    if(pair_at(s, at.byte) != 0)
+    {
+      return { at.byte, true };
+    }
+    auto const b0(static_cast<u8>(s[at.byte]));
+    usize n{ (b0 & 0xE0) == 0xC0 ? 2u : (b0 & 0xF0) == 0xE0 ? 3u : (b0 & 0xF8) == 0xF0 ? 4u : 1u };
+    if(s.size() < at.byte + n)
+    {
+      n = 1;
+    }
+    for(usize k{ 1 }; k < n; ++k)
+    {
+      if((static_cast<u8>(s[at.byte + k]) & 0xC0) != 0x80)
