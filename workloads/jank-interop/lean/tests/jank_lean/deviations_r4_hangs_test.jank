; SPDX-License-Identifier: MIT
; The Lean replica of jank, round 4 (main 7135b7708): the predicted hangs (lock re-entry under lazy
; compilation, a multimethod's mutex, and jank.shell's pipes), apart so that the time they take
; can't keep other tests from running. Each asserts Clojure's result.
(ns jank-lean.deviations-r4-hangs-test
  (:require [clojure.test :refer [deftest is]]
            [clojure.string :as string]))

(defn- sh-fn [] (require 'jank.shell) (resolve 'jank.shell/sh))

;; U13. alter-var-root whose fn calls the var's own fn, never called before: its first call's
;; bind_root re-enters the write_mutex alter_root holds (a variant of S63).
(defn- ua6-inc [x] (inc x))

;; U13. The same across threads: alter-var-root's fn waits on a future that calls the var's fn.
(defn- ua6b-inc [x] (inc x))

;; U19. defmethod holds the multimethod's mutex while it hashes (realizes) a lazy dispatch value;
;; every call of the multimethod takes that mutex (reset_cache), so a realization that waits on a
;; thread calling the multimethod hangs. Clojure finds :a in its method cache without a lock.
(defmulti ua12-mm identity)

(defmethod ua12-mm :a [_] 1)

(defn- wm [o m] (with-meta o m))

(deftest u13-alter-var-root-whose-fn-calls-the-vars-fn
  (alter-var-root #'ua6-inc (fn [g] (g 1) g))
  (is (= 2 (ua6-inc 1))))

(deftest u13b-alter-var-root-whose-fn-waits-on-a-first-call
  (alter-var-root #'ua6b-inc (fn [g] @(future (g 1)) g))
  (is (= 2 (ua6b-inc 1))))

(deftest u19-defmethod-with-a-lazy-dispatch-value-realized-by-a-caller-thread
  (let [l (lazy-seq (cons @(future (ua12-mm :a)) nil))]
    (defmethod ua12-mm l [_] 2)
    (is (= 2 (ua12-mm l)))))

(deftest u28-with-meta-on-an-iterate
  (is (= {:a 1} (meta (wm (iterate inc 0) {:a 1})))))

(deftest u28b-with-meta-on-an-infinite-range
  (is (= {:a 1} (meta (wm (range) {:a 1})))))

(deftest u89-sh-reads-output-past-a-pipes-capacity
  (let [sh (sh-fn)]
    (is (= 588895 (count (:out (sh "seq" "1" "100000")))))))
