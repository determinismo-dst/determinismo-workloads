;;;; M9-9: update-vals of a sorted map stays sorted. core.jank 7748-7761 asks (transientable? m), and a
;;;; persistent_sorted_map has to_transient (U33); Clojure asks IEditableCollection, which
;;;; PersistentTreeMap is not, so the result is built in (transient {}).

; Clojure false, jank true.
(deftest z65-update-vals-of-a-sorted-map-is-not-sorted
  (is (false? (sorted? (update-vals (sorted-map 1 2) inc)))))


; Clojure [1 3 2] (an array map in insertion order), jank [1 2 3].
(deftest z65b-update-vals-of-a-sorted-map-then-assoc
  (is (= [1 3 2] (vec (keys (assoc (update-vals (sorted-map 3 :a 1 :b) str) 2 :x))))))



;;;; M9-10: empty of a seq keeps the seq's metadata. seq.cpp empty 787-805 returns
;;;; with_meta(T::empty(), meta(o)) for every collection; Clojure's ASeq.empty and LazySeq.empty
;;;; return PersistentList.EMPTY (no metadata); only lists, vectors, maps, sets and Cons keep it.

; a vector's seq: Clojure nil, jank {:m 1}.
(deftest z66-empty-of-a-seq-has-no-metadata
  (is (nil? (meta (empty (with-meta (seq [1 2 3]) {:m 1}))))))


; a lazy seq: Clojure nil, jank {:m 1}.
(deftest z66b-empty-of-a-lazy-seq-has-no-metadata
  (is (nil? (meta (empty (with-meta (map inc [1 2]) {:m 1}))))))


; control: a list keeps it. {:m 1} in both.
(deftest z66c-control-empty-of-a-list-keeps-metadata
  (is (= {:m 1} (meta (empty (with-meta '(1 2) {:m 1}))))))



;;;; Instances of known causes.

; D10 (parse-long is std::stoll, math.cpp parse_long 678-707): Java's Long.valueOf accepts every
; Unicode decimal digit. Clojure 34, jank nil.
(deftest z67-parse-long-of-arabic-indic-digits
  (is (= 34 (parse-long "٣٤"))))


; U81's code (zipmap builds in (transient (hash-map)), core.jank 2411-2422; Clojure (transient {})):
; the key order. Clojure [2 1], jank [1 2].
(deftest z68-zipmap-keeps-the-key-order
  (is (= [2 1] (vec (keys (zipmap [2 1] [:a :b]))))))


; control: keys already in CHAMP order. [1 2] in both.
(deftest z68b-control-zipmap-in-hash-order
  (is (= [1 2] (vec (keys (zipmap [1 2] [:a :b]))))))


; U67 (a map entry is a 2-vector): MapEntry.empty() is nil in Clojure; jank [].
(deftest z69-empty-of-a-map-entry-is-nil
  (is (nil? (empty (first {:a 1})))))


; U67: key of a vector throws in Clojure (ClassCastException); jank's key is (first e): 1.
(deftest z69b-key-of-a-vector-throws
  (is (thrown? (key [1 2]))))



;;;; M9-11: a hash set's or hash map's seq order. Both index the 32-bit hash 5 bits at a time from the
;;;; low end, and a long hashes alike in both (Murmur3 hashLong), but immer's CHAMP node lists its
;;;; inline values before its sub-nodes (champ_iterator.hpp step_down/step_right), while Clojure's
;;;; BitmapIndexedNode interleaves them by position. 5 and 9 share position 23 at the root, 8 is alone
;;;; at 31: Clojure (9 5 8), jank (8 9 5) (Jank.R9.Coll.HashOrder set_5_9_8; cljOrd reproduces every
;;;; Clojure order checked, champOrd the replica's CHAMP for (range n), n < 40).

; hash-set (persistent_hash_set.cpp create_from_seq 45-53). Clojure [9 5 8], jank [8 9 5].
(deftest z70-hash-set-seq-order
  (is (= [9 5 8] (vec (hash-set 5 9 8)))))


; printed: Clojure "#{9 5 8}", jank "#{8 9 5}".
(deftest z70b-hash-set-printed-order
  (is (= "#{9 5 8}" (str (hash-set 5 9 8)))))


; a 12-entry map (into {} promotes at the 9th key in both): Clojure [0 7 1 4 6 3 2 11 9 5 10 8],
; jank [0 7 1 4 6 3 2 10 8 11 9 5].
(deftest z70c-hash-map-of-12-keys-seq-order
  (is (= [0 7 1 4 6 3 2 11 9 5 10 8]
         (vec (keys (into {} (map vector (range 12) (range 12))))))))


; control: no two keys share a root position. [5 8] in both.
(deftest z70d-control-hash-set-without-shared-positions
  (is (= [5 8] (vec (hash-set 5 8)))))
