  (is (= "Walked: \"a\"\n" (with-out-str (walk/prewalk-demo "a")))))


; Clojure "Walked: \"a\"\n", jank "Walked: a\n".
(deftest z64b-postwalk-demo-prints-readably
  (is (= "Walked: \"a\"\n" (with-out-str (walk/postwalk-demo "a")))))


; control: a number prints alike. "Walked: 1\n" in both.
(deftest z64c-control-prewalk-demo-of-a-number
