; SPDX-License-Identifier: MIT
; The driver (jank-interop.workload's interop): Hegel's test cases in the jank node, each evaluated
; as the REPL evaluates (the generated C++ compiled by cpp/raw, then the jank form read, compiled
; by the JIT and run). Swarm testing over what is generated: each timeline keeps its own constructs
; and scalar types, weighted (determinismo's swarm-index), and Hegel draws within them. Required by
; the driver alone: it needs libhegel, which the node has and the host describing the program not.
(ns jank-interop.run
  (:require [determinismo.core :as det]
            [jank-interop.cases :as cases]
            [hegel.core :as hegel]))

(cpp/raw "
#include <atomic>
#include <chrono>
#include <cstdint>
#include <mutex>
#include <string>
#include <thread>
#include <unistd.h>
#include <libdeterminismo.h>

// The cases' watchdog: a generated program can hang jank (count compared unsigned makes a loop
// endless), and a jank thread cannot be interrupted; a timeline whose driver hangs never ends, and
// a hunt stops it uncounted. A C++ thread watches each case's deadline: past it, the case is a
// failed property, its form in the details, and the process ends, so the timeline finishes,
// counts, and replays to the stuck case.
static std::atomic<int64_t> jank_interop_deadline_ms{0};
static std::mutex jank_interop_case_mutex;
static std::string jank_interop_case_text;
// An atomic flag, not std::call_once: jank's JIT resolves no thread-local symbols
// (__emutls_v._ZSt11__once_call: the whole block failed to load, phoenixNAP run 1904).
static std::atomic<bool> jank_interop_watch_started{false};
// Joined before the driver returns (jank_interop_watch_stop), never detached: the thread runs code
// jank's JIT compiled, which the process's exit tears down; a detached watchdog waking during exit
// segfaulted the driver (phoenixNAP run 1922, timeline 0: SIGSEGV in JIT code on a worker thread
// as the driver ended).
static std::atomic<bool> jank_interop_watch_stopping{false};
static std::thread *jank_interop_watch_thread = nullptr;

static int64_t jank_interop_now_ms() {
  return std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
}

static std::string jank_interop_json_string(std::string const &text) {
  std::string out = \"\\\"\";
  for (char c : text) {
    if (c == '\"' || c == '\\\\') { out += '\\\\'; out += c; }
    else if ((unsigned char)c < 0x20) { out += ' '; }
    else out += c;
  }
  return out + \"\\\"\";
}

void jank_interop_case_begin(std::string const &text, int64_t limit_ms) {
  bool expected = false;
  if (jank_interop_watch_started.compare_exchange_strong(expected, true)) {
    jank_interop_watch_thread = new std::thread([] {
      while (!jank_interop_watch_stopping.load()) {
        std::this_thread::sleep_for(std::chrono::milliseconds(500));
        int64_t deadline = jank_interop_deadline_ms.load();
        if (deadline == 0 || jank_interop_now_ms() < deadline) continue;
        std::string details;
        {
          std::lock_guard<std::mutex> lock(jank_interop_case_mutex);
          details = \"{\\\"case\\\":\" + jank_interop_json_string(jank_interop_case_text) + \"}\";
        }
        std::string message = \"a generated case finishes within its time\";
        det_assert(\"always\", 6, false, message.data(), message.size(), details.data(), details.size());
        _exit(0);
      }
    });
  }
  {
    std::lock_guard<std::mutex> lock(jank_interop_case_mutex);
    jank_interop_case_text = text;
  }
  jank_interop_deadline_ms.store(jank_interop_now_ms() + limit_ms);
}

void jank_interop_case_end() {
  jank_interop_deadline_ms.store(0);
}

void jank_interop_watch_stop() {
  jank_interop_deadline_ms.store(0);
  jank_interop_watch_stopping.store(true);
  if (jank_interop_watch_thread) {
    jank_interop_watch_thread->join();
    delete jank_interop_watch_thread;
    jank_interop_watch_thread = nullptr;
  }
}
")

(def case-limit-ms
  "A case's time before the watchdog takes it for a hang: a guard, not a test parameter (a case
  takes well under a second)."
  120000)

(defn- swarm-kept
  "The items this timeline keeps for the name, each as often as the swarm weighs it (32 draws)."
  [decision items]
  (vec (for [_ (range 32)] (nth items (det/swarm-index decision (count items))))))

(def cases-per-start-choices
  "Hegel's test cases a driver start may run (each compiles its own C++), drawn per timeline: a
  constant 200 made generated programs' timelines 155-177 s of virtual time (four minutes of wall
  time each, phoenixNAP run 1906), cut uncounted at a run's end; most timelines now shorter, more of
  them and more branching, some still long."
  [10 25 50 100 200])

(defn run-cases!
  "The area's constructs (all of them for :mixed), each timeline keeping its own (swarm)."
  [area]
  (let [constructs (swarm-kept (str "jank-interop.construct." (name area))
                               (if (= area :mixed) cases/constructs (filterv #(= area (:area %)) cases/constructs)))
        kept-types (swarm-kept "jank-interop.type" cases/types)
        ids (atom 0)]
    (det/event "interop_swarm" {:area (name area)
                                :constructs (vec (distinct (map :name constructs)))
                                :types (vec (distinct (map :name kept-types)))})
    (try
     (let [cases-per-start (nth cases-per-start-choices
                               (det/swarm-index "jank-interop.cases-per-start" (count cases-per-start-choices)))
          result (hegel/run! {:profile "workload" :test-cases cases-per-start
                              ;; libhegel reports the run's verdict as an always assertion.
                              :location {:file "src/jank_interop/run.jank" :line 21
                                         :module "jank-interop.run" :function "run-cases!"}}
                             (fn [tc]
                               ;; Hegel's own swarm within the timeline's: the constructs
                               ;; this test case enables.
                               (let [construct (hegel/element tc (hegel/swarm tc constructs))
                                     c ((:make construct) tc (swap! ids inc) kept-types)
                                     _ (cpp/jank_interop_case_begin
                                        (cpp/cast cpp/std.string (str (:name construct) ": " (or (:form-text c) (pr-str (:form c)))
                                                                      (when (:cpp c) (str " C++: " (:cpp c)))))
                                        case-limit-ms)
                                     {:keys [outcome answer expected]} (cases/evaluate c)
                                     _ (cpp/jank_interop_case_end)
                                     _ (det/always true "a generated case finishes within its time" {})
                                     details {:construct (:name construct)
                                              :expected (or expected (pr-str (:expected c)))
                                              :answer answer :cpp (:cpp c)
                                              :form (or (:form-text c) (pr-str (:form c)))}]
                                 (det/always (not= outcome :error) "a generated case compiles and runs" details)
                                 (when (not= outcome :error) (det/always (= outcome :passed) (:property c) details))
                                 (when-not (= outcome :passed)
                                   (throw {:origin (str (:name construct) ": " (cases/failure-origin {:outcome outcome :answer answer}))}))
                                 true)))]
      (det/always (not (:error result)) "Hegel runs in the jank node" {:error (str (:error result))})
      (det/event "interop_run" {:failures (count (:failures result))
                                :origins (mapv :origin (:failures result))
                                :blobs (mapv :blob (:failures result))}))
     ;; The watchdog joined before the driver returns, on errors too (it runs JIT-compiled code).
     (finally (cpp/jank_interop_watch_stop)))))
